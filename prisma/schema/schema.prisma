enum StatusKeanggotaan {
  AKTIF
  NONAKTIF
}

enum JenisPoinRiwayat {
  PEROLEHAN
  PENUKARAN
  PENYESUAIAN
  KADALUARSA
}

model Pelanggan {
  id           String   @id
  tenantId     String
  namaLengkap  String
  nomorTelepon String
  email        String?
  createdAt    DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  keanggotaan Keanggotaan?
  pesanan     Pesanan[]
  reservasi   Reservasi[]
  kupon       Kupon[]

  @@unique([tenantId, nomorTelepon])
  // ALT-DEF-010: agar Pesanan/Reservasi bisa memakai composite-FK
  // (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  @@unique([tenantId, id])
  @@map("pelanggan")
}

model TierMembership {
  id               String @id
  tenantId         String
  nama             String
  minPoinKumulatif Int    @default(0)
  benefit          Json

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  keanggotaan Keanggotaan[]

  @@map("tier_membership")
}

model Keanggotaan {
  id               String            @id
  pelangganId      String            @unique
  tierMembershipId String
  poinAktif        Int               @default(0)
  poinKumulatif    Int               @default(0)
  status           StatusKeanggotaan @default(AKTIF)
  bergabungPada    DateTime          @default(now())

  pelanggan      Pelanggan      @relation(fields: [pelangganId], references: [id])
  tierMembership TierMembership @relation(fields: [tierMembershipId], references: [id])
  poinRiwayat    PoinRiwayat[]

  @@map("keanggotaan")
}

model PoinRiwayat {
