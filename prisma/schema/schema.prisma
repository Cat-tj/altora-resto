  outlet        Outlet        @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, kategoriBiayaId) -> KategoriBiaya(tenantId, id).
  kategoriBiaya KategoriBiaya @relation(fields: [tenantId, kategoriBiayaId], references: [tenantId, id])
  dicatatOleh   Pengguna      @relation("BiayaDicatatOleh", fields: [dicatatOlehId], references: [id])

  @@map("biaya_operasional")
}

