  keanggotaanId String
  pesananId     String?
  jenis         JenisPoinRiwayat
  jumlah        Int
  createdAt     DateTime         @default(now())

  keanggotaan Keanggotaan @relation(fields: [keanggotaanId], references: [id])
  pesanan     Pesanan?    @relation(fields: [pesananId], references: [id])

  @@map("poin_riwayat")
}

