model RmPenjualanHarian {
  id             String   @id
  tenantId       String
  outletId       String
  tanggal        DateTime @db.Date
  totalTransaksi Int      @default(0)
  totalPenjualan Int      @default(0)
  totalDiskon    Int      @default(0)
  totalRefund    Int      @default(0)
  dihitungPada   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])

  @@unique([outletId, tanggal])
  @@map("rm_penjualan_harian")
}

model RmPenjualanItemHarian {
  id               String   @id
  tenantId         String
  outletId         String
  itemMenuId       String
  tanggal          DateTime @db.Date
  kuantitasTerjual Int      @default(0)
  totalPenjualan   Int      @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet   Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, itemMenuId) -> ItemMenu(tenantId, id).
  itemMenu ItemMenu @relation(fields: [tenantId, itemMenuId], references: [tenantId, id])

  @@unique([outletId, itemMenuId, tanggal])
  @@map("rm_penjualan_item_harian")
}

model RmStokKritis {
  id               String   @id
  tenantId         String
  outletId         String
  bahanId          String
  kuantitasTerkini Decimal
  ambangMinimum    Decimal
  dihitungPada     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, bahanId) -> Bahan(tenantId, id).
  bahan  Bahan  @relation(fields: [tenantId, bahanId], references: [tenantId, id])

  @@unique([outletId, bahanId])
  @@map("rm_stok_kritis")
}

model RmKinerjaKaryawanHarian {
  id                      String   @id
  tenantId                String
  outletId                String
  karyawanId              String
  tanggal                 DateTime @db.Date
  totalTransaksiDitangani Int      @default(0)
  totalPenjualanDitangani Int      @default(0)
  menitTerlambat          Int      @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet   Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan Karyawan @relation(fields: [tenantId, karyawanId], references: [tenantId, id])

  @@unique([outletId, karyawanId, tanggal])
  @@map("rm_kinerja_karyawan_harian")
}
