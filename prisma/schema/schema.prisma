// Skema Prisma Altora Resto
//
// Mengimplementasikan ERD di docs/database/*.md. Aturan umum (lihat docs/database/README.md):
// - ID memakai ULID, disimpan sebagai String @id.
// - Setiap tabel transaksional/tenant-scoped membawa tenantId dan (jika relevan) outletId.
// - Uang disimpan sebagai BigInt dalam rupiah (bukan Decimal/Float) - tidak ada
//   floating point (ADR-034, mengamandemen ADR-005 yang semula Int).
// - Kuantitas bahan baku memakai Decimal (butuh presisi pecahan, mis. gram/ml).
// - Timestamp disimpan UTC.
// - Tidak ada hard-delete pada data finansial, stok, dan audit - lihat kolom status /
//   dibatalkanPada / dibalikOlehId di setiap domain.
//
// Skema ini adalah draft awal ("BELUM DIKERJAKAN" secara implementasi/migrasi) - lihat
// docs/engineering/MASTER-CHECKLIST.md dan docs/engineering/TRACEABILITY-MATRIX.md untuk
// status pengerjaan per requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================================
// 1. PLATFORM (docs/database/01-platform.md)
// =====================================================================================

enum StatusTenant {
  AKTIF
  NONAKTIF
  SUSPENDED
}

enum StatusOutlet {
  AKTIF
  NONAKTIF
}

enum StatusPengguna {
  AKTIF
  NONAKTIF
}

enum StatusKeanggotaanTenant {
  AKTIF
  NONAKTIF
}

enum StatusKeanggotaanOutlet {
  AKTIF
  NONAKTIF
}

enum JenisPerangkat {
  KASIR
  KDS
  PRINTER
  TABLET_PELAYAN
}

enum StatusPerangkat {
  AKTIF
  NONAKTIF
}

// ALT-DEF-003/ALT-DEF-013: aksi riwayat asosiasi Pengguna<->Perangkat, dicatat
// append-only di RiwayatPerangkat (lihat DECISION-LOG.md ADR-015).
enum AksiRiwayatPerangkat {
  DIDAFTARKAN
  DIGUNAKAN
  DICABUT
}

model Tenant {
  id        String       @id
  nama      String
  slug      String       @unique
  status    StatusTenant @default(AKTIF)
  createdAt DateTime     @default(now())

  outlet                     Outlet[]
  keanggotaanTenant          KeanggotaanTenant[]
  peran                      Peran[]
  auditLog                   AuditLog[]
  pengaturanTenant           PengaturanTenant[]
  satuan                     Satuan[]
  bahan                      Bahan[]
  resep                      Resep[]
  // ALT-DEF-007: model baru domain resep & produksi (ADR-022).
  konversiSatuan             KonversiSatuan[]
  versiResep                 VersiResep[]
  komponenResep              KomponenResep[]
  komponenResepModifier      KomponenResepModifier[]
  prosesProduksi             ProsesProduksi[]
  prosesProduksiBaris        ProsesProduksiBaris[]
  batchProduksi              BatchProduksi[]
  modifierGrup               ModifierGrup[]
  itemMenu                   ItemMenu[]
  supplier                   Supplier[]
  purchaseOrder              PurchaseOrder[]
  returPembelian             ReturPembelian[]
  pelanggan                  Pelanggan[]
  tierKeanggotaan            TierKeanggotaan[]
  keanggotaan                Keanggotaan[]
  poinRiwayat                PoinRiwayat[]
  // ALT-DEF-039: model baru domain keanggotaan (ADR-027, program stempel).
  hadiahStempel              HadiahStempel[]
  ledgerStempel              LedgerStempel[]
  // ALT-DEF-018/ALT-DEF-023: model baru domain keanggotaan (ADR-027).
  ledgerSaldoToko            LedgerSaldoToko[]
  persetujuanPelanggan       PersetujuanPelanggan[]
  riwayatGabungPelanggan     RiwayatGabungPelanggan[]
  promo                      Promo[]
  kupon                      Kupon[]
  promoPemakaian             PromoPemakaian[]
  // ALT-DEF-009: model baru domain promo (stacking/kondisi/reward/jadwal/outlet).
  promoReward                PromoReward[]
  promoJadwal                PromoJadwal[]
  promoOutlet                PromoOutlet[]
  promoPemakaianBaris        PromoPemakaianBaris[]
  promoSnapshot              PromoSnapshot[]
  promoSimulasi              PromoSimulasi[]
  jabatan                    Jabatan[]
  karyawan                   Karyawan[]
  // ALT-DEF-019/ALT-DEF-024/ALT-DEF-025: model baru domain HR/absensi (ADR-028).
  departemen                 Departemen[]
  karyawanOutlet             KaryawanOutlet[]
  hubunganKerja              HubunganKerja[]
  templateShift              TemplateShift[]
  jadwalKerja                JadwalKerja[]
  polaJadwalBerulang         PolaJadwalBerulang[]
  permintaanTukarShift       PermintaanTukarShift[]
  absensi                    Absensi[]
  koreksiAbsensi             KoreksiAbsensi[]
  istirahatAbsensi           IstirahatAbsensi[]
  cutiIzin                   CutiIzin[]
  permintaanLembur           PermintaanLembur[]
  targetKinerja              TargetKinerja[]
  penilaianKinerja           PenilaianKinerja[]
  kategoriBiaya              KategoriBiaya[]
  rekapKasHarian             RekapKasHarian[]
  biayaOperasional           BiayaOperasional[]
  metodeBayar                MetodeBayar[]
  pesanan                    Pesanan[]
  pesananPerubahan           PesananPerubahan[]
  pesananPenolakan           PesananPenolakan[]
  pesananPembatalan          PesananPembatalan[]
  mutasiStok                 MutasiStok[]
  stokOpname                 StokOpname[]
  // ALT-DEF-008: model baru domain persediaan (ADR-023/024/025).
  lokasiStok                 LokasiStok[]
  batchStok                  BatchStok[]
  reservasiStok              ReservasiStok[]
  penyesuaianStok            PenyesuaianStok[]
  transferStok               TransferStok[]
  alasanWaste                AlasanWaste[]
  catatanWaste               CatatanWaste[]
  kebijakanPemesananUlang    KebijakanPemesananUlang[]
  pengaturanPersediaanOutlet PengaturanPersediaanOutlet[]
  tiketDapur                 TiketDapur[]
  riwayatStatusTiketDapur    RiwayatStatusTiketDapur[]
  gelombangDapur             GelombangDapur[]
  aturanRoutingDapur         AturanRoutingDapur[]
  stasiunDapur               StasiunDapur[]
  rmPenjualanHarian          RmPenjualanHarian[]
  rmPenjualanItemHarian      RmPenjualanItemHarian[]
  rmStokKritis               RmStokKritis[]
  rmKinerjaKaryawanHarian    RmKinerjaKaryawanHarian[]
  pembayaran                 Pembayaran[]
  // ALT-DEF-014/ALT-DEF-015: model baru domain pembayaran & konfigurasi QRIS.
  alokasiPembayaran          AlokasiPembayaran[]
  pembayaranMetodeBaris      PembayaranMetodeBaris[]
  koreksiPembayaran          KoreksiPembayaran[]
  qrisKonfirmasiManual       QrisKonfirmasiManual[]
  struk                      Struk[]
  pembayaranRefund           PembayaranRefund[]
  konfigurasiQris            KonfigurasiQris[]
  riwayatKonfigurasiQris     RiwayatKonfigurasiQris[]
  permintaanPersetujuan      PermintaanPersetujuan[]
  idempotencyKey             IdempotencyKey[]
  domainOutboxEvent          DomainOutboxEvent[]
  notification               Notification[]

  @@map("tenant")
}

model Outlet {
  id        String       @id
  tenantId  String
  nama      String
  kode      String
  zonaWaktu String
  status    StatusOutlet @default(AKTIF)
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  keanggotaanOutlet          KeanggotaanOutlet[]         @relation("KeanggotaanOutletOutlet")
  pinOutlet                  PinOutlet[]                 @relation("PinOutletOutlet")
  perangkat                  Perangkat[]
  pengaturanOutlet           PengaturanOutlet[]
  kategoriMenu               KategoriMenu[]
  hargaItemOutlet            HargaItemOutlet[]           @relation("HargaItemOutletOutlet")
  gudang                     Gudang[]
  purchaseOrder              PurchaseOrder[]
  areaMeja                   AreaMeja[]
  meja                       Meja[]
  reservasi                  Reservasi[]
  pesanan                    Pesanan[]
  stasiunDapur               StasiunDapur[]
  tiketDapur                 TiketDapur[]
  giliranKasir               GiliranKasir[]
  pembayaran                 Pembayaran[]
  // ALT-DEF-007: produksi bahan setengah jadi berjalan PER OUTLET (dapur
  // outlet A tidak boleh mengklaim batch milik outlet B).
  prosesProduksi             ProsesProduksi[]
  batchProduksi              BatchProduksi[]
  // ALT-DEF-015: konfigurasi QRIS statis per outlet + audit perubahannya.
  konfigurasiQris            KonfigurasiQris[]
  riwayatKonfigurasiQris     RiwayatKonfigurasiQris[]
  mutasiStok                 MutasiStok[]
  // ALT-DEF-008: model baru domain persediaan (ADR-023/024/025).
  lokasiStok                 LokasiStok[]
  batchStok                  BatchStok[]
  reservasiStok              ReservasiStok[]
  penyesuaianStok            PenyesuaianStok[]
  catatanWaste               CatatanWaste[]
  kebijakanPemesananUlang    KebijakanPemesananUlang[]
  pengaturanPersediaanOutlet PengaturanPersediaanOutlet?
  transferStokAsal           TransferStok[]              @relation("TransferStokOutletAsal")
  transferStokTujuan         TransferStok[]              @relation("TransferStokOutletTujuan")
  // ALT-DEF-019: outletUtamaId DIHAPUS dari Karyawan - lihat KaryawanOutlet
  // (many-to-many, isUtama menandai outlet utama) di bawah, ADR-028.
  karyawanOutlet             KaryawanOutlet[]
  templateShift              TemplateShift[]
  jadwalKerja                JadwalKerja[]
  polaJadwalBerulang         PolaJadwalBerulang[]
  absensi                    Absensi[]
  rekapKasHarian             RekapKasHarian[]
  biayaOperasional           BiayaOperasional[]
  rmPenjualanHarian          RmPenjualanHarian[]
  rmPenjualanItemHarian      RmPenjualanItemHarian[]
  rmStokKritis               RmStokKritis[]
  rmKinerjaKaryawanHarian    RmKinerjaKaryawanHarian[]
  AturanRoutingDapur         AturanRoutingDapur[]
  PromoOutlet                PromoOutlet[]

  @@unique([tenantId, kode])
  // Diperlukan (bukan sekadar @id) agar KeanggotaanOutlet bisa memakai composite FK
  // (tenantId, outletId) -> (tenantId, id) sebagai jaminan level-database bahwa
  // outlet yang direferensikan benar-benar milik tenant yang sama (lihat ALT-DEF-001,
  // ADR baru "Composite-FK tenant-outlet" di DECISION-LOG.md).
  @@unique([tenantId, id])
  @@map("outlet")
}

// ALT-DEF-001: Pengguna adalah IDENTITAS GLOBAL (autentikasi) - sengaja TIDAK
// membawa tenantId/outletId/peran langsung. Keanggotaan tenant/outlet/peran
// dimodelkan terpisah di KeanggotaanTenant/KeanggotaanOutlet/KeanggotaanPeran
// di bawah, sehingga satu Pengguna bisa menjadi anggota banyak Tenant (mis.
// konsultan yang mengelola beberapa resto) dengan peran berbeda di tiap tenant.
// Lihat docs/engineering/DECISION-LOG.md ADR-011.
//
// Catatan pinHash: field pinHash LAMA (PIN global per pengguna) sengaja
// DIHAPUS di sini, bukan dipindahkan - PIN-per-outlet (ALT-DEF-013) adalah
// model terpisah (mis. PinOutlet pada KeanggotaanOutlet) yang akan dibangun di
// batch auth/session berikutnya (ALT-DEF-003/013), tidak di batch ini.
model Pengguna {
  id                     String         @id
  namaLengkap            String
  // Unik GLOBAL (bukan per tenant lagi) - satu alamat email = satu identitas
  // pengguna lintas seluruh platform. Lihat ADR-011 untuk alasan kebijakan ini.
  email                  String         @unique
  // Nullable untuk sementara karena data seed/existing mungkin belum punya
  // kredensial password - begitu alur auth email+password dibangun (ALT-DEF-003),
  // field ini semestinya menjadi wajib (non-null) untuk pengguna yang aktif login.
  passwordHash           String?
  status                 StatusPengguna @default(AKTIF)
  emailTerverifikasiPada DateTime?
  terakhirLoginPada      DateTime?
  // ALT-DEF-003: penguncian sementara akun (account lockout) setelah beruntun
  // gagal login - dipilih sebagai field eksplisit di Pengguna (bukan dihitung
  // ulang dari PercobaanLogin tiap request) karena lebih sederhana untuk
  // dibaca/di-guard di jalur login (satu row lookup, bukan agregasi COUNT
  // setiap percobaan) - lihat DECISION-LOG.md ADR-014 untuk rasionalnya.
  // jumlahPercobaanGagal di-reset ke 0 saat login berhasil; terkunciSampai
  // diisi begitu ambang batas gagal beruntun terlampaui (nilai ambang dan
  // durasi kunci adalah keputusan service-layer, bukan bagian skema).
  terkunciSampai         DateTime?
  jumlahPercobaanGagal   Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  keanggotaanTenant          KeanggotaanTenant[]
  sesi                       Sesi[]
  tokenResetKataSandi        TokenResetKataSandi[]
  riwayatPerangkat           RiwayatPerangkat[]
  auditLog                   AuditLog[]
  // ADR-033 (membalikkan sebagian ADR-013 poin 5): field aktor TENANT-SCOPED
  // (persediaan, pesanan, dapur, pembayaran, QRIS, promo, ledger keanggotaan,
  // HR/absensi, notifikasi, dst.) SEKARANG di-composite-kan ke
  // KeanggotaanTenant/KeanggotaanOutlet - back-relation-nya karena itu
  // dipindah ke model-model tersebut, BUKAN lagi terdaftar di sini. Lihat
  // DECISION-LOG.md ADR-033 untuk audit lengkap dan rasionalnya. Relasi yang
  // TETAP ada di Pengguna di bawah ini adalah relasi yang BUKAN aktor
  // tenant-scoped: identitas global murni (sesi/token reset/riwayat
  // perangkat), snapshot audit immutable (AuditLog.penggunaId), atau baris
  // riwayat tanpa kolom denormalisasi tenant sendiri (PesananRiwayatStatus -
  // lihat catatan gap pada modelnya).
  pesananRiwayatStatusDiubah PesananRiwayatStatus[] @relation("RiwayatStatusDiubahOleh")

  @@map("pengguna")
}

// Menghubungkan satu Pengguna (identitas global) ke satu Tenant. Satu Pengguna
// dapat memiliki banyak baris KeanggotaanTenant aktif (satu per tenant tempat ia
// bekerja) - lihat ALT-PLT-003. `isOwner` menandai keanggotaan pemilik tenant
// (dibuat otomatis saat registrasi tenant, ALT-PLT-002).
model KeanggotaanTenant {
  id            String                  @id
  penggunaId    String
  tenantId      String
  status        StatusKeanggotaanTenant @default(AKTIF)
  isOwner       Boolean                 @default(false)
  bergabungPada DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  pengguna Pengguna @relation(fields: [penggunaId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  keanggotaanOutlet               KeanggotaanOutlet[]
  keanggotaanOutletTenantScoped   KeanggotaanOutlet[]     @relation("KeanggotaanOutletTenantScoped")
  keanggotaanPeran                KeanggotaanPeran[]
  izinSementara                   IzinSementara[]         @relation("IzinSementaraPenerima")
  izinSementaraDiberikan          IzinSementara[]         @relation("IzinSementaraDiberikanOleh")
  permintaanPersetujuanPemohon    PermintaanPersetujuan[] @relation("PersetujuanPemohon")
  permintaanPersetujuanDiputuskan PermintaanPersetujuan[] @relation("PersetujuanDisetujuiOleh")
  sesi                            Sesi[]
  pinOutlet                       PinOutlet[]
  pinOutletTenantScoped           PinOutlet[]             @relation("PinOutletTenantScoped")

  // ADR-033: aktor tenant-scoped (bukan cuma identitas Pengguna global) -
  // menggantikan relasi FK langsung ke Pengguna. Lihat DECISION-LOG.md ADR-033
  // untuk daftar lengkap dan rasional tenant-level vs outlet-level.
  transferStokDibuat              TransferStok[]            @relation("TransferStokDibuatOleh")
  transferStokDisetujui           TransferStok[]            @relation("TransferStokDisetujuiOleh")
  transferStokDikirim             TransferStok[]            @relation("TransferStokDikirimOleh")
  transferStokDiterima            TransferStok[]            @relation("TransferStokDiterimaOleh")
  stokOpnameDibuat                StokOpname[]              @relation("OpnameDibuatOleh")
  stokOpnameDihitung              StokOpname[]              @relation("OpnameDihitungOleh")
  stokOpnameDikunci               StokOpname[]              @relation("OpnameDikunciOleh")
  stokOpnameDisetujui             StokOpname[]              @relation("OpnameDisetujuiOleh")
  penerimaanBarangDiterima        PenerimaanBarang[]        @relation("PenerimaanDiterimaOleh")
  pesananPerubahanDiubah          PesananPerubahan[]        @relation("PesananPerubahanDiubahOleh")
  pesananPenolakanDitolak         PesananPenolakan[]        @relation("PesananPenolakanDitolakOleh")
  pesananPembatalanDibatalkan     PesananPembatalan[]       @relation("PesananPembatalanDibatalkanOleh")
  riwayatStatusTiketDapurDiubah   RiwayatStatusTiketDapur[] @relation("RiwayatStatusTiketDapurDiubahOleh")
  gelombangDapurDipicu            GelombangDapur[]          @relation("GelombangDapurDipicuOleh")
  koreksiPembayaranDikoreksi      KoreksiPembayaran[]       @relation("KoreksiPembayaranDikoreksiOleh")
  qrisKonfirmasiDiverifikasi      QrisKonfirmasiManual[]    @relation("QrisDiverifikasiOleh")
  pembayaranRefundDisetujui       PembayaranRefund[]        @relation("RefundDisetujuiOleh")
  promoSimulasiDijalankan         PromoSimulasi[]           @relation("PromoSimulasiDijalankanOleh")
  poinRiwayatDicatat              PoinRiwayat[]             @relation("PoinRiwayatDicatatOleh")
  ledgerStempelDicatat            LedgerStempel[]           @relation("LedgerStempelDicatatOleh")
  ledgerSaldoTokoDicatat          LedgerSaldoToko[]         @relation("LedgerSaldoTokoDicatatOleh")
  riwayatGabungPelangganDilakukan RiwayatGabungPelanggan[]  @relation("RiwayatGabungDigabungOleh")
  permintaanTukarShiftDisetujui   PermintaanTukarShift[]    @relation("TukarShiftDisetujuiOleh")
  koreksiAbsensiDiajukan          KoreksiAbsensi[]          @relation("KoreksiAbsensiDiajukanOleh")
  koreksiAbsensiDisetujui         KoreksiAbsensi[]          @relation("KoreksiAbsensiDisetujuiOleh")
  cutiIzinDisetujui               CutiIzin[]                @relation("CutiDisetujuiOleh")
  permintaanLemburDisetujui       PermintaanLembur[]        @relation("LemburDisetujuiOleh")
  penilaianKinerjaDinilai         PenilaianKinerja[]        @relation("PenilaianDinilaiOleh")
  karyawanIdentitas               Karyawan[]                @relation("KaryawanKeanggotaan")
  auditLog                        AuditLog[]                @relation("AuditLogKeanggotaan")
  notifikasiKeanggotaan           Notification[]            @relation("NotificationKeanggotaan")

  @@unique([penggunaId, tenantId])
  // Diperlukan agar KeanggotaanOutlet bisa memakai composite FK
  // (tenantId, keanggotaanTenantId) -> (tenantId, id) - lihat catatan di
  // KeanggotaanOutlet dan ADR-011 di DECISION-LOG.md.
  @@unique([tenantId, id])
  @@map("keanggotaan_tenant")
}

// Menentukan outlet mana saja yang boleh diakses oleh satu KeanggotaanTenant
// (ALT-PLT-007). CRITICAL (ALT-DEF-001/ALT-DEF-010): database HARUS menjamin
// KeanggotaanOutlet.tenantId == Outlet.tenantId DAN
// KeanggotaanOutlet.tenantId == KeanggotaanTenant.tenantId, agar tidak mungkin
// (di level constraint, bukan hanya guard aplikasi) sebuah keanggotaan outlet
// mencampur outlet milik tenant lain dengan keanggotaan tenant yang berbeda.
//
// Pola yang dipakai: composite-FK ganda memakai kolom tenantId yang SAMA -
// (tenantId, outletId) -> Outlet(tenantId, id) dan
// (tenantId, keanggotaanTenantId) -> KeanggotaanTenant(tenantId, id).
// Pola ini BERHASIL divalidasi oleh `prisma validate` (lihat RELEASE-EVIDENCE.md) -
// bukan fallback ke scalar+guard aplikasi.
model KeanggotaanOutlet {
  id                  String                  @id
  keanggotaanTenantId String
  // Kolom denormalisasi wajib - bukan kolom informational biasa. Nilainya harus
  // selalu sama dengan Outlet.tenantId dan KeanggotaanTenant.tenantId; kesamaan
  // itu yang membuat kedua composite FK di bawah valid secara referential
  // integrity di level database.
  tenantId            String
  outletId            String
  status              StatusKeanggotaanOutlet @default(AKTIF)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  outlet                        Outlet            @relation("KeanggotaanOutletOutlet", fields: [tenantId, outletId], references: [tenantId, id])
  keanggotaanTenant             KeanggotaanTenant @relation(fields: [keanggotaanTenantId], references: [id])
  keanggotaanTenantTenantScoped KeanggotaanTenant @relation("KeanggotaanOutletTenantScoped", fields: [tenantId, keanggotaanTenantId], references: [tenantId, id])

  // ADR-033: aktor OUTLET-scoped - lihat DECISION-LOG.md ADR-033.
  prosesProduksiDibuat            ProsesProduksi[]         @relation("ProsesProduksiDibuatOleh")
  mutasiStokDibuat                MutasiStok[]             @relation("MutasiStokDibuatOleh")
  penyesuaianStokDicatat          PenyesuaianStok[]        @relation("PenyesuaianStokDicatatOleh")
  penyesuaianStokDisetujui        PenyesuaianStok[]        @relation("PenyesuaianStokDisetujuiOleh")
  catatanWasteDicatat             CatatanWaste[]           @relation("CatatanWasteDicatatOleh")
  catatanWasteDisetujui           CatatanWaste[]           @relation("CatatanWasteDisetujuiOleh")
  purchaseOrderDibuat             PurchaseOrder[]          @relation("PoDibuatOleh")
  pesananDibuat                   Pesanan[]                @relation("PesananDibuatOleh")
  pembayaranDikonfirmasi          Pembayaran[]             @relation("PembayaranDikonfirmasiOleh")
  konfigurasiQrisDibuat           KonfigurasiQris[]        @relation("KonfigurasiQrisDibuatOleh")
  konfigurasiQrisDiverifikasi     KonfigurasiQris[]        @relation("KonfigurasiQrisDiverifikasiOleh")
  riwayatKonfigurasiQrisDilakukan RiwayatKonfigurasiQris[] @relation("RiwayatKonfigurasiQrisDilakukanOleh")
  giliranKasir                    GiliranKasir[]           @relation("GiliranKasirPengguna")
  rekapKasHarianDiverifikasi      RekapKasHarian[]         @relation("RekapDiverifikasiOleh")
  biayaOperasionalDicatat         BiayaOperasional[]       @relation("BiayaDicatatOleh")

  // ADR-033: aktor tenant-scoped OUTLET-LEVEL (mis. ProsesProduksi.dibuatOlehId,
  // PenyesuaianStok.disetujuiOlehId, dst.) memakai composite-FK
  // (tenantId, outletId, xxxOlehId) -> KeanggotaanOutlet(tenantId, outletId, id) -
  // menjamin di level database bahwa aktor bukan cuma anggota TENANT yang benar,
  // tapi juga punya AKSES OUTLET yang sama dengan baris yang diaksesnya. Lihat
  // DECISION-LOG.md ADR-033.
  @@unique([keanggotaanTenantId, outletId])
  @@unique([tenantId, outletId, id])
  @@map("keanggotaan_outlet")
}

// ALT-DEF-002: Peran tetap tenant-scoped, tetapi TIDAK lagi menyimpan
// permissions sebagai Json - lihat PeranIzin/Izin di bawah untuk model
// ternormalisasi.
model Peran {
  id        String              @id
  tenantId  String
  kode      String
  nama      String
  deskripsi String?
  // true untuk peran bawaan (OWNER/MANAJER/KASIR/PELAYAN/DAPUR/GUDANG/
  // PEMBELIAN/HRD) yang di-seed otomatis per tenant baru; false untuk peran
  // kustom yang dibuat tenant sendiri (ALT-PLT-008). Peran isSystem tidak boleh
  // dihapus lewat endpoint CRUD peran kustom.
  isSystem  Boolean             @default(false)
  status    StatusAktifNonaktif @default(AKTIF)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  peranIzin        PeranIzin[]
  keanggotaanPeran KeanggotaanPeran[]
  batasIzin        BatasIzin?

  @@unique([tenantId, kode])
  @@map("peran")
}

// Katalog izin (permission) atomik, GLOBAL (bukan per-tenant) - kode izin sama
// artinya di semua tenant (mis. "transaksi.diskon"), hanya kaitan ke Peran yang
// tenant-scoped lewat PeranIzin. Lihat docs/keamanan/PERMISSION-MATRIX.md untuk
// daftar kode lengkap dan prisma/seed/izin.seed.ts untuk seed data-nya.
model Izin {
  id        String              @id
  kode      String
  nama      String
  // Pengelompokan domain fungsional izin (mis. "kasir", "persediaan", "promo").
  // Dipilih sebagai String bebas (bukan enum) karena daftar domain produk masih
  // bisa bertambah tanpa migrasi skema setiap kali domain baru ditambahkan -
  // lihat ADR-011 untuk alasan pemilihan ini.
  domain    String
  deskripsi String?
  status    StatusAktifNonaktif @default(AKTIF)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  peranIzin     PeranIzin[]
  izinSementara IzinSementara[]

  @@unique([kode])
  @@map("izin")
}

// Tabel penghubung many-to-many Peran <-> Izin (ALT-PLT-010) - menggantikan
// Peran.permissions Json lama. Permission Peran sekarang bisa divalidasi lewat
// foreign key (kode izin typo akan gagal di level DB), diquery lewat join, dan
// diaudit per baris.
model PeranIzin {
  id        String   @id
  peranId   String
  izinId    String
  createdAt DateTime @default(now())

  peran Peran @relation(fields: [peranId], references: [id])
  izin  Izin  @relation(fields: [izinId], references: [id])

  @@unique([peranId, izinId])
  @@map("peran_izin")
}

// Menggantikan PenggunaPeran lama. Penetapan peran sekarang per KEANGGOTAAN
// TENANT (bukan per Pengguna global) - ini yang secara benar mengizinkan satu
// Pengguna memiliki peran BERBEDA di tenant yang berbeda (mis. jadi OWNER di
// tenant A tapi cuma KASIR di tenant B tempat ia membantu paruh waktu).
model KeanggotaanPeran {
  id                  String   @id
  keanggotaanTenantId String
  peranId             String
  createdAt           DateTime @default(now())

  keanggotaanTenant KeanggotaanTenant @relation(fields: [keanggotaanTenantId], references: [id])
  peran             Peran             @relation(fields: [peranId], references: [id])

  @@unique([keanggotaanTenantId, peranId])
  @@map("keanggotaan_peran")
}

// Batas izin bernilai (limit numerik) per Peran (ALT-PLT-011) - mis. maksimum
// diskon yang boleh diberikan KASIR tanpa perlu approval supervisor. Di-scope
// ke Peran (bukan per-pengguna) karena limit ini sesuai desain adalah atribut
// peran, bukan atribut individu.
model BatasIzin {
  id                      String   @id
  peranId                 String   @unique
  maksimumDiskonPersen    Decimal?
  maksimumDiskonNominal   BigInt?
  maksimumRefund          BigInt?
  maksimumPenyesuaianStok Decimal?
  wajibPinSupervisor      Boolean  @default(false)
  wajibPersetujuanManajer Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  peran Peran @relation(fields: [peranId], references: [id])

  @@map("batas_izin")
}

// Pemberian izin sementara/darurat (ALT-PLT-012 mendukung ini secara tidak
// langsung) - mis. supervisor sedang cuti, seorang kasir senior diberi izin
// "transaksi.diskon" sementara untuk satu shift.
model IzinSementara {
  id                  String              @id
  // ADR-033: tenantId didenormalisasi (pola KeanggotaanOutlet/PinOutlet,
  // ADR-011/ADR-015) - dipakai oleh DUA composite-FK di bawah (penerima dan
  // pemberi izin sementara), menjamin di level database bahwa pemberi izin
  // adalah anggota TENANT YANG SAMA dengan penerima.
  tenantId            String
  keanggotaanTenantId String
  izinId              String
  diberikanOlehId     String
  alasan              String
  berlakuSejak        DateTime
  berlakuSampai       DateTime
  status              StatusAktifNonaktif @default(AKTIF)
  createdAt           DateTime            @default(now())

  keanggotaanTenant KeanggotaanTenant @relation("IzinSementaraPenerima", fields: [tenantId, keanggotaanTenantId], references: [tenantId, id])
  izin              Izin              @relation(fields: [izinId], references: [id])
  diberikanOleh     KeanggotaanTenant @relation("IzinSementaraDiberikanOleh", fields: [tenantId, diberikanOlehId], references: [tenantId, id])

  @@map("izin_sementara")
}

enum StatusPermintaanPersetujuan {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DIBATALKAN
}

// Rekaman permintaan persetujuan supervisor generik (ALT-PLT-012) - dipakai
// saat sebuah aksi melebihi BatasIzin (wajibPersetujuanManajer/
// wajibPinSupervisor), mis. diskon manual, refund, penyesuaian stok.
model PermintaanPersetujuan {
  id                         String                      @id
  tenantId                   String
  outletId                   String?
  keanggotaanTenantIdPemohon String
  // Jenis aksi yang butuh persetujuan - String bebas (bukan enum) agar domain
  // lain (kasir/persediaan/pesanan) bisa menambah jenis aksi baru tanpa
  // migrasi skema di package ini (mis. "DISKON_MANUAL", "REFUND",
  // "PENYESUAIAN_STOK").
  jenisAksi                  String
  referensiJenis             String
  referensiId                String
  status                     StatusPermintaanPersetujuan @default(DIAJUKAN)
  disetujuiOlehId            String?
  catatan                    String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  tenant                   Tenant             @relation(fields: [tenantId], references: [id])
  keanggotaanTenantPemohon KeanggotaanTenant  @relation("PersetujuanPemohon", fields: [keanggotaanTenantIdPemohon], references: [id])
  disetujuiOleh            KeanggotaanTenant? @relation("PersetujuanDisetujuiOleh", fields: [tenantId, disetujuiOlehId], references: [tenantId, id])

  @@map("permintaan_persetujuan")
}

// ALT-DEF-010: outlet di-relasi lewat composite-FK (tenantId, outletId) ->
// Outlet(tenantId, id) - menjamin tenantId Perangkat selalu sama dengan
// tenantId Outlet-nya di level database (lihat DECISION-LOG.md ADR-013).
model Perangkat {
  id           String          @id
  tenantId     String
  outletId     String
  jenis        JenisPerangkat
  kodeAktivasi String          @unique
  status       StatusPerangkat @default(AKTIF)
  lastSeenAt   DateTime?

  outlet           Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  sesi             Sesi[]
  // ALT-DEF-003/ALT-DEF-013: riwayat asosiasi Pengguna<->Perangkat ini (lihat
  // model RiwayatPerangkat) - append-only, terpisah dari baris Perangkat itu
  // sendiri (yang hanya menyimpan state TERKINI perangkat, bukan histori).
  riwayatPerangkat RiwayatPerangkat[]
  // ALT-HR-017: absensi yang direkam dari perangkat ini (pembatasan
  // perangkat presensi, opsional per tenant).
  absensi          Absensi[]

  // ALT-HR-017: agar Absensi bisa memakai composite-FK
  // (tenantId, perangkatId) -> Perangkat(tenantId, id).
  @@unique([tenantId, id])
  @@map("perangkat")
}

// ALT-DEF-003/ALT-DEF-013: sesi login diperkeras (session hardening).
// Keputusan desain (lihat DECISION-LOG.md ADR-014 untuk detail lengkap):
// - `tokenHash` (bukan menyimpan token bearer mentah) ditambahkan sebagai
//   kolom eksplisit yang unik - lookup sesi HARUS lewat hash token, tidak
//   pernah lewat `id` yang bisa ditebak/enumerasi.
// - `keanggotaanTenantId` NULLABLE - merepresentasikan konteks tenant AKTIF
//   dari sesi ini. Nullable karena alur login (`POST /api/v1/auth/masuk`,
//   lihat API-CONTRACT.md) menghasilkan Sesi GLOBAL dulu (identitas
//   `Pengguna`, ALT-DEF-001) SEBELUM klien memilih tenant lewat
//   `GET /api/v1/tenant-saya` - sesi tanpa tenant dipilih adalah state valid
//   (mis. baru login, belum pilih tenant; atau pengguna dengan tepat satu
//   `KeanggotaanTenant` yang bisa auto-select tanpa mengubah makna field ini).
//   TIDAK memakai composite-FK ke tenant karena Sesi sendiri tidak membawa
//   kolom tenantId - relasi ini murni "konteks yang sedang dipakai", bukan
//   kepemilikan data tenant-scoped.
model Sesi {
  id                  String    @id
  penggunaId          String
  keanggotaanTenantId String?
  perangkatId         String?
  // Hash dari token bearer sesi (never simpan token mentah) - unik agar
  // lookup sesi dari token yang disodorkan klien selalu tepat satu baris.
  tokenHash           String    @unique
  dibuatPada          DateTime  @default(now())
  kadaluarsaPada      DateTime
  // Diperbarui setiap request terautentikasi berhasil menggunakan sesi ini -
  // dipakai untuk mendeteksi sesi idle/dorman terlepas dari kadaluarsaPada.
  terakhirAktifPada   DateTime  @default(now())
  dicabutPada         DateTime?
  // Alasan pencabutan sesi (mis. "logout", "ganti kata sandi",
  // "dicabut manual oleh pengguna", "dicabut manual oleh admin",
  // "terdeteksi kompromi") - bebas teks, diisi service-layer saat mencabut.
  alasanPencabutan    String?
  ipHash              String?
  userAgent           String?

  pengguna          Pengguna           @relation(fields: [penggunaId], references: [id])
  keanggotaanTenant KeanggotaanTenant? @relation(fields: [keanggotaanTenantId], references: [id])
  perangkat         Perangkat?         @relation(fields: [perangkatId], references: [id])

  @@map("sesi")
}

// ALT-DEF-003: permintaan reset kata sandi. Satu baris per permintaan reset -
// token MENTAH dikirim ke email pengguna dan TIDAK PERNAH disimpan, hanya
// `tokenHash` (mis. SHA-256) yang disimpan di sini, sama seperti pola
// `Sesi.tokenHash`. `digunakanPada` menandai token sudah dipakai; Prisma
// tidak bisa menyatakan "unique tapi hanya saat digunakanPada IS NULL"
// (conditional uniqueness) di level skema - enforcement "token yang sudah
// dipakai atau kadaluarsa tidak boleh dipakai ulang" WAJIB dilakukan di
// service-layer (cek `digunakanPada IS NULL AND kadaluarsaPada > now()`
// sebelum menerima konsumsi token) - lihat DECISION-LOG.md ADR-014.
model TokenResetKataSandi {
  id             String    @id
  penggunaId     String
  tokenHash      String    @unique
  kadaluarsaPada DateTime
  digunakanPada  DateTime?
  createdAt      DateTime  @default(now())

  pengguna Pengguna @relation(fields: [penggunaId], references: [id])

  @@map("token_reset_kata_sandi")
}

// ALT-DEF-003: log percobaan login, APPEND-ONLY (tidak ada update/delete di
// level aplikasi) - dipakai untuk mendeteksi brute-force dan sebagai bagian
// jejak audit "audit login berhasil/gagal". Sengaja TIDAK di-FK ke Pengguna -
// percobaan login dengan email yang tidak terdaftar/salah ketik HARUS tetap
// tercatat (mis. untuk mendeteksi enumerasi email), dan FK wajib akan
// menolak baris semacam itu. `email` disimpan sebagai teks bebas (identifier
// yang dicoba), bukan referensi.
model PercobaanLogin {
  id        String   @id
  email     String
  berhasil  Boolean
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("percobaan_login")
}

// ALT-DEF-013: PIN per KOMBINASI keanggotaan-tenant + outlet (+ perangkat
// opsional) - BUKAN PIN global per Pengguna (pinHash lama sudah dihapus dari
// Pengguna sejak ALT-DEF-001, lihat catatan di model Pengguna). Memakai pola
// composite-FK ganda yang SAMA seperti KeanggotaanOutlet (ADR-011/ADR-013):
// kolom tenantId denormalisasi dipakai bersama oleh DUA relasi composite -
// (tenantId, outletId) -> Outlet(tenantId, id) dan
// (tenantId, keanggotaanTenantId) -> KeanggotaanTenant(tenantId, id) - agar
// PIN outlet tidak bisa dibuat untuk kombinasi keanggotaan-tenant dan outlet
// yang berasal dari tenant berbeda.
//
// Catatan NULL pada @@unique([keanggotaanTenantId, outletId, perangkatId])
// (lihat DECISION-LOG.md ADR-015 untuk detail lengkap): Postgres/Prisma
// menganggap NULL tidak pernah sama dengan NULL pada unique constraint,
// sehingga constraint ini TIDAK mencegah dua baris dengan perangkatId NULL
// (PIN "berlaku di semua perangkat") untuk kombinasi keanggotaanTenantId+
// outletId yang sama. Keputusan: dibiarkan sebagai keterbatasan yang
// didokumentasikan, enforcement "hanya satu PIN tanpa-perangkat-spesifik
// per keanggotaan-tenant+outlet" WAJIB dilakukan di service-layer (cek
// existing row dengan perangkatId IS NULL sebelum insert) - BUKAN
// mengandalkan constraint database untuk kasus ini.
model PinOutlet {
  id                  String              @id
  keanggotaanTenantId String
  tenantId            String
  outletId            String
  // Opsional - PIN bisa dibatasi berlaku hanya di satu perangkat tertentu.
  // Sengaja TIDAK di-FK ke model Perangkat (yang men-scope perangkat
  // fisik/infrastruktur outlet - KASIR/KDS/PRINTER/TABLET_PELAYAN) karena PIN
  // staf lazimnya dipakai dari perangkat pribadi/perangkat yang tidak selalu
  // teregistrasi sebagai Perangkat outlet (lihat DECISION-LOG.md ADR-015).
  perangkatId         String?
  pinHash             String
  status              StatusAktifNonaktif @default(AKTIF)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  outlet                        Outlet            @relation("PinOutletOutlet", fields: [tenantId, outletId], references: [tenantId, id])
  keanggotaanTenant             KeanggotaanTenant @relation(fields: [keanggotaanTenantId], references: [id])
  keanggotaanTenantTenantScoped KeanggotaanTenant @relation("PinOutletTenantScoped", fields: [tenantId, keanggotaanTenantId], references: [tenantId, id])

  @@unique([keanggotaanTenantId, outletId, perangkatId])
  @@map("pin_outlet")
}

// ALT-DEF-003/ALT-DEF-013: riwayat APPEND-ONLY asosiasi Pengguna<->Perangkat -
// berbeda dari model Perangkat (yang menyimpan state TERKINI satu perangkat
// fisik/infrastruktur outlet, mis. status AKTIF/NONAKTIF, lastSeenAt). Baris
// di sini dicatat setiap kali seorang Pengguna didaftarkan ke suatu
// Perangkat, memakainya untuk login/aktivitas, atau dicabut aksesnya -
// dipakai sebagai jejak audit keamanan perangkat per pengguna.
model RiwayatPerangkat {
  id          String               @id
  penggunaId  String
  perangkatId String
  aksi        AksiRiwayatPerangkat
  createdAt   DateTime             @default(now())

  pengguna  Pengguna  @relation(fields: [penggunaId], references: [id])
  perangkat Perangkat @relation(fields: [perangkatId], references: [id])

  @@map("riwayat_perangkat")
}

// ADR-033 (kasus KHUSUS - "audit log exception" per instruksi batch):
// `penggunaId` DIPERTAHANKAN sebagai FK langsung ke Pengguna - ini SNAPSHOT
// identitas historis-immutable ("siapa secara fisik melakukan aksi ini"),
// yang harus tetap terbaca dengan benar bahkan bila pengguna tsb kemudian
// kehilangan keanggotaan tenant (dikeluarkan/nonaktif) - audit log TIDAK
// boleh "kehilangan" siapa pelakunya hanya karena status keanggotaan berubah
// belakangan. `keanggotaanTenantId` (BARU) ditambahkan DI SAMPING-nya sebagai
// SUMBER VALIDASI ACTOR: composite-FK ke KeanggotaanTenant(tenantId, id)
// menjamin (di level DB, pada saat baris ini ditulis) bahwa aktor benar-benar
// tercatat sebagai anggota tenant yang sama dengan tenantId baris ini.
// Nullable: baris audit yang dihasilkan proses SISTEM (bukan aksi pengguna
// tertentu, mis. job terjadwal) tidak selalu punya keanggotaan tenant untuk
// dirujuk.
model AuditLog {
  id                  String   @id
  tenantId            String
  outletId            String?
  penggunaId          String
  keanggotaanTenantId String?
  aksi                String
  entitas             String
  entitasId           String
  sebelum             Json?
  sesudah             Json?
  createdAt           DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  pengguna          Pengguna           @relation(fields: [penggunaId], references: [id])
  keanggotaanTenant KeanggotaanTenant? @relation("AuditLogKeanggotaan", fields: [tenantId, keanggotaanTenantId], references: [tenantId, id])

  @@map("audit_log")
}

model PengaturanTenant {
  id       String @id
  tenantId String
  kunci    String
  nilai    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kunci])
  @@map("pengaturan_tenant")
}

// ALT-DEF-010: DIJUDGE AMAN TANPA composite-FK. PengaturanOutlet tidak
// membawa tenantId dan sengaja TIDAK ditambahkan satu di sini - model ini
// hanya punya SATU relasi (outletId -> Outlet) tanpa referensi tenant-owned
// lain yang bisa saling menyimpang (tidak seperti KeanggotaanOutlet yang
// punya DUA jalur independen yang harus dijamin konsisten). FK tunggal ke
// Outlet.id sudah sepenuhnya men-scope baris ini ke satu outlet; menambah
// kolom tenantId di sini hanya akan menduplikasi Outlet.tenantId tanpa
// menambah jaminan keamanan nyata. Lihat DECISION-LOG.md ADR-013.

model PengaturanOutlet {
  id       String @id
  outletId String
  kunci    String
  nilai    Json

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, kunci])
  @@map("pengaturan_outlet")
}

// =====================================================================================
// 2. MENU & KATALOG (docs/database/02-menu-katalog.md)
// =====================================================================================

enum StatusAktifNonaktif {
  AKTIF
  NONAKTIF
}

enum StatusItemMenu {
  AKTIF
  NONAKTIF
  HABIS
}

// ALT-DEF-010: outletId nullable (kategori berlaku lintas-outlet bila null),
// tetapi ketika diisi HARUS memakai composite-FK (tenantId, outletId) ->
// Outlet(tenantId, id). @@unique([tenantId, id]) ditambahkan agar ItemMenu
// bisa memakai composite FK menuju KategoriMenu (lihat ItemMenu di bawah).
model KategoriMenu {
  id       String              @id
  tenantId String
  outletId String?
  nama     String
  urutan   Int                 @default(0)
  status   StatusAktifNonaktif @default(AKTIF)

  outlet             Outlet?              @relation(fields: [tenantId, outletId], references: [tenantId, id])
  itemMenu           ItemMenu[]
  aturanRoutingDapur AturanRoutingDapur[]

  @@unique([tenantId, id])
  @@map("kategori_menu")
}

model ItemMenu {
  id              String         @id
  tenantId        String
  kategoriId      String
  nama            String
  deskripsi       String?
  gambarUrl       String?
  stokTakTerbatas Boolean        @default(true)
  status          StatusItemMenu @default(AKTIF)
  createdAt       DateTime       @default(now())

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, kategoriId) -> KategoriMenu(tenantId, id)
  // agar kategori yang dirujuk dijamin milik tenant yang sama dengan ItemMenu.
  kategori                KategoriMenu            @relation(fields: [tenantId, kategoriId], references: [tenantId, id])
  varian                  VarianMenu[]
  modifierGrup            ItemModifierGrup[]
  hargaOutlet             HargaItemOutlet[]       @relation("HargaItemOutletItemMenu")
  // ALT-DEF-007: BUKAN LAGI `Resep?` - `Resep.itemMenuId @unique` dihapus,
  // satu item menu boleh punya lebih dari satu kontainer resep (ADR-022).
  resep                   Resep[]
  itemPesanan             ItemPesanan[]
  rmPenjualanItemHarian   RmPenjualanItemHarian[]
  aturanRoutingDapur      AturanRoutingDapur[]
  // ALT-DEF-009: item yang dijadikan hadiah gratis oleh reward BOGO/ITEM_GRATIS.
  promoRewardItemGratis   PromoReward[]
  // ALT-DEF-039: item yang dijadikan hadiah gratis oleh HadiahStempel (program stempel).
  hadiahStempelItemGratis HadiahStempel[]

  @@unique([tenantId, id])
  @@map("item_menu")
}

model VarianMenu {
  id            String              @id
  itemMenuId    String
  nama          String
  hargaTambahan BigInt              @default(0)
  status        StatusAktifNonaktif @default(AKTIF)

  itemMenu    ItemMenu      @relation(fields: [itemMenuId], references: [id])
  itemPesanan ItemPesanan[]
  // ALT-DEF-007/ALT-RSP-003: resep khusus per varian (mis. porsi jumbo).
  resep       Resep[]

  @@map("varian_menu")
}

model ModifierGrup {
  id         String  @id
  tenantId   String
  nama       String
  wajibPilih Boolean @default(false)
  minPilihan Int     @default(0)
  maxPilihan Int     @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  itemModifier ItemModifierGrup[]
  opsi         ModifierOpsi[]

  @@map("modifier_grup")
}

model ItemModifierGrup {
  id             String @id
  itemMenuId     String
  modifierGrupId String
  urutan         Int    @default(0)

  itemMenu     ItemMenu     @relation(fields: [itemMenuId], references: [id])
  modifierGrup ModifierGrup @relation(fields: [modifierGrupId], references: [id])

  @@unique([itemMenuId, modifierGrupId])
  @@map("item_modifier_grup")
}

model ModifierOpsi {
  id             String              @id
  modifierGrupId String
  nama           String
  hargaTambahan  BigInt              @default(0)
  status         StatusAktifNonaktif @default(AKTIF)

  modifierGrup          ModifierGrup            @relation(fields: [modifierGrupId], references: [id])
  itemPesananModifier   ItemPesananModifier[]
  // ALT-DEF-007/ALT-RSP-004: efek modifier ini terhadap komposisi bahan.
  komponenResepModifier KomponenResepModifier[]

  @@map("modifier_opsi")
}

// ALT-DEF-010: sebelumnya tidak punya tenantId sama sekali (gap ditemukan
// saat audit) - ditambahkan di sini beserta DUA composite-FK (pola sama
// seperti KeanggotaanOutlet/ADR-011) agar itemMenuId DAN outletId yang
// dirujuk dijamin sama-sama milik tenant yang sama dengan baris ini.
model HargaItemOutlet {
  id           String   @id
  tenantId     String
  itemMenuId   String
  outletId     String
  harga        BigInt
  berlakuSejak DateTime @default(now())

  itemMenu ItemMenu @relation("HargaItemOutletItemMenu", fields: [tenantId, itemMenuId], references: [tenantId, id])
  outlet   Outlet   @relation("HargaItemOutletOutlet", fields: [tenantId, outletId], references: [tenantId, id])

  @@map("harga_item_outlet")
}

// =====================================================================================
// 3. RESEP & BAHAN / BOM (docs/database/03-resep-bahan.md)
// =====================================================================================

// ALT-DEF-007/ALT-RSP-005 (ADR-022 Keputusan 1): diskriminator jenis item
// persediaan. Inilah yang membuat SUBRESEP mungkin - sebuah
// BAHAN_SETENGAH_JADI adalah HASIL dari satu resep (`Resep.bahanHasilId`)
// sekaligus INPUT bagi resep lain (`KomponenResep.bahanId`). Tanpa
// diskriminator ini tidak ada cara membedakan "tepung terigu" (dibeli dari
// supplier) dari "adonan roti" (diproduksi internal lewat ProsesProduksi),
// padahal keduanya dikonsumsi resep induk dengan cara yang sama.
enum JenisBahan {
  BAHAN_BAKU
  BAHAN_SETENGAH_JADI
  PRODUK_JADI
  KEMASAN
  BARANG_OPERASIONAL
}

model Bahan {
  id            String              @id
  tenantId      String
  nama          String
  kodeSku       String
  satuanDasarId String
  // ALT-DEF-007: lihat enum JenisBahan di atas. Default BAHAN_BAKU karena
  // seluruh baris yang sudah ada sebelum batch ini adalah bahan baku beli.
  jenis         JenisBahan          @default(BAHAN_BAKU)
  stokMinimum   Int                 @default(0)
  status        StatusAktifNonaktif @default(AKTIF)

  tenant                     Tenant                    @relation(fields: [tenantId], references: [id])
  satuanDasar                Satuan                    @relation(fields: [satuanDasarId], references: [id])
  // ALT-DEF-007: `resepBahan ResepBahan[]` DIHAPUS - model ResepBahan
  // dibuang seluruhnya dan digantikan KomponenResep yang menggantung pada
  // VersiResep (ADR-022 Keputusan 4).
  komponenResep              KomponenResep[]
  komponenResepModifier      KomponenResepModifier[]   @relation("KomponenResepModifierBahan")
  komponenResepModifierGanti KomponenResepModifier[]   @relation("KomponenResepModifierBahanPengganti")
  resepHasil                 Resep[]                   @relation("ResepBahanHasil")
  prosesProduksiBaris        ProsesProduksiBaris[]
  batchProduksi              BatchProduksi[]           @relation("BatchProduksiBahanHasil")
  stokBahan                  StokBahan[]               @relation("StokBahanBahan")
  poBaris                    PurchaseOrderBaris[]
  penerimaanBaris            PenerimaanBarangBaris[]
  mutasiStok                 MutasiStok[]
  opnameBaris                StokOpnameBaris[]
  rmStokKritis               RmStokKritis[]
  // ALT-DEF-008: model baru domain persediaan (ADR-023/024/025).
  batchStok                  BatchStok[]
  reservasiStok              ReservasiStok[]
  penyesuaianStok            PenyesuaianStok[]
  transferStokBaris          TransferStokBaris[]
  catatanWaste               CatatanWaste[]
  kebijakanPemesananUlang    KebijakanPemesananUlang[]

  @@unique([tenantId, kodeSku])
  // ALT-DEF-010: agar StokBahan/MutasiStok/RmStokKritis bisa memakai
  // composite-FK (tenantId, bahanId) -> Bahan(tenantId, id).
  @@unique([tenantId, id])
  @@map("bahan")
}

model Satuan {
  id       String @id
  tenantId String
  nama     String
  simbol   String

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  bahan                 Bahan[]
  // ALT-DEF-007: `resepBahan ResepBahan[]` DIHAPUS bersama model ResepBahan.
  konversiDari          KonversiSatuan[]        @relation("KonversiSatuanDari")
  konversiKe            KonversiSatuan[]        @relation("KonversiSatuanKe")
  versiResepHasil       VersiResep[]            @relation("VersiResepSatuanHasil")
  komponenResep         KomponenResep[]
  komponenResepModifier KomponenResepModifier[]
  prosesProduksiBaris   ProsesProduksiBaris[]
  batchProduksi         BatchProduksi[]
  // ALT-DEF-008: satuan pada mutasi/reservasi/transfer/waste.
  mutasiStok            MutasiStok[]
  reservasiStok         ReservasiStok[]
  transferStokBaris     TransferStokBaris[]
  catatanWaste          CatatanWaste[]

  // ALT-DEF-007/ADR-013: agar KonversiSatuan/VersiResep/KomponenResep/
  // ProsesProduksiBaris/BatchProduksi (yang semuanya membawa tenantId
  // sendiri) bisa memakai composite-FK (tenantId, satuanId) -> Satuan(tenantId, id).
  @@unique([tenantId, id])
  @@map("satuan")
}

// ALT-DEF-007/ALT-RSP-008 (ADR-022 Keputusan 6): tabel konversi antar satuan
// per tenant. `faktor` adalah pengali dari `satuanDari` ke `satuanKe`
// (1 satuanDari = faktor satuanKe), mis. kg -> gram = 1000.
// Decimal, BUKAN Int - ADR-005 mewajibkan Int hanya untuk NILAI UANG rupiah;
// faktor konversi butuh presisi pecahan (mis. lusin -> pcs = 12, tetapi
// ons -> gram = 28.3495).
model KonversiSatuan {
  id           String   @id
  tenantId     String
  satuanDariId String
  satuanKeId   String
  faktor       Decimal
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  // ADR-013: composite-FK (tenantId, satuanXId) -> Satuan(tenantId, id).
  satuanDari Satuan @relation("KonversiSatuanDari", fields: [tenantId, satuanDariId], references: [tenantId, id])
  satuanKe   Satuan @relation("KonversiSatuanKe", fields: [tenantId, satuanKeId], references: [tenantId, id])

  @@unique([tenantId, satuanDariId, satuanKeId])
  @@map("konversi_satuan")
}

enum StatusResep {
  AKTIF
  NONAKTIF
}

// ALT-DEF-007/ALT-RSP-002 (ADR-022 Keputusan 3): status satu VERSI resep.
// Terpisah dari StatusResep (status kontainer resep) secara sengaja - sebuah
// Resep AKTIF dapat memiliki banyak versi NONAKTIF/ARSIP sekaligus tepat satu
// versi AKTIF. ARSIP dipisahkan dari NONAKTIF karena keduanya berbeda makna:
// NONAKTIF = versi lama yang digantikan tapi masih relevan untuk dibaca,
// ARSIP = versi yang sengaja disingkirkan dari daftar kerja. Tidak ada nilai
// DIHAPUS - versi resep TIDAK PERNAH dihapus karena ItemPesanan historis
// mereferensikannya (ADR-006, ADR-022 Keputusan 7).
enum StatusVersiResep {
  DRAF
  AKTIF
  NONAKTIF
  ARSIP
}

// ALT-DEF-007 (ADR-022 Keputusan 2): `Resep` BUKAN LAGI 1:1 dengan ItemMenu.
// Kolom `itemMenuId String @unique` dan `versi String` DIHAPUS. Resep kini
// adalah KONTAINER bernama yang menargetkan TEPAT SATU dari tiga sasaran:
//   - `itemMenuId`   -> resep dasar item menu           (ALT-RSP-001)
//   - `varianMenuId` -> resep khusus satu varian/porsi  (ALT-RSP-003)
//   - `bahanHasilId` -> SUBRESEP: hasilnya sebuah Bahan berjenis
//                       BAHAN_SETENGAH_JADI               (ALT-RSP-005)
//
// INVARIANT XOR: TEPAT SATU dari ketiga kolom di atas boleh non-null. Prisma
// TIDAK dapat mengekspresikan ini di DSL sama sekali. Penegakan sebenarnya
// adalah CHECK constraint Postgres di
// `prisma/migrations/manual/002_resep_target_xor_check.sql` - yang **belum
// pernah dijalankan** terhadap database nyata (ALT-DEF-029). Sampai saat itu
// invariant ini HANYA dijaga guard level-aplikasi. Jangan menganggapnya
// terjamin. Lihat ADR-022 Keputusan 2 untuk alternatif yang ditolak.
model Resep {
  id           String      @id
  tenantId     String
  nama         String
  itemMenuId   String?
  varianMenuId String?
  bahanHasilId String?
  status       StatusResep @default(AKTIF)
  createdAt    DateTime    @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  // ADR-013: composite-FK ke ItemMenu/Bahan (keduanya punya @@unique([tenantId, id])).
  itemMenu   ItemMenu?   @relation(fields: [tenantId, itemMenuId], references: [tenantId, id])
  // CATATAN TENANT-SAFETY (ALT-DEF-035): VarianMenu tidak membawa `tenantId`
  // sama sekali (ia tidak termasuk model yang diaudit ADR-013), sehingga
  // relasi ini TERPAKSA memakai FK ID tunggal - satu-satunya relasi di model
  // ini yang tidak composite. Dicatat sebagai defect terpisah, bukan
  // dilewati diam-diam.
  varianMenu VarianMenu? @relation(fields: [varianMenuId], references: [id])
  bahanHasil Bahan?      @relation("ResepBahanHasil", fields: [tenantId, bahanHasilId], references: [tenantId, id])

  versi VersiResep[]

  // Agar VersiResep bisa memakai composite-FK (tenantId, resepId).
  @@unique([tenantId, id])
  @@map("resep")
}

// ALT-DEF-007/ALT-RSP-002/ALT-RSP-006/ALT-RSP-007 (ADR-022 Keputusan 3):
// INTI perbaikan defect ini. Komposisi bahan TIDAK LAGI menggantung pada
// `Resep` melainkan pada satu VERSI resep, sehingga mengubah resep berarti
// membuat versi BARU - bukan menimpa komposisi lama yang masih dirujuk
// ItemPesanan historis (`ItemPesanan.resepVersiId`).
//
// - `jumlahHasil` + `satuanHasilId` = YIELD satu batch versi ini
//   (ALT-RSP-006, mis. 1 batch adonan = 5 kg).
// - `penyusutanPersen` = susut wajar saat produksi (ALT-RSP-007, mis. sayur
//   dikupas berkurang 10%). Decimal, bukan Int - ini persen pecahan.
// - `snapshotBiaya` = HPP terhitung (ALT-RSP-012) pada saat versi ini
//   DIAKTIFKAN, dalam RUPIAH BULAT -> Int per ADR-005. Nullable karena versi
//   DRAF belum pernah diaktifkan sehingga belum punya biaya terhitung.
//
// SATU VERSI AKTIF PER RESEP: sama persis dengan masalah "satu KonfigurasiQris
// AKTIF per outlet" (ADR-021 Keputusan 3) - butuh PARTIAL UNIQUE INDEX yang
// tidak dapat diekspresikan DSL Prisma. `@@unique([resepId, status])` DITOLAK
// TEGAS karena ia akan melarang satu resep punya lebih dari satu versi
// NONAKTIF, padahal riwayat versi lama justru WAJIB menumpuk (ADR-006).
// Penegak sebenarnya: `prisma/migrations/manual/003_versi_resep_satu_aktif.sql`
// (BELUM PERNAH DIJALANKAN, ALT-DEF-029) + guard transaksi level-aplikasi.
model VersiResep {
  id               String           @id
  tenantId         String
  resepId          String
  nomorVersi       Int
  berlakuSejak     DateTime
  berlakuSampai    DateTime?
  jumlahHasil      Decimal
  satuanHasilId    String
  penyusutanPersen Decimal          @default(0)
  snapshotBiaya    BigInt?
  status           StatusVersiResep @default(DRAF)
  createdAt        DateTime         @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  resep       Resep  @relation(fields: [tenantId, resepId], references: [tenantId, id])
  satuanHasil Satuan @relation("VersiResepSatuanHasil", fields: [tenantId, satuanHasilId], references: [tenantId, id])

  komponen         KomponenResep[]
  komponenModifier KomponenResepModifier[]
  prosesProduksi   ProsesProduksi[]
  itemPesanan      ItemPesanan[]

  @@unique([resepId, nomorVersi])
  @@unique([tenantId, id])
  @@map("versi_resep")
}

// ALT-DEF-007/ALT-RSP-001 (ADR-022 Keputusan 4): MENGGANTIKAN `ResepBahan`
// yang dihapus. Perbedaan yang menjadi seluruh inti perbaikan:
// `versiResepId`, BUKAN `resepId`. Baris komposisi milik satu VERSI; kalau ia
// tetap menggantung pada Resep, mengubah komposisi akan diam-diam menulis
// ulang HPP seluruh transaksi lampau yang memakai resep tersebut.
//
// `opsional` menandai komponen yang boleh tidak dipakai (mis. garnish) -
// pemotongan stok melewatinya bila outlet tidak menyediakannya, tanpa
// membuat resep dianggap tidak lengkap.
model KomponenResep {
  id           String   @id
  tenantId     String
  versiResepId String
  bahanId      String
  jumlah       Decimal
  satuanId     String
  opsional     Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  versiResep VersiResep @relation(fields: [tenantId, versiResepId], references: [tenantId, id])
  bahan      Bahan      @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  satuan     Satuan     @relation(fields: [tenantId, satuanId], references: [tenantId, id])

  // Satu bahan hanya boleh muncul sekali dalam satu versi resep - dua baris
  // untuk bahan yang sama membuat perhitungan HPP dan pemotongan stok ambigu.
  @@unique([versiResepId, bahanId])
  @@map("komponen_resep")
}

// ALT-DEF-007/ALT-RSP-004 (ADR-022 Keputusan 5): aksi yang dilakukan sebuah
// ModifierOpsi terhadap komposisi bahan versi resep.
//   TAMBAH  - menambah `jumlah` dari `bahanId`      (mis. "extra cheese" +20g)
//   KURANGI - mengurangi `jumlah` dari `bahanId`; menghilangkan seluruhnya
//             dimodelkan sebagai KURANGI dengan jumlah = jumlah komponen
//             ("no onion"). Tidak ada nilai HAPUS terpisah - lihat ADR-022
//             Keputusan 5 untuk alasannya.
//   GANTI   - `bahanId` diganti `bahanPenggantiId` sebanyak `jumlah`
//             (mis. "pakai susu oat" menggantikan susu sapi).
enum AksiKomponenModifier {
  TAMBAH
  KURANGI
  GANTI
}

// ALT-DEF-007/ALT-RSP-004: efek satu ModifierOpsi terhadap satu bahan pada
// satu VERSI resep. Menggantung pada `versiResepId` (bukan `resepId`) dengan
// alasan yang sama seperti KomponenResep - efek modifier ikut ter-snapshot
// bersama versinya.
//
// CATATAN TENANT-SAFETY (ALT-DEF-035): `modifierOpsiId` memakai FK ID
// tunggal karena `ModifierOpsi` tidak membawa `tenantId` (tidak diaudit
// ADR-013), sama seperti `Resep.varianMenu` di atas.
model KomponenResepModifier {
  id               String               @id
  tenantId         String
  versiResepId     String
  modifierOpsiId   String
  aksi             AksiKomponenModifier
  bahanId          String
  bahanPenggantiId String?
  jumlah           Decimal
  satuanId         String
  createdAt        DateTime             @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  versiResep     VersiResep   @relation(fields: [tenantId, versiResepId], references: [tenantId, id])
  modifierOpsi   ModifierOpsi @relation(fields: [modifierOpsiId], references: [id])
  bahan          Bahan        @relation("KomponenResepModifierBahan", fields: [tenantId, bahanId], references: [tenantId, id])
  bahanPengganti Bahan?       @relation("KomponenResepModifierBahanPengganti", fields: [tenantId, bahanPenggantiId], references: [tenantId, id])
  satuan         Satuan       @relation(fields: [tenantId, satuanId], references: [tenantId, id])

  @@unique([versiResepId, modifierOpsiId, bahanId])
  @@map("komponen_resep_modifier")
}

// ALT-DEF-007/ALT-RSP-009/ALT-RSP-010 (ADR-022 Keputusan 6).
enum StatusProsesProduksi {
  DRAF
  BERJALAN
  SELESAI
  DIBATALKAN
}

// ALT-DEF-007/ALT-RSP-009: satu eksekusi produksi nyata di satu outlet -
// "hari ini kita membuat 20 liter kaldu". `jumlahTarget` diisi saat
// direncanakan, `jumlahAktual` baru terisi saat SELESAI (karena itu nullable);
// selisih keduanya adalah realisasi vs rencana (ALT-RSP-009).
model ProsesProduksi {
  id               String               @id
  tenantId         String
  outletId         String
  versiResepId     String
  jumlahTarget     Decimal
  jumlahAktual     Decimal?
  status           StatusProsesProduksi @default(DRAF)
  dimulaiPada      DateTime?
  diselesaikanPada DateTime?
  dibuatOlehId     String
  createdAt        DateTime             @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  outlet     Outlet            @relation(fields: [tenantId, outletId], references: [tenantId, id])
  versiResep VersiResep        @relation(fields: [tenantId, versiResepId], references: [tenantId, id])
  // ADR-013 poin 5: relasi ke Pengguna TIDAK PERNAH di-composite-kan ke tenant.
  dibuatOleh KeanggotaanOutlet @relation("ProsesProduksiDibuatOleh", fields: [tenantId, outletId, dibuatOlehId], references: [tenantId, outletId, id])

  baris ProsesProduksiBaris[]
  batch BatchProduksi[]

  @@unique([tenantId, id])
  @@map("proses_produksi")
}

// ALT-DEF-007/ALT-RSP-010: konsumsi bahan AKTUAL per proses produksi -
// sengaja dicatat terpisah dari KomponenResep (yang hanya rencana per satuan
// hasil). Tanpa baris aktual, susut nyata tidak pernah bisa dibandingkan
// dengan `VersiResep.penyusutanPersen` yang diasumsikan.
//
// SEAM KE ALT-DEF-008 (persediaan): baris inilah yang akan menjadi sumber
// MutasiStok PRODUKSI_KELUAR; `BatchProduksi` di bawah menjadi sumber
// PRODUKSI_MASUK. Batch ini TIDAK membuat mutasi stok apa pun - lihat
// ADR-022 Keputusan 8 (serah-terima).
model ProsesProduksiBaris {
  id               String  @id
  tenantId         String
  prosesProduksiId String
  bahanId          String
  jumlahDipakai    Decimal
  satuanId         String

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  prosesProduksi ProsesProduksi @relation(fields: [tenantId, prosesProduksiId], references: [tenantId, id])
  bahan          Bahan          @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  satuan         Satuan         @relation(fields: [tenantId, satuanId], references: [tenantId, id])

  @@map("proses_produksi_baris")
}

// ALT-DEF-007/ALT-RSP-010: status satu batch hasil produksi. `KEDALUWARSA`
// dan `DIBUANG` dipisahkan karena berbeda konsekuensi akuntansi (yang satu
// otomatis dari tanggal, yang satu keputusan manusia dengan alasan).
enum StatusBatchProduksi {
  TERSEDIA
  HABIS
  KEDALUWARSA
  DIBUANG
}

// ALT-DEF-007/ALT-RSP-010: batch bahan setengah jadi hasil satu proses
// produksi. `tanggalKedaluwarsa` adalah kolom yang akan dipakai FEFO oleh
// batch persediaan berikutnya (ALT-DEF-008) - nullable karena tidak semua
// hasil produksi punya masa kedaluwarsa yang dicatat.
model BatchProduksi {
  id                 String              @id
  tenantId           String
  outletId           String
  prosesProduksiId   String
  bahanHasilId       String
  nomorBatch         String
  jumlah             Decimal
  satuanId           String
  tanggalProduksi    DateTime
  tanggalKedaluwarsa DateTime?
  status             StatusBatchProduksi @default(TERSEDIA)
  createdAt          DateTime            @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  outlet         Outlet         @relation(fields: [tenantId, outletId], references: [tenantId, id])
  prosesProduksi ProsesProduksi @relation(fields: [tenantId, prosesProduksiId], references: [tenantId, id])
  bahanHasil     Bahan          @relation("BatchProduksiBahanHasil", fields: [tenantId, bahanHasilId], references: [tenantId, id])
  satuan         Satuan         @relation(fields: [tenantId, satuanId], references: [tenantId, id])

  // ALT-DEF-008 (ADR-024 Keputusan 3): SEAM yang dijanjikan ADR-022 Keputusan 8
  // poin 4 DITEBUS - `BatchStok` (domain persediaan) menunjuk ke sini lewat
  // composite-FK (tenantId, batchProduksiId), 1:1 opsional. Batch produksi
  // adalah catatan APA YANG DIBUAT; BatchStok adalah catatan APA YANG ADA DI
  // RAK. Keduanya TIDAK disatukan - lihat rasional lengkap di model BatchStok.
  batchStok BatchStok?

  @@unique([tenantId, nomorBatch])
  // Agar model persediaan/FEFO batch berikutnya (ALT-DEF-008) bisa memakai
  // composite-FK (tenantId, batchProduksiId) -> BatchProduksi(tenantId, id).
  @@unique([tenantId, id])
  @@map("batch_produksi")
}

// =====================================================================================
// 4. PERSEDIAAN (docs/database/04-persediaan.md)
// =====================================================================================
//
// ALT-DEF-008 / ADR-023 s.d. ADR-025 (lihat docs/engineering/DECISION-LOG.md).
//
// ATURAN KERAS DOMAIN INI: `MutasiStok` adalah LEDGER APPEND-ONLY dan satu-
// satunya SUMBER KEBENARAN saldo stok. `StokBahan` adalah CACHE TURUNAN
// (read-model) yang boleh dibuang dan dihitung ulang kapan saja dari
// SUM(MutasiStok.jumlah); ia TIDAK PERNAH otoritatif. Setiap peristiwa stok
// (pembelian, pemakaian resep, waste, transfer, opname, produksi) WAJIB
// menulis baris `MutasiStok` baru; tidak ada satu pun jalur yang boleh menulis
// `StokBahan` tanpa baris mutasi pendampingnya. Koreksi SELALU berupa baris
// PEMBALIK baru (ADR-006), tidak pernah UPDATE/DELETE atas baris mutasi asal.
// Lihat ADR-023 Keputusan 1 untuk rasional lengkap dan seam job rekonsiliasi.

// ALT-DEF-008 (ADR-023 Keputusan 2): enum lama yang KOARSE
// (MASUK_PEMBELIAN/KELUAR_PENJUALAN/OPNAME_PENYESUAIAN/TRANSFER_MASUK/
// TRANSFER_KELUAR/RETUR) DIGANTI daftar penuh 12 nilai. Pemetaan nilai lama ->
// baru didokumentasikan di ADR-023 Keputusan 2 dan docs/database/04-persediaan.md.
// Nilai lama TIDAK dipertahankan berdampingan: tidak ada migrasi yang pernah
// dijalankan (ALT-DEF-029) sehingga belum ada satu baris data pun, dan
// membiarkan dua nama untuk satu peristiwa yang sama adalah persis kelas defect
// yang sedang diperbaiki.
enum JenisMutasiStok {
  // MASUK
  PEMBELIAN_MASUK
  RETUR_PENJUALAN
  TRANSFER_MASUK
  PRODUKSI_MASUK
  // KELUAR
  PEMAKAIAN_RESEP
  RETUR_SUPPLIER
  TRANSFER_KELUAR
  PRODUKSI_KELUAR
  WASTE
  PEMAKAIAN_INTERNAL
  // DUA ARAH (tanda ditentukan `jumlah`, bukan oleh nilai enum)
  PENYESUAIAN
  KOREKSI_OPNAME
}

// ALT-DEF-008: diperluas mengikuti jenis dokumen sumber yang kini benar-benar
// ada sebagai model (PenyesuaianStok/CatatanWaste/TransferStok/ProsesProduksi).
enum ReferensiJenisMutasi {
  PEMBELIAN
  PESANAN
  OPNAME
  TRANSFER
  PRODUKSI
  WASTE
  PENYESUAIAN
  RETUR_PEMBELIAN
  PEMAKAIAN_INTERNAL
}

// ALT-DEF-008 (ADR-025): state machine opname LENGKAP menggantikan
// DIRENCANAKAN/BERLANGSUNG/SELESAI/DIBATALKAN yang lama. Pemetaan:
// DIRENCANAKAN -> DRAF, BERLANGSUNG -> SEDANG_DIHITUNG,
// SELESAI -> DIPOSTING, DIBATALKAN -> DIBATALKAN.
// DIKUNCI dan MENUNGGU_PERSETUJUAN adalah status BARU yang sebelumnya tidak
// punya padanan sama sekali - tanpa keduanya, ALT-PSD-017 (approval selisih
// signifikan) tidak punya tempat untuk berdiri. Tabel transisi penuh ada di
// docs/arsitektur/STATE-MACHINES.md bagian 7.
enum StatusStokOpname {
  DRAF
  SEDANG_DIHITUNG
  DIKUNCI
  MENUNGGU_PERSETUJUAN
  DISETUJUI
  DIPOSTING
  DIBATALKAN
}

// ALT-DEF-008 (ADR-024 Keputusan 4): state machine transfer stok antar
// gudang/outlet. `DITERIMA_SEBAGIAN` dipisahkan dari `DITERIMA` karena
// keduanya punya konsekuensi berbeda: yang pertama masih menyisakan barang
// "dalam perjalanan" yang belum jadi saldo di gudang mana pun.
enum StatusTransferStok {
  DRAF
  DIAJUKAN
  DISETUJUI
  DIKIRIM
  DITERIMA_SEBAGIAN
  DITERIMA
  DIBATALKAN
}

// ALT-DEF-008/ALT-PSD-004: jenis sub-lokasi penyimpanan di dalam satu Gudang.
// Nullable di LokasiStok - "rak nomor 3" yang tidak dikategorikan tetap sah.
enum JenisLokasiStok {
  RAK
  CHILLER
  FREEZER
  GUDANG_KERING
  AREA_PERSIAPAN
  LAINNYA
}

// ALT-DEF-008/ALT-PSD-010: status satu batch stok fisik. Sengaja SAMA
// bentuknya dengan StatusBatchProduksi (ADR-022 Keputusan 6) - KEDALUWARSA
// (konsekuensi tanggal) dipisahkan dari DIBUANG (keputusan manusia beralasan,
// yang menghasilkan CatatanWaste + mutasi WASTE).
enum StatusBatchStok {
  TERSEDIA
  HABIS
  KEDALUWARSA
  DIBUANG
}

// ALT-DEF-008/ALT-PSD-008 (ADR-024 Keputusan 2): siklus hidup satu reservasi.
// DILEPAS = dibatalkan tanpa pemakaian (pesanan batal/ditolak);
// DIKONSUMSI = berubah menjadi mutasi stok nyata (pemakaian terjadi);
// KEDALUWARSA = melewati batas waktu tanpa keputusan (job penyapu).
// Ketiganya TERMINAL. Membedakan DILEPAS dari DIKONSUMSI wajib: hanya yang
// kedua yang punya baris MutasiStok pendamping.
enum StatusReservasiStok {
  AKTIF
  DILEPAS
  DIKONSUMSI
  KEDALUWARSA
}

// ALT-DEF-008/ALT-PSD-018: metode perhitungan saran pemesanan ulang.
enum MetodePemesananUlang {
  MIN_MAX
  FIXED
}

// ALT-DEF-008 (ADR-025 Keputusan 1): kapan stok BENAR-BENAR dipotong dari
// ledger. Rekomendasi default SAAT_MASUK_DAPUR - saat itulah bahan secara
// fisik mulai dipakai, sehingga saldo ledger paling dekat dengan kenyataan
// rak. Reservasi (ReservasiStok) menutup jendela antara pesanan diterima dan
// bahan benar-benar dipakai.
enum KebijakanPemotonganStok {
  SAAT_PESANAN_DITERIMA
  SAAT_MASUK_DAPUR
  SAAT_SELESAI
  SAAT_PEMBAYARAN
}

// ALT-DEF-008/ALT-PSD-011 (ADR-025 Keputusan 3): FEFO = first-expired-
// first-out (wajib untuk bahan perishable), FIFO = fallback berdasarkan
// createdAt untuk bahan tanpa tanggal kedaluwarsa.
enum MetodeAlokasiBatch {
  FEFO
  FIFO
}

// ALT-DEF-010: outlet direlasi lewat composite-FK (tenantId, outletId) ->
// Outlet(tenantId, id). @@unique([tenantId, id]) ditambahkan agar
// StokBahan/MutasiStok/StokOpname/PenerimaanBarang bisa memakai composite FK
// menuju Gudang.
// ALT-DEF-008: @@unique([outletId, id]) BARU ditambahkan - TransferStok
// memakainya untuk menjamin di level database bahwa `gudangAsal` benar-benar
// milik `outletAsal` (dan `gudangTujuan` milik `outletTujuan`), jaminan yang
// TIDAK didapat dari composite (tenantId, gudangId) saja pada tenant
// multi-outlet. Pola varian outlet-level per ADR-013 poin 3.
model Gudang {
  id       String              @id
  tenantId String
  outletId String
  nama     String
  status   StatusAktifNonaktif @default(AKTIF)

  outlet           Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  stokBahan        StokBahan[]        @relation("StokBahanGudang")
  stokOpname       StokOpname[]
  penerimaanBarang PenerimaanBarang[] @relation("PenerimaanBarangGudang")
  MutasiStok       MutasiStok[]
  // ALT-DEF-008: sub-lokasi, waste, dan kedua sisi transfer.
  lokasiStok       LokasiStok[]
  catatanWaste     CatatanWaste[]
  transferAsal     TransferStok[]     @relation("TransferStokGudangAsal")
  transferTujuan   TransferStok[]     @relation("TransferStokGudangTujuan")

  @@unique([tenantId, id])
  @@unique([outletId, id])
  @@map("gudang")
}

// ALT-DEF-008/ALT-PSD-004 (ADR-024 Keputusan 1): sub-lokasi penyimpanan di
// dalam satu Gudang (rak, chiller, freezer). Ini yang membuat "saldo per
// lokasi" (acceptance ALT-PSD-004) mungkin sama sekali - sebelumnya granularitas
// terhalus adalah gudang.
model LokasiStok {
  id       String              @id
  tenantId String
  outletId String
  gudangId String
  nama     String
  jenis    JenisLokasiStok?
  status   StatusAktifNonaktif @default(AKTIF)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // Composite outlet-level (ADR-013 poin 3): lokasi TIDAK boleh menunjuk
  // gudang milik outlet lain, meski masih satu tenant.
  gudang Gudang @relation(fields: [outletId, gudangId], references: [outletId, id])

  stokBahan    StokBahan[]
  batchStok    BatchStok[]
  catatanWaste CatatanWaste[]
  mutasiSumber MutasiStok[]      @relation("MutasiStokLokasiSumber")
  mutasiTujuan MutasiStok[]      @relation("MutasiStokLokasiTujuan")
  opnameBaris  StokOpnameBaris[]

  @@unique([gudangId, nama])
  @@unique([tenantId, id])
  @@map("lokasi_stok")
}

// ALT-DEF-010: sebelumnya tidak punya tenantId sama sekali (gap ditemukan
// saat audit) - Gudang dan Bahan bisa secara teori dimiliki tenant berbeda
// tanpa jaminan apa pun. Ditambahkan tenantId denormalisasi + DUA
// composite-FK (pola sama seperti KeanggotaanOutlet/ADR-011).
//
// ALT-DEF-008 (ADR-023 Keputusan 3) - NAMA MODEL SENGAJA TETAP `StokBahan`,
// BUKAN `SaldoStok` seperti bunyi MASTER-CHECKLIST ALT-PSD-007. Model ini
// sudah melakukan persis tugas yang dimaksud `SaldoStok`, sudah dirujuk
// composite-FK yang divalidasi (ADR-013), dan sudah punya @@map("stok_bahan").
// Mengganti namanya adalah churn murni tanpa jaminan tambahan apa pun.
// `SaldoStok` diperlakukan sebagai ALIAS dokumentasi.
//
// **INI CACHE TURUNAN, BUKAN SUMBER KEBENARAN.** `kuantitas` di sini WAJIB
// selalu sama dengan SUM(MutasiStok.jumlah) untuk (gudangId, bahanId,
// lokasiStokId) yang sama. Bila berbeda, YANG BENAR ADALAH LEDGER dan baris
// ini yang salah - job rekonsiliasi menulis ulang baris ini, tidak pernah
// sebaliknya (ADR-023 Keputusan 1).
model StokBahan {
  id                   String    @id
  tenantId             String
  gudangId             String
  bahanId              String
  // ALT-DEF-008: nullable = baris agregat level-GUDANG (jumlah seluruh lokasi).
  // Non-null = saldo satu sub-lokasi tertentu (ALT-PSD-004).
  lokasiStokId         String?
  kuantitas            Decimal   @default(0)
  // ALT-DEF-008: kuantitas yang sedang direservasi (ReservasiStok AKTIF).
  // Stok TERSEDIA = kuantitas - kuantitasDireservasi. Reservasi mengurangi
  // stok TERSEDIA tanpa menyentuh stok FISIK (ADR-024 Keputusan 2).
  // Ini juga CACHE - kebenarannya SUM(ReservasiStok.jumlah WHERE AKTIF).
  kuantitasDireservasi Decimal   @default(0)
  // ALT-DEF-008: kapan baris cache ini terakhir direkonsiliasi dari ledger.
  direkonsiliasiPada   DateTime?
  updatedAt            DateTime  @updatedAt

  gudang     Gudang      @relation("StokBahanGudang", fields: [tenantId, gudangId], references: [tenantId, id])
  bahan      Bahan       @relation("StokBahanBahan", fields: [tenantId, bahanId], references: [tenantId, id])
  lokasiStok LokasiStok? @relation(fields: [tenantId, lokasiStokId], references: [tenantId, id])

  // ALT-DEF-008 PERINGATAN NULL-SEMANTICS: Postgres memperlakukan NULL sebagai
  // NILAI YANG BERBEDA di unique index, sehingga @@unique di bawah TIDAK
  // mencegah DUA baris agregat level-gudang (lokasiStokId NULL) untuk pasangan
  // (gudangId, bahanId) yang sama. Penegak baris-agregat-tunggal adalah partial
  // unique index Postgres di
  // prisma/migrations/manual/004_stok_bahan_agregat_gudang_unik.sql
  // (BELUM PERNAH DIJALANKAN, ALT-DEF-029). Dicatat di sini agar constraint di
  // bawah tidak disalahartikan sebagai jaminan penuh.
  @@unique([gudangId, bahanId, lokasiStokId])
  @@map("stok_bahan")
}

// ALT-DEF-008 (ADR-023 Keputusan 1): LEDGER APPEND-ONLY. Model ini SENGAJA
// tidak punya `updatedAt`, tidak punya kolom status/soft-delete, dan tidak
// punya jalur UPDATE apa pun di service layer - satu-satunya operasi yang sah
// adalah INSERT. Koreksi = INSERT baris PEMBALIK (ADR-006).
//
// KETERBATASAN JUJUR: "append-only" TIDAK ditegakkan database pada batch ini.
// Postgres tidak punya bentuk deklaratif untuk "tabel ini hanya menerima
// INSERT"; penegak sebenarnya adalah (a) revoke UPDATE/DELETE pada role
// aplikasi dan (b) trigger penolak, keduanya ada di
// prisma/migrations/manual/005_mutasi_stok_append_only_dan_pembalik.sql yang
// BELUM PERNAH DIJALANKAN (ALT-DEF-029). Sampai saat itu, append-only adalah
// disiplin level-aplikasi.
model MutasiStok {
  id               String               @id
  tenantId         String
  outletId         String
  gudangId         String
  bahanId          String
  jenis            JenisMutasiStok
  // Positif = masuk, negatif = keluar. TIDAK ADA kolom terpisah untuk arah -
  // satu sumber kebenaran tanda, sehingga SUM() langsung menghasilkan saldo.
  jumlah           Decimal
  // ALT-DEF-008: satuan pada saat mutasi dicatat. Nullable karena baris lama
  // (bila kelak ada) diasumsikan memakai satuan dasar bahan.
  satuanId         String?
  referensiJenis   ReferensiJenisMutasi
  referensiId      String
  // ALT-DEF-008/ALT-PSD-004: transfer bergerak ANTAR LOKASI - keduanya terisi.
  // Pembelian hanya punya tujuan; penjualan/pemakaian hanya punya sumber.
  // Karena itu KEDUANYA nullable, dan aturan "mana yang wajib untuk jenis apa"
  // adalah invariant LEVEL-APLIKASI (Prisma maupun CHECK sederhana tidak bisa
  // mengekspresikan kondisional per-nilai-enum tanpa CHECK manual).
  lokasiSumberId   String?
  lokasiTujuanId   String?
  // ALT-DEF-008/ALT-PSD-011: batch yang dialokasikan FEFO/FIFO. Nullable -
  // tidak semua bahan di-batch (mis. bumbu curah).
  batchStokId      String?
  // ALT-DEF-008: harga perolehan per satuan saat mutasi (rupiah bulat,
  // ADR-005). Nullable - hanya mutasi MASUK yang membawa biaya perolehan.
  hargaPerolehan   BigInt?
  // ADR-032: alasan/justifikasi WAJIB untuk SETIAP baris mutasi_stok (bukan
  // hanya baris pembalik) demi auditabilitas penuh - lihat catatan ADR-032
  // Keputusan 4 untuk rasional "wajib untuk semua baris, bukan cuma pembalik".
  // `catatan` tetap ada terpisah sebagai keterangan bebas TAMBAHAN opsional.
  alasan           String
  catatan          String?
  // ADR-032: redesain arah pointer pembalik - kolom ini kini ada di baris
  // PEMBALIK (menunjuk MUNDUR ke baris ASAL yang dibalikkannya), BUKAN lagi di
  // baris asal menunjuk maju ke pembaliknya (`dibalikOlehId` lama, ADR-023).
  // Baris ASAL TIDAK PERNAH di-UPDATE untuk alasan apa pun (append-only murni,
  // nol pengecualian) - "sudah dibalik atau belum" kini query turunan:
  // `SELECT 1 FROM mutasi_stok WHERE "membalikMutasiId" = <id-asal>`.
  // `@unique` di sini menegakkan "paling banyak SATU baris pembalik per baris
  // asal" (dua baris pembalik berbeda tidak boleh menunjuk baris asal yang
  // sama) - lihat ADR-032 Keputusan 1 untuk penjelasan kenapa @unique pada
  // kolom INI (di sisi pembalik) adalah tempat yang benar untuk constraint
  // tsb, berbeda dari kesan pertama yang salah ("@unique pada FK apa saja
  // trivially true").
  membalikMutasiId String?              @unique
  dibuatOlehId     String
  createdAt        DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: sebelumnya gudangId ada sebagai kolom scalar TANPA relasi FK
  // sama sekali (gap ditemukan saat audit) - ditambahkan di sini sebagai
  // composite-FK (tenantId, gudangId) -> Gudang(tenantId, id).
  gudang Gudang @relation(fields: [tenantId, gudangId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, bahanId) -> Bahan(tenantId, id).
  bahan  Bahan  @relation(fields: [tenantId, bahanId], references: [tenantId, id])

  // ALT-DEF-008: relasi-relasi baru. `dibuatOleh` sebelumnya hanya kolom
  // scalar TANPA FK sama sekali (gap yang sama seperti gudangId dulu) -
  // FK ID tunggal ke Pengguna per ADR-013 poin 5.
  satuan       Satuan?           @relation(fields: [tenantId, satuanId], references: [tenantId, id])
  lokasiSumber LokasiStok?       @relation("MutasiStokLokasiSumber", fields: [tenantId, lokasiSumberId], references: [tenantId, id])
  lokasiTujuan LokasiStok?       @relation("MutasiStokLokasiTujuan", fields: [tenantId, lokasiTujuanId], references: [tenantId, id])
  batchStok    BatchStok?        @relation(fields: [tenantId, batchStokId], references: [tenantId, id])
  dibuatOleh   KeanggotaanOutlet @relation("MutasiStokDibuatOleh", fields: [tenantId, outletId, dibuatOlehId], references: [tenantId, outletId, id])

  // Reversal (ADR-032, redesain dari ADR-023): `membalikMutasi` menunjuk
  // MUNDUR ke mutasi ASAL yang dibalikkan baris ini (hanya terisi pada baris
  // PEMBALIK). `pembalik` adalah sisi kebalikannya - baris pembalik yang
  // menunjuk KE baris ini (hanya terisi pada baris yang SUDAH dibalik).
  // Yang TIDAK ditegakkan Prisma (ditegakkan trigger `ledger_validasi_pembalik`
  // - lihat migrasi `redesign_ledger_reversal_membalik_pattern`): tanda
  // berlawanan, kesamaan tenant/gudang/bahan/satuan/batch/harga/lokasi, dan
  // larangan rantai pembalik-dari-pembalik.
  membalikMutasi MutasiStok? @relation("MutasiPembalik", fields: [membalikMutasiId], references: [id])
  pembalik       MutasiStok? @relation("MutasiPembalik")

  penyesuaianStok     PenyesuaianStok?
  catatanWaste        CatatanWaste?
  transferBarisKeluar TransferStokBaris[] @relation("TransferBarisMutasiKeluar")
  transferBarisMasuk  TransferStokBaris[] @relation("TransferBarisMutasiMasuk")
  opnameBarisKoreksi  StokOpnameBaris?

  // ALT-DEF-008: agar PenyesuaianStok/CatatanWaste/TransferStokBaris/
  // StokOpnameBaris bisa memakai composite-FK (tenantId, mutasiStokId).
  @@unique([tenantId, id])
  @@index([tenantId, gudangId, bahanId, createdAt])
  @@index([tenantId, referensiJenis, referensiId])
  @@map("mutasi_stok")
}

// ALT-DEF-008/ALT-PSD-010 (ADR-024 Keputusan 3): satu batch fisik stok -
// pembawa tanggal kedaluwarsa (FEFO), tanggal produksi, harga perolehan, dan
// lokasi. `createdAt` melengkapinya sebagai kunci urut FIFO fallback.
//
// SEAM BatchProduksi <-> BatchStok (ADR-024 Keputusan 3, memenuhi handoff
// ADR-022 Keputusan 8 poin 4): KEDUANYA DIPERTAHANKAN dan DISAMBUNGKAN FK,
// TIDAK disatukan. `BatchProduksi` adalah catatan domain PRODUKSI (apa yang
// dibuat, dari proses mana, yield berapa); `BatchStok` adalah catatan domain
// PERSEDIAAN (apa yang ADA di rak, berapa harga perolehannya, di lokasi mana,
// kapan kedaluwarsa). Menyatukannya DITOLAK karena batch hasil PEMBELIAN tidak
// punya `prosesProduksiId` sama sekali - menyatukan berarti membuat kolom
// produksi nullable untuk mayoritas baris, dan menaruh kolom persediaan
// (hargaPerolehan/lokasiStokId) di tabel domain produksi.
// `@@unique([tenantId, batchProduksiId])` membuat relasi ini 1:1 opsional -
// satu BatchProduksi menghasilkan PALING BANYAK satu BatchStok.
// INVARIANT LEVEL-APLIKASI: setiap `BatchProduksi` atas bahan
// BAHAN_SETENGAH_JADI WAJIB melahirkan tepat satu `BatchStok` dalam transaksi
// yang sama dengan mutasi `PRODUKSI_MASUK`. Prisma tidak bisa mewajibkan sisi
// itu (kolom ada di sisi BatchStok dan harus nullable untuk batch pembelian).
model BatchStok {
  id                 String          @id
  tenantId           String
  outletId           String
  bahanId            String
  nomorBatch         String
  tanggalProduksi    DateTime?
  tanggalKedaluwarsa DateTime?
  kuantitasAwal      Decimal
  // Rupiah bulat per ADR-005 - harga perolehan per satuan dasar bahan.
  hargaPerolehan     BigInt
  lokasiStokId       String?
  // SEAM ke domain produksi (ADR-022 Keputusan 8). Nullable: batch hasil
  // PEMBELIAN tidak punya proses produksi.
  batchProduksiId    String?
  status             StatusBatchStok @default(TERSEDIA)
  createdAt          DateTime        @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  outlet        Outlet         @relation(fields: [tenantId, outletId], references: [tenantId, id])
  bahan         Bahan          @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  lokasiStok    LokasiStok?    @relation(fields: [tenantId, lokasiStokId], references: [tenantId, id])
  batchProduksi BatchProduksi? @relation(fields: [tenantId, batchProduksiId], references: [tenantId, id])

  mutasiStok        MutasiStok[]
  catatanWaste      CatatanWaste[]
  transferStokBaris TransferStokBaris[]
  opnameBaris       StokOpnameBaris[]

  @@unique([tenantId, bahanId, nomorBatch])
  @@unique([tenantId, batchProduksiId])
  @@unique([tenantId, id])
  // Indeks pendukung FEFO (kedaluwarsa terdekat dulu) dan FIFO (createdAt).
  @@index([tenantId, bahanId, status, tanggalKedaluwarsa])
  @@index([tenantId, bahanId, status, createdAt])
  @@map("batch_stok")
}

// ALT-DEF-008/ALT-PSD-008/ALT-PSD-009 (ADR-024 Keputusan 2): reservasi stok.
// Reservasi mengurangi stok TERSEDIA tanpa menyentuh stok FISIK - ia BUKAN
// mutasi dan SENGAJA tidak menulis baris `MutasiStok`. Barulah saat
// DIKONSUMSI, satu mutasi `PEMAKAIAN_RESEP` ditulis.
//
// INVARIANT LEVEL-APLIKASI (tidak bisa diekspresikan Prisma - ia invariant
// SUM lintas-baris): SUM(jumlah) atas reservasi AKTIF untuk satu bahan di satu
// gudang tidak boleh melebihi saldo fisik bahan tsb. Penegakannya adalah guard
// transaksi + SELECT ... FOR UPDATE pada baris StokBahan.
model ReservasiStok {
  id              String              @id
  tenantId        String
  outletId        String
  itemPesananId   String
  bahanId         String
  jumlah          Decimal
  satuanId        String
  status          StatusReservasiStok @default(AKTIF)
  // Batas waktu reservasi otomatis kedaluwarsa (job penyapu). Nullable -
  // kebijakan tanpa batas waktu sah.
  kedaluwarsaPada DateTime?
  createdAt       DateTime            @default(now())
  dilepasPada     DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  outlet      Outlet      @relation(fields: [tenantId, outletId], references: [tenantId, id])
  bahan       Bahan       @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  satuan      Satuan      @relation(fields: [tenantId, satuanId], references: [tenantId, id])
  // FK ID tunggal: ItemPesanan tidak membawa tenantId sendiri (baris di bawah
  // Pesanan, ADR-013) - konsisten dengan ItemPesanan.resepVersi (ADR-022 K7).
  itemPesanan ItemPesanan @relation(fields: [itemPesananId], references: [id])

  @@index([tenantId, bahanId, status])
  @@index([itemPesananId, status])
  @@map("reservasi_stok")
}

// ALT-DEF-008 (ADR-023 Keputusan 4): dokumen penyesuaian manual. `mutasiStokId`
// WAJIB dan @unique - satu penyesuaian TEPAT SATU baris ledger; penyesuaian
// tanpa mutasi berarti saldo berubah tanpa jejak ledger, yaitu pelanggaran
// aturan keras domain ini.
model PenyesuaianStok {
  id              String   @id
  tenantId        String
  outletId        String
  bahanId         String
  jumlahSebelum   Decimal
  jumlahSesudah   Decimal
  alasan          String
  disetujuiOlehId String?
  mutasiStokId    String   @unique
  dicatatOlehId   String
  createdAt       DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  outlet        Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  bahan         Bahan              @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  mutasiStok    MutasiStok         @relation(fields: [tenantId, mutasiStokId], references: [tenantId, id])
  disetujuiOleh KeanggotaanOutlet? @relation("PenyesuaianStokDisetujuiOleh", fields: [tenantId, outletId, disetujuiOlehId], references: [tenantId, outletId, id])
  dicatatOleh   KeanggotaanOutlet  @relation("PenyesuaianStokDicatatOleh", fields: [tenantId, outletId, dicatatOlehId], references: [tenantId, outletId, id])

  // Prisma mewajibkan unique yang mencakup seluruh field composite pada
  // relasi 1-1 (pola yang sama seperti TiketDapur.pesananId, ADR-013).
  @@unique([tenantId, mutasiStokId])
  @@map("penyesuaian_stok")
}

// ALT-DEF-008/ALT-PSD-012/ALT-PSD-013 (ADR-024 Keputusan 4): header transfer
// stok antar gudang/outlet. MENUTUP GAP ALT-DEF-032 (endpoint transfer stok
// disebut spec idempotency tetapi tidak pernah ada di kontrak API).
model TransferStok {
  id              String             @id
  tenantId        String
  nomorTransfer   String
  outletAsalId    String
  gudangAsalId    String
  outletTujuanId  String
  gudangTujuanId  String
  status          StatusTransferStok @default(DRAF)
  catatan         String?
  dibuatOlehId    String
  disetujuiOlehId String?
  dikirimOlehId   String?
  diterimaOlehId  String?
  diajukanPada    DateTime?
  disetujuiPada   DateTime?
  dikirimPada     DateTime?
  diterimaPada    DateTime?
  createdAt       DateTime           @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  outletAsal   Outlet @relation("TransferStokOutletAsal", fields: [tenantId, outletAsalId], references: [tenantId, id])
  outletTujuan Outlet @relation("TransferStokOutletTujuan", fields: [tenantId, outletTujuanId], references: [tenantId, id])
  // Composite outlet-level (ADR-013 poin 3) - INILAH yang menjamin di level
  // database bahwa gudang asal benar-benar milik outlet asal. Composite
  // (tenantId, gudangId) saja TIDAK memberi jaminan itu pada tenant
  // multi-outlet, dan transfer adalah operasi yang justru menyeberangi outlet.
  gudangAsal   Gudang @relation("TransferStokGudangAsal", fields: [outletAsalId, gudangAsalId], references: [outletId, id])
  gudangTujuan Gudang @relation("TransferStokGudangTujuan", fields: [outletTujuanId, gudangTujuanId], references: [outletId, id])

  dibuatOleh    KeanggotaanTenant  @relation("TransferStokDibuatOleh", fields: [tenantId, dibuatOlehId], references: [tenantId, id])
  disetujuiOleh KeanggotaanTenant? @relation("TransferStokDisetujuiOleh", fields: [tenantId, disetujuiOlehId], references: [tenantId, id])
  dikirimOleh   KeanggotaanTenant? @relation("TransferStokDikirimOleh", fields: [tenantId, dikirimOlehId], references: [tenantId, id])
  diterimaOleh  KeanggotaanTenant? @relation("TransferStokDiterimaOleh", fields: [tenantId, diterimaOlehId], references: [tenantId, id])

  baris TransferStokBaris[]

  @@unique([tenantId, nomorTransfer])
  @@unique([tenantId, id])
  @@map("transfer_stok")
}

// ALT-DEF-008: baris transfer. `jumlahDikirim`/`jumlahDiterima` nullable dan
// TERPISAH dari `jumlahDiminta` - selisih di antara ketiganya adalah SELURUH
// alasan status DITERIMA_SEBAGIAN ada. `mutasiKeluarId`/`mutasiMasukId` adalah
// jejak ledger sepasang: KELUAR ditulis saat DIKIRIM, MASUK saat DITERIMA -
// bukan keduanya sekaligus, karena barang dalam perjalanan bukan saldo gudang
// mana pun.
model TransferStokBaris {
  id             String   @id
  tenantId       String
  transferStokId String
  bahanId        String
  jumlahDiminta  Decimal
  jumlahDikirim  Decimal?
  jumlahDiterima Decimal?
  satuanId       String
  batchStokId    String?
  mutasiKeluarId String?  @unique
  mutasiMasukId  String?  @unique

  transferStok TransferStok @relation(fields: [tenantId, transferStokId], references: [tenantId, id])
  bahan        Bahan        @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  satuan       Satuan       @relation(fields: [tenantId, satuanId], references: [tenantId, id])
  batchStok    BatchStok?   @relation(fields: [tenantId, batchStokId], references: [tenantId, id])
  mutasiKeluar MutasiStok?  @relation("TransferBarisMutasiKeluar", fields: [tenantId, mutasiKeluarId], references: [tenantId, id])
  mutasiMasuk  MutasiStok?  @relation("TransferBarisMutasiMasuk", fields: [tenantId, mutasiMasukId], references: [tenantId, id])

  @@unique([transferStokId, bahanId])
  @@map("transfer_stok_baris")
}

// ALT-DEF-008/ALT-PSD-015: taksonomi alasan waste tenant-scoped. Master data,
// dapat dinonaktifkan tanpa menghapus histori (ADR-006).
model AlasanWaste {
  id       String              @id
  tenantId String
  kode     String
  nama     String
  status   StatusAktifNonaktif @default(AKTIF)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  catatanWaste CatatanWaste[]

  @@unique([tenantId, kode])
  @@unique([tenantId, id])
  @@map("alasan_waste")
}

// ALT-DEF-008/ALT-PSD-014: pencatatan waste/spoilage. `alasanWasteId` WAJIB
// (bukan teks bebas) - itulah bunyi harfiah acceptance ALT-PSD-014.
// `mutasiStokId` WAJIB dan @unique dengan alasan yang sama seperti
// PenyesuaianStok: waste yang tidak menulis ledger berarti barang hilang tanpa
// jejak.
model CatatanWaste {
  id              String   @id
  tenantId        String
  outletId        String
  gudangId        String
  lokasiStokId    String?
  bahanId         String
  batchStokId     String?
  alasanWasteId   String
  jumlah          Decimal
  satuanId        String
  // Nilai kerugian rupiah bulat (ADR-005), nullable - dihitung dari
  // hargaPerolehan batch bila batch diketahui.
  nilaiKerugian   BigInt?
  catatan         String?
  mutasiStokId    String   @unique
  dicatatOlehId   String
  disetujuiOlehId String?
  createdAt       DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  outlet      Outlet      @relation(fields: [tenantId, outletId], references: [tenantId, id])
  gudang      Gudang      @relation(fields: [tenantId, gudangId], references: [tenantId, id])
  lokasiStok  LokasiStok? @relation(fields: [tenantId, lokasiStokId], references: [tenantId, id])
  bahan       Bahan       @relation(fields: [tenantId, bahanId], references: [tenantId, id])
  batchStok   BatchStok?  @relation(fields: [tenantId, batchStokId], references: [tenantId, id])
  alasanWaste AlasanWaste @relation(fields: [tenantId, alasanWasteId], references: [tenantId, id])
  satuan      Satuan      @relation(fields: [tenantId, satuanId], references: [tenantId, id])
  mutasiStok  MutasiStok  @relation(fields: [tenantId, mutasiStokId], references: [tenantId, id])

  dicatatOleh   KeanggotaanOutlet  @relation("CatatanWasteDicatatOleh", fields: [tenantId, outletId, dicatatOlehId], references: [tenantId, outletId, id])
  disetujuiOleh KeanggotaanOutlet? @relation("CatatanWasteDisetujuiOleh", fields: [tenantId, outletId, disetujuiOlehId], references: [tenantId, outletId, id])

  @@unique([tenantId, mutasiStokId])
  @@index([tenantId, bahanId, createdAt])
  @@map("catatan_waste")
}

// ALT-DEF-008/ALT-PSD-018: kebijakan pemesanan ulang PER OUTLET PER BAHAN.
// Decimal (bukan Int seperti `Bahan.stokMinimum` yang lama) - ambang 0.5 kg
// adalah kebutuhan nyata dan tidak bisa diwakili Int (lihat ALT-DEF-036).
model KebijakanPemesananUlang {
  id                   String               @id
  tenantId             String
  outletId             String
  bahanId              String
  stokMinimum          Decimal
  stokMaksimum         Decimal?
  jumlahPemesananUlang Decimal?
  metode               MetodePemesananUlang @default(MIN_MAX)
  status               StatusAktifNonaktif  @default(AKTIF)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  bahan  Bahan  @relation(fields: [tenantId, bahanId], references: [tenantId, id])

  @@unique([outletId, bahanId])
  @@map("kebijakan_pemesanan_ulang")
}

// ALT-DEF-008 (ADR-025 Keputusan 1/2/3): pengaturan persediaan PER OUTLET
// sebagai KOLOM BERTIPE, bukan baris key-value di `PengaturanOutlet`.
// ALASAN penolakan PengaturanOutlet (Json key-value): keempat nilai di bawah
// dibaca di jalur panas SETIAP pemotongan stok dan tiga di antaranya adalah
// enum tertutup. Key-value Json tidak memberi validasi enum, tidak memberi
// default, dan salah ketik kunci akan diam-diam jatuh ke default - mengubah
// perilaku POTONG STOK (konsekuensi finansial) tanpa error apa pun.
// `PengaturanOutlet` tetap dipertahankan untuk pengaturan bebas-bentuk.
model PengaturanPersediaanOutlet {
  id                           String                  @id
  tenantId                     String
  outletId                     String                  @unique
  // ALT-PSD-011 / master spec: kapan stok BENAR-BENAR dipotong dari ledger.
  kebijakanPemotongan          KebijakanPemotonganStok @default(SAAT_MASUK_DAPUR)
  // Reservasi dibuat saat pesanan DITERIMA (ALT-PSD-008).
  reservasiSaatPesananDiterima Boolean                 @default(true)
  kedaluwarsaReservasiMenit    Int?
  // ALT-PSD-011: FEFO default (perishable), FIFO fallback.
  metodeAlokasiBatch           MetodeAlokasiBatch      @default(FEFO)
  // ADR-025 Keputusan 4 (kebijakan stok negatif). Default FALSE = tolak.
  izinkanStokNegatif           Boolean                 @default(false)
  // Ambang selisih opname yang memicu MENUNGGU_PERSETUJUAN (ALT-PSD-017),
  // rupiah bulat (ADR-005). Nullable = seluruh selisih butuh persetujuan.
  ambangSelisihOpname          BigInt?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])

  @@unique([tenantId, outletId])
  @@map("pengaturan_persediaan_outlet")
}

// ALT-DEF-010: gudang direlasi lewat composite-FK (tenantId, gudangId) ->
// Gudang(tenantId, id) - StokOpname tidak punya outletId langsung, jadi
// tenantId adalah kolom bersama yang tersedia untuk komposit ini.
//
// ALT-DEF-008 (ADR-025 Keputusan 5): opname TIDAK PERNAH menyentuh saldo
// secara langsung. Ia memposting mutasi `KOREKSI_OPNAME` per baris, dan
// saldo berubah HANYA sebagai konsekuensi ledger (ADR-023 Keputusan 1).
// `snapshotPada` adalah waktu kuantitas sistem dibekukan - tanpanya,
// "selisih" membandingkan hitungan fisik pukul 22:00 dengan saldo yang sudah
// bergerak sampai pukul 23:00, dan angkanya tidak bermakna.
model StokOpname {
  id              String           @id
  tenantId        String
  gudangId        String
  status          StatusStokOpname @default(DRAF)
  dijadwalkanPada DateTime
  // Waktu kuantitas sistem di-snapshot (transisi DRAF -> SEDANG_DIHITUNG).
  snapshotPada    DateTime?
  dikunciPada     DateTime?
  disetujuiPada   DateTime?
  dipostingPada   DateTime?
  dibatalkanPada  DateTime?
  alasan          String?
  dibuatOlehId    String
  penghitungId    String?
  pengunciId      String?
  penyetujuId     String?

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  gudang     Gudang             @relation(fields: [tenantId, gudangId], references: [tenantId, id])
  dibuatOleh KeanggotaanTenant  @relation("OpnameDibuatOleh", fields: [tenantId, dibuatOlehId], references: [tenantId, id])
  penghitung KeanggotaanTenant? @relation("OpnameDihitungOleh", fields: [tenantId, penghitungId], references: [tenantId, id])
  pengunci   KeanggotaanTenant? @relation("OpnameDikunciOleh", fields: [tenantId, pengunciId], references: [tenantId, id])
  penyetuju  KeanggotaanTenant? @relation("OpnameDisetujuiOleh", fields: [tenantId, penyetujuId], references: [tenantId, id])
  baris      StokOpnameBaris[]

  @@unique([tenantId, id])
  @@map("stok_opname")
}

// ALT-DEF-008: `kuantitasFisik`/`selisih` DIJADIKAN NULLABLE - baris yang
// belum dihitung TIDAK boleh berpura-pura fisiknya 0 (yang membuat selisih
// sebesar seluruh saldo dan memposting koreksi yang menghapus stok nyata).
// `mutasiKoreksiId` adalah jejak ledger baris ini setelah DIPOSTING.
model StokOpnameBaris {
  id              String    @id
  stokOpnameId    String
  bahanId         String
  lokasiStokId    String?
  batchStokId     String?
  // Snapshot saldo sistem pada StokOpname.snapshotPada.
  kuantitasSistem Decimal
  kuantitasFisik  Decimal?
  selisih         Decimal?
  alasan          String?
  mutasiKoreksiId String?   @unique
  dihitungPada    DateTime?

  stokOpname    StokOpname  @relation(fields: [stokOpnameId], references: [id])
  bahan         Bahan       @relation(fields: [bahanId], references: [id])
  lokasiStok    LokasiStok? @relation(fields: [lokasiStokId], references: [id])
  batchStok     BatchStok?  @relation(fields: [batchStokId], references: [id])
  mutasiKoreksi MutasiStok? @relation(fields: [mutasiKoreksiId], references: [id])

  @@unique([stokOpnameId, bahanId, lokasiStokId])
  @@map("stok_opname_baris")
}

// =====================================================================================
// 5. SUPPLIER & PEMBELIAN (docs/database/05-supplier-pembelian.md)
// =====================================================================================

enum StatusPurchaseOrder {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DIKIRIM_SUPPLIER
  DITERIMA_SEBAGIAN
  DITERIMA_PENUH
  DIBATALKAN
}

enum StatusReturPembelian {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  SELESAI
}

model Supplier {
  id       String              @id
  tenantId String
  nama     String
  kontak   String?
  status   StatusAktifNonaktif @default(AKTIF)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder[]

  // ALT-DEF-010: agar PurchaseOrder bisa memakai composite-FK
  // (tenantId, supplierId) -> Supplier(tenantId, id).
  @@unique([tenantId, id])
  @@map("supplier")
}

model PurchaseOrder {
  id            String              @id
  tenantId      String
  outletId      String
  supplierId    String
  nomorPo       String              @unique
  status        StatusPurchaseOrder @default(DRAFT)
  totalEstimasi BigInt              @default(0)
  dibuatOlehId  String
  createdAt     DateTime            @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet     Outlet               @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, supplierId) -> Supplier(tenantId, id) -
  // menjamin PurchaseOrder↔Supplier tidak bisa lintas tenant.
  supplier   Supplier             @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  dibuatOleh KeanggotaanOutlet    @relation("PoDibuatOleh", fields: [tenantId, outletId, dibuatOlehId], references: [tenantId, outletId, id])
  baris      PurchaseOrderBaris[]
  penerimaan PenerimaanBarang[]   @relation("PenerimaanBarangPo")

  // ALT-DEF-010: agar PenerimaanBarang bisa memakai composite-FK
  // (tenantId, purchaseOrderId) -> PurchaseOrder(tenantId, id).
  @@unique([tenantId, id])
  @@map("purchase_order")
}

model PurchaseOrderBaris {
  id              String  @id
  purchaseOrderId String
  bahanId         String
  jumlahDipesan   Decimal
  hargaSatuan     BigInt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  bahan         Bahan         @relation(fields: [bahanId], references: [id])

  @@map("purchase_order_baris")
}

// ALT-DEF-010: sebelumnya tidak punya tenantId sama sekali (gap ditemukan
// saat audit) - purchaseOrderId dan gudangId bisa secara teori merujuk
// tenant yang berbeda tanpa jaminan apa pun. Ditambahkan tenantId
// denormalisasi + DUA composite-FK (pola sama seperti KeanggotaanOutlet/ADR-011).
model PenerimaanBarang {
  id              String   @id
  tenantId        String
  purchaseOrderId String
  gudangId        String
  nomorPenerimaan String   @unique
  diterimaPada    DateTime @default(now())
  diterimaOlehId  String

  purchaseOrder  PurchaseOrder           @relation("PenerimaanBarangPo", fields: [tenantId, purchaseOrderId], references: [tenantId, id])
  gudang         Gudang                  @relation("PenerimaanBarangGudang", fields: [tenantId, gudangId], references: [tenantId, id])
  diterimaOleh   KeanggotaanTenant       @relation("PenerimaanDiterimaOleh", fields: [tenantId, diterimaOlehId], references: [tenantId, id])
  baris          PenerimaanBarangBaris[]
  returPembelian ReturPembelian[]

  @@map("penerimaan_barang")
}

model PenerimaanBarangBaris {
  id                 String  @id
  penerimaanBarangId String
  bahanId            String
  jumlahDiterima     Decimal
  hargaSatuanAktual  BigInt

  penerimaanBarang PenerimaanBarang @relation(fields: [penerimaanBarangId], references: [id])
  bahan            Bahan            @relation(fields: [bahanId], references: [id])

  @@map("penerimaan_barang_baris")
}

model ReturPembelian {
  id                 String               @id
  tenantId           String
  penerimaanBarangId String
  alasan             String
  status             StatusReturPembelian @default(DIAJUKAN)
  createdAt          DateTime             @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  penerimaanBarang PenerimaanBarang @relation(fields: [penerimaanBarangId], references: [id])

  @@map("retur_pembelian")
}

// =====================================================================================
// 6. MEJA & RESERVASI (docs/database/06-meja-reservasi.md)
// =====================================================================================

enum StatusMeja {
  TERSEDIA
  TERPAKAI
  DIPESAN
  PERLU_DIBERSIHKAN
  NONAKTIF
}

enum StatusReservasi {
  DIAJUKAN
  DIKONFIRMASI
  TIBA
  SELESAI
  TIDAK_HADIR
  DIBATALKAN
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
// @@unique([outletId, id]) ditambahkan agar Meja bisa memakai composite FK
// (outletId, areaMejaId) menuju AreaMeja - dipilih memakai outletId (bukan
// tenantId) karena risiko nyata di sini adalah pencampuran AREA/MEJA lintas
// OUTLET dalam tenant yang sama, bukan cuma lintas tenant.
model AreaMeja {
  id       String @id
  tenantId String
  outletId String
  nama     String

  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  meja   Meja[]

  @@unique([outletId, id])
  @@map("area_meja")
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id);
// areaMeja lewat composite-FK (outletId, areaMejaId) -> AreaMeja(outletId, id).
// @@unique([outletId, id]) ditambahkan agar Pesanan/Reservasi/SesiMejaQr bisa
// memakai composite FK (outletId, mejaId) menuju Meja.
model Meja {
  id         String     @id
  tenantId   String
  outletId   String
  areaMejaId String
  nomor      String
  kapasitas  Int
  status     StatusMeja @default(TERSEDIA)

  outlet    Outlet       @relation(fields: [tenantId, outletId], references: [tenantId, id])
  areaMeja  AreaMeja     @relation(fields: [outletId, areaMejaId], references: [outletId, id])
  reservasi Reservasi[]
  pesanan   Pesanan[]
  sesiQr    SesiMejaQr[]

  @@unique([outletId, nomor])
  @@unique([outletId, id])
  @@map("meja")
}

// ALT-DEF-010: DIJUDGE AMAN TANPA composite-FK/tenantId tambahan. SesiMejaQr
// tidak membawa tenantId/outletId sendiri dan hanya punya SATU relasi
// (mejaId -> Meja, yang sekarang sudah tenant/outlet-safe lewat composite FK
// di atas). Tidak ada referensi tenant-owned kedua yang bisa menyimpang dari
// Meja, jadi FK tunggal ke Meja.id sudah cukup - menambah tenantId di sini
// hanya menduplikasi data tanpa jaminan tambahan. Lihat DECISION-LOG.md ADR-013.
model SesiMejaQr {
  id             String    @id
  mejaId         String
  token          String    @unique
  dibuatPada     DateTime  @default(now())
  kadaluarsaPada DateTime
  ditutupPada    DateTime?

  meja Meja @relation(fields: [mejaId], references: [id])

  @@map("sesi_meja_qr")
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id);
// meja (opsional) lewat composite-FK (outletId, mejaId) -> Meja(outletId, id)
// - memakai outletId agar meja yang dirujuk dijamin di outlet yang sama
// dengan reservasi; pelanggan lewat composite-FK (tenantId, pelangganId) ->
// Pelanggan(tenantId, id).
model Reservasi {
  id             String          @id
  tenantId       String
  outletId       String
  mejaId         String?
  pelangganId    String
  jumlahTamu     Int
  waktuReservasi DateTime
  status         StatusReservasi @default(DIAJUKAN)
  createdAt      DateTime        @default(now())

  outlet    Outlet    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  meja      Meja?     @relation(fields: [outletId, mejaId], references: [outletId, id])
  pelanggan Pelanggan @relation(fields: [tenantId, pelangganId], references: [tenantId, id])

  @@map("reservasi")
}

// =====================================================================================
// 7. PESANAN (docs/database/07-pesanan.md)
// =====================================================================================

enum KanalPesanan {
  KASIR
  PELAYAN
  QR_PELANGGAN
}

// ALT-DEF-005: state machine penuh 14-status - menggantikan enum lama 7-status
// (BARU/DIKONFIRMASI/DIPROSES_DAPUR/SIAP_DISAJIKAN/DISAJIKAN/DIBAYAR/
// DIBATALKAN) yang terlalu dangkal untuk alur multi-kanal (kasir/pelayan/QR
// pelanggan). Tabel transisi lengkap (aktor, guard, side-effect, audit event,
// test) ada di docs/arsitektur/STATE-MACHINES.md bagian "Pesanan" - lihat juga
// ADR-017 di docs/engineering/DECISION-LOG.md untuk rasional desain lengkap.
enum StatusPesanan {
  // Draf lokal (belum dikirim) - dipakai kanal QR_PELANGGAN saat pelanggan
  // masih menyusun pesanan, dan opsional untuk KASIR/PELAYAN (auto-skip ke
  // DIKIRIM pada kanal ini, lihat guard di STATE-MACHINES.md).
  DRAF
  // Pesanan sudah dikirim oleh pemesan, menunggu diproses lebih lanjut.
  DIKIRIM
  // Menunggu persetujuan staf (KHUSUS kanal QR_PELANGGAN - lihat guard).
  MENUNGGU_PERSETUJUAN
  DITERIMA
  // Ditolak staf (mis. stok habis/meja salah) - lihat PesananPenolakan.
  DITOLAK
  // Menunggu pembayaran dimuka (guard: kebijakan prepaid tenant aktif).
  MENUNGGU_PEMBAYARAN
  DIKONFIRMASI
  DIKIRIM_KE_DAPUR
  SEDANG_DISIAPKAN
  SIAP
  DISAJIKAN
  SELESAI
  // Terminal - lihat PesananPembatalan untuk alasan+approval. TIDAK bisa
  // dicapai dari SIAP/DISAJIKAN/SELESAI (lihat guard per baris di
  // STATE-MACHINES.md).
  DIBATALKAN
  // HANYA dicapai dari SELESAI (retur setelah lunas) - lihat catatan di
  // STATE-MACHINES.md; model detail PesananRetur adalah scope ALT-PES-018,
  // batch domain kasir berikutnya, BUKAN batch ini.
  DIRETUR
}

// ALT-DEF-005/ALT-DEF-016: diselaraskan ke daftar penuh dari correction spec
// (DRAF/DITERIMA/DIKIRIM_KE_DAPUR/DITAHAN/SEDANG_DISIAPKAN/SIAP/DISAJIKAN/
// DIBATALKAN/DIRETUR) - granularitas ITEM, sengaja terpisah dari
// StatusPesanan (granularitas ORDER); satu pesanan bisa punya item dengan
// status berbeda-beda (mis. satu item DITAHAN sementara item lain sudah
// DIKIRIM_KE_DAPUR).
enum StatusItemPesanan {
  DRAF
  DITERIMA
  DIKIRIM_KE_DAPUR
  // Item ditahan sementara (mis. menunggu konfirmasi stok) tanpa membatalkan
  // seluruh pesanan.
  DITAHAN
  SEDANG_DISIAPKAN
  SIAP
  DISAJIKAN
  DIBATALKAN
  DIRETUR
}

// ALT-PES-010: taksonomi jenis perubahan pesanan pasca-konfirmasi. Dipilih
// sebagai enum (bukan String bebas seperti Izin.domain/PermintaanPersetujuan.
// jenisAksi) karena starter list ini cukup stabil/terbatas untuk kebutuhan
// batch ini - lihat ADR-017 untuk rasional lengkap dan opsi yang
// dipertimbangkan (String bebas vs enum).
enum JenisPerubahanPesanan {
  TAMBAH_ITEM
  UBAH_KUANTITAS
  HAPUS_ITEM
  PINDAH_MEJA
  SPLIT
  MERGE
  LAINNYA
}

model Pesanan {
  id                 String        @id
  tenantId           String
  outletId           String
  mejaId             String?
  pelangganId        String?
  kanal              KanalPesanan
  nomorPesanan       String
  status             StatusPesanan @default(DRAF)
  subtotal           BigInt        @default(0)
  totalDiskon        BigInt        @default(0)
  totalPajak         BigInt        @default(0)
  totalServiceCharge BigInt        @default(0)
  totalAkhir         BigInt        @default(0)
  dibuatOlehId       String
  createdAt          DateTime      @default(now())
  dibatalkanPada     DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet     Outlet            @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (outletId, mejaId) -> Meja(outletId, id) - meja
  // yang dirujuk dijamin berada di outlet yang sama dengan pesanan.
  meja       Meja?             @relation(fields: [outletId, mejaId], references: [outletId, id])
  // ALT-DEF-010: composite-FK (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  pelanggan  Pelanggan?        @relation(fields: [tenantId, pelangganId], references: [tenantId, id])
  dibuatOleh KeanggotaanOutlet @relation("PesananDibuatOleh", fields: [tenantId, outletId, dibuatOlehId], references: [tenantId, outletId, id])

  itemPesanan       ItemPesanan[]
  riwayatStatus     PesananRiwayatStatus[]
  perubahan         PesananPerubahan[]
  penolakan         PesananPenolakan?
  pembatalan        PesananPembatalan?
  // ALT-DEF-014: relasi lama `pembayaran Pembayaran[]` DIHAPUS - Pesanan tidak
  // lagi terhubung langsung ke Pembayaran. Berapa yang sudah dibayar untuk
  // pesanan ini = SUM(alokasiPembayaran.jumlah) atas Pembayaran berstatus
  // DIBAYAR. Lihat ADR-019.
  alokasiPembayaran AlokasiPembayaran[]
  // ALT-DEF-009: relasi diubah dari 1:1 (`PromoPemakaian?`) menjadi 1:N -
  // menghapus @unique pada PromoPemakaian.pesananId berarti satu pesanan
  // kini bisa memakai lebih dari satu promo (stacking). Lihat ADR-026.
  promoPemakaian    PromoPemakaian[]
  // ALT-DEF-006: TiketDapur? (1:1) -> TiketDapur[] (1:N) - satu pesanan dapat
  // menghasilkan banyak tiket dapur (satu per stasiun/gelombang tujuan).
  tiketDapur        TiketDapur[]
  gelombangDapur    GelombangDapur[]
  transaksiKasir    TransaksiKasir[]
  poinRiwayat       PoinRiwayat[]
  // ALT-DEF-039/ALT-DEF-018: model baru domain keanggotaan (ADR-027).
  ledgerStempel     LedgerStempel[]
  ledgerSaldoToko   LedgerSaldoToko[]

  @@unique([outletId, nomorPesanan])
  // ALT-DEF-010: agar TiketDapur/Pembayaran bisa memakai composite-FK
  // (tenantId, pesananId) -> Pesanan(tenantId, id).
  @@unique([tenantId, id])
  @@map("pesanan")
}

// ALT-DEF-016/ALT-PES-006: seluruh kolom `*Snapshot` diisi SEKALI saat item
// ditambahkan ke pesanan dan TIDAK PERNAH diperbarui setelahnya, meskipun
// data master (ItemMenu/VarianMenu/ModifierOpsi/Resep) berubah kemudian -
// menjamin struk/riwayat transaksi lama tidak pernah berubah tampilannya.
// Relasi itemMenuId/varianMenuId/modifierOpsiId TETAP dipertahankan (bukan
// dihapus) untuk keperluan analitik/traceability ke definisi menu terkini,
// tetapi TIDAK PERNAH lagi jadi sumber tampilan histori - lihat ADR-017.
model ItemPesanan {
  id           String            @id
  pesananId    String
  itemMenuId   String
  varianMenuId String?
  kuantitas    Int
  hargaSatuan  BigInt
  catatan      String?
  status       StatusItemPesanan @default(DRAF)

  // --- Snapshot (ALT-DEF-016) ---
  namaItemSnapshot      String
  namaVarianSnapshot    String?
  hargaDasarSnapshot    BigInt
  hargaVarianSnapshot   BigInt  @default(0)
  // Jumlah harga seluruh ItemPesananModifier baris ini pada saat pemesanan -
  // dihitung SEKALI dari sum(ItemPesananModifier.totalSnapshot) saat item
  // dibuat dan disimpan sebagai nilai tetap (bukan dihitung ulang tiap baca),
  // sama seperti *Snapshot lain di model ini - lihat ADR-017 Keputusan 2.
  hargaModifierSnapshot BigInt  @default(0)
  diskonSnapshot        BigInt  @default(0)
  pajakSnapshot         BigInt  @default(0)
  serviceChargeSnapshot BigInt  @default(0)
  totalBarisSnapshot    BigInt
  // ALT-DEF-007 (ADR-022 Keputusan 7): TIDAK LAGI scalar polos. Kolom ini
  // ditambahkan batch ALT-DEF-005/ADR-017 Keputusan 3 sebagai
  // forward-reference tanpa FK karena model `VersiResep` belum ada; batch
  // ALT-DEF-007 membuat model tersebut dan MENYAMBUNG FK-nya di bawah -
  // itulah yang membuat satu baris pesanan permanen menunjuk versi resep
  // PERSIS yang dipakai saat transaksi, sehingga perubahan resep tidak
  // pernah menulis ulang HPP/histori. Tetap nullable: item menu tanpa resep
  // (mis. minuman botol) sah tidak punya versi resep.
  resepVersiId          String?

  pesanan       Pesanan         @relation(fields: [pesananId], references: [id])
  itemMenu      ItemMenu        @relation(fields: [itemMenuId], references: [id])
  varianMenu    VarianMenu?     @relation(fields: [varianMenuId], references: [id])
  // ItemPesanan tidak membawa `tenantId` sendiri (baris di bawah Pesanan,
  // lihat ADR-013) sehingga FK ini ID tunggal, konsisten dengan itemMenu/
  // varianMenu di atas.
  resepVersi    VersiResep?     @relation(fields: [resepVersiId], references: [id])
  // ALT-DEF-008/ALT-PSD-008 (ADR-024 Keputusan 2): reservasi stok digantung
  // pada BARIS pesanan, bukan pada Pesanan - satu baris dibatalkan tidak boleh
  // melepas reservasi baris lain di pesanan yang sama.
  reservasiStok ReservasiStok[]

  modifier            ItemPesananModifier[]
  tiketDapurBaris     TiketDapurBaris?
  PromoPemakaianBaris PromoPemakaianBaris[]

  @@map("item_pesanan")
}

// ALT-DEF-016/ALT-PES-007: modifierOpsiId TETAP dipertahankan untuk
// traceability ke definisi modifier terkini, tetapi kolom `*Snapshot` di
// bawah adalah SUMBER KEBENARAN untuk apa yang benar-benar ditampilkan di
// bill historis - lihat catatan sama pada ItemPesanan di atas.
model ItemPesananModifier {
  id             String @id
  itemPesananId  String
  modifierOpsiId String
  hargaTambahan  BigInt

  // --- Snapshot (ALT-DEF-016) ---
  namaModifierSnapshot String
  hargaSnapshot        BigInt
  // Kuantitas modifier ini (mis. "extra cheese x2") - default 1 untuk
  // modifier yang secara alami tidak berulang.
  jumlah               Int    @default(1)
  // hargaSnapshot * jumlah - disimpan tetap (bukan dihitung ulang tiap baca),
  // konsisten dengan pola *Snapshot lain di ItemPesanan.
  totalSnapshot        BigInt

  itemPesanan  ItemPesanan  @relation(fields: [itemPesananId], references: [id])
  modifierOpsi ModifierOpsi @relation(fields: [modifierOpsiId], references: [id])

  @@map("item_pesanan_modifier")
}

// ALT-DEF-005/ALT-PES-009: statusSebelumnya/statusBaru sekarang bertipe enum
// StatusPesanan (BUKAN String bebas seperti sebelumnya) - transisi status
// tidak valid tidak akan bisa ditulis ke riwayat sama sekali (type-safe di
// level Prisma Client/TypeScript), dan query bisa difilter per nilai enum.
// ADR-033 GAP DIKETAHUI (bukan diam-diam dilewati): model ini TIDAK punya
// kolom `tenantId` sendiri (baris riwayat murni di bawah Pesanan, sama
// seperti pengecualian tabel baris/junction ADR-013) sehingga TIDAK bisa
// memakai composite-FK (tenantId, diubahOlehId) -> KeanggotaanTenant tanpa
// menambah kolom tenantId denormalisasi terlebih dulu. `diubahOlehId` TETAP
// menunjuk Pengguna langsung untuk batch ini - dicatat eksplisit sebagai
// scope yang BELUM dikerjakan (bukan dievaluasi dan ditolak), lihat
// DECISION-LOG.md ADR-033 dan INVARIAN-BELUM-DITEGAKKAN.md.
model PesananRiwayatStatus {
  id               String        @id
  pesananId        String
  statusSebelumnya StatusPesanan
  statusBaru       StatusPesanan
  diubahOlehId     String
  createdAt        DateTime      @default(now())

  pesanan    Pesanan  @relation(fields: [pesananId], references: [id])
  diubahOleh Pengguna @relation("RiwayatStatusDiubahOleh", fields: [diubahOlehId], references: [id])

  @@map("pesanan_riwayat_status")
}

// ALT-PES-010: mencatat SETIAP perubahan pesanan pasca-konfirmasi (tambah
// item, ubah kuantitas, pindah meja, split, merge, dsb) sebagai baris BARU
// append-only - TIDAK PERNAH menimpa ItemPesanan/Pesanan secara diam-diam.
// `sebelum`/`sesudah` menyimpan snapshot Json bebas-bentuk dari bagian yang
// berubah (mis. `{ "itemPesananId": "...", "kuantitas": 2 }` untuk
// UBAH_KUANTITAS) - bentuk persis tiap jenisPerubahan didokumentasikan di
// docs/database/07-pesanan.md, bukan dipaksakan jadi kolom terpisah di sini
// karena bentuknya berbeda-beda per jenis.
model PesananPerubahan {
  id             String                @id
  tenantId       String
  pesananId      String
  jenisPerubahan JenisPerubahanPesanan
  sebelum        Json?
  sesudah        Json?
  diubahOlehId   String
  createdAt      DateTime              @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  pesanan    Pesanan           @relation(fields: [pesananId], references: [id])
  diubahOleh KeanggotaanTenant @relation("PesananPerubahanDiubahOleh", fields: [tenantId, diubahOlehId], references: [tenantId, id])

  @@map("pesanan_perubahan")
}

// ALT-PES-010/ADR-017: SATU baris per pesanan (`pesananId @unique`) - BERBEDA
// dari PesananPerubahan (banyak baris, riwayat perubahan apa pun) karena
// penolakan hanya relevan untuk transisi MENUNGGU_PERSETUJUAN -> DITOLAK yang
// terjadi PALING BANYAK SEKALI per "percobaan pengiriman" pesanan yang sama.
// Keputusan retry (lihat ADR-017): pesanan yang DITOLAK BOLEH diedit dan
// dikirim ulang (DITOLAK -> DIKIRIM, lihat StatusPesanan/STATE-MACHINES.md) -
// tetapi ini tetap SATU baris `Pesanan` yang sama (bukan pesanan baru), dan
// pada implementasi nyata setiap pengiriman-ulang yang ditolak LAGI akan
// menimpa/menambah baris penolakan berikutnya. Untuk batch ini (schema-only,
// belum ada service-layer), `pesananId` dibiarkan @unique karena skenario
// "ditolak dua kali berturut-turut" butuh keputusan reset (hapus baris lama
// vs baris baru) yang merupakan pekerjaan service-layer batch fitur
// berikutnya, BUKAN perubahan skema pada batch ini - lihat ADR-017 untuk
// pembahasan penuh trade-off ini.
model PesananPenolakan {
  id            String   @id
  tenantId      String
  pesananId     String   @unique
  alasan        String
  ditolakOlehId String
  createdAt     DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  pesanan     Pesanan           @relation(fields: [pesananId], references: [id])
  ditolakOleh KeanggotaanTenant @relation("PesananPenolakanDitolakOleh", fields: [tenantId, ditolakOlehId], references: [tenantId, id])

  @@map("pesanan_penolakan")
}

// ALT-PES-011/ADR-017: pembatalan SELURUH pesanan (order-level) - BERBEDA
// dari pembatalan SATU item (`ItemPesanan.status = DIBATALKAN`, yang bisa
// terjadi berkali-kali untuk item berbeda dalam satu pesanan yang sama tanpa
// membatalkan pesanan itu sendiri). `pesananId` @unique karena DIBATALKAN
// adalah status TERMINAL pada StatusPesanan (tidak ada transisi keluar dari
// DIBATALKAN, lihat enum StatusPesanan/STATE-MACHINES.md) - satu pesanan
// hanya bisa dibatalkan SATU KALI sepanjang hidupnya.
model PesananPembatalan {
  id               String   @id
  tenantId         String
  pesananId        String   @unique
  alasan           String
  dibatalkanOlehId String
  createdAt        DateTime @default(now())

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  pesanan        Pesanan           @relation(fields: [pesananId], references: [id])
  dibatalkanOleh KeanggotaanTenant @relation("PesananPembatalanDibatalkanOleh", fields: [tenantId, dibatalkanOlehId], references: [tenantId, id])

  @@map("pesanan_pembatalan")
}

// =====================================================================================
// 8. DAPUR / KDS (docs/database/08-dapur.md)
// =====================================================================================

// ALT-DEF-006: 8 status penuh menggantikan 4 status lama
// (MASUK_ANTRIAN/DIPROSES/SIAP/DIAMBIL_PELAYAN) - lihat ADR-018 di
// docs/engineering/DECISION-LOG.md dan tabel transisi di
// docs/arsitektur/STATE-MACHINES.md bagian "Dapur (Tiket Dapur)".
enum StatusTiketDapur {
  BARU
  DITERIMA
  DITAHAN
  SEDANG_DISIAPKAN
  SELESAI_SEBAGIAN
  SIAP
  DISAJIKAN
  DIBATALKAN
}

// ALT-DEF-006/ADR-018 Keputusan 6: TETAP terpisah dari StatusTiketDapur -
// ini adalah status masak PER BARIS ITEM (granularitas lebih halus dan lebih
// sederhana daripada status tiket), bukan status agregat tiket. Satu
// TiketDapur baru SIAP ketika SELURUH TiketDapurBaris-nya SIAP (lihat guard
// transisi SELESAI_SEBAGIAN -> SIAP di STATE-MACHINES.md) - menggabungkan
// keduanya ke satu enum akan memaksa nilai seperti DITAHAN/DIBATALKAN yang
// tidak relevan pada level baris tunggal.
enum StatusMasakBaris {
  MENUNGGU
  DIMASAK
  SIAP
}

// ALT-DEF-006: status MENUNGGU/DIPICU/SELESAI untuk satu gelombang masak
// (lihat model GelombangDapur di bawah).
enum StatusGelombangDapur {
  MENUNGGU
  DIPICU
  SELESAI
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
// @@unique([outletId, id]) ditambahkan agar TiketDapur bisa memakai
// composite FK (outletId, stasiunDapurId) menuju StasiunDapur.
model StasiunDapur {
  id       String @id
  tenantId String
  outletId String
  nama     String

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  outlet             Outlet               @relation(fields: [tenantId, outletId], references: [tenantId, id])
  tiketDapur         TiketDapur[]
  aturanRoutingDapur AturanRoutingDapur[]

  @@unique([outletId, id])
  @@map("stasiun_dapur")
}

// ALT-DEF-006/ALT-DPR-002: aturan lookup yang menentukan item menu/kategori
// menu tertentu diarahkan ke stasiun dapur mana (mis. "Kopi -> Bar", "Nasi ->
// Dapur", "Dessert -> Stasiun Dessert"). Tabel ini HANYA menyimpan aturan -
// pembuatan TiketDapur nyata saat pesanan dikonfirmasi (yang MEMBACA aturan
// ini untuk menentukan stasiun tujuan tiap baris) adalah handler/feature work
// di luar scope batch ini (lihat ADR-018 Keputusan 4 dan bagian "Cakupan yang
// SENGAJA TIDAK dikerjakan").
model AturanRoutingDapur {
  id             String              @id
  tenantId       String
  outletId       String
  // Invariant level-aplikasi (TIDAK bisa dipaksakan Prisma/SQL murni - lihat
  // ADR-018 Keputusan 4): TEPAT SATU dari itemMenuId/kategoriMenuId harus
  // diisi (XOR). itemMenuId diisi -> aturan spesifik satu item menu;
  // kategoriMenuId diisi -> aturan berlaku untuk seluruh item dalam kategori
  // tsb. Validasi XOR ini wajib dilakukan di service-layer sebelum insert.
  itemMenuId     String?
  kategoriMenuId String?
  stasiunDapurId String
  prioritas      Int                 @default(0)
  status         StatusAktifNonaktif @default(AKTIF)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet       Outlet        @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, itemMenuId) -> ItemMenu(tenantId, id) - nullable (lihat invariant XOR di atas).
  itemMenu     ItemMenu?     @relation(fields: [tenantId, itemMenuId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, kategoriMenuId) -> KategoriMenu(tenantId, id) - nullable (lihat invariant XOR di atas).
  kategoriMenu KategoriMenu? @relation(fields: [tenantId, kategoriMenuId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (outletId, stasiunDapurId) -> StasiunDapur(outletId, id).
  stasiunDapur StasiunDapur  @relation(fields: [outletId, stasiunDapurId], references: [outletId, id])

  @@map("aturan_routing_dapur")
}

model TiketDapur {
  id                String           @id
  tenantId          String
  outletId          String
  pesananId         String
  stasiunDapurId    String?
  // ALT-DEF-006: gelombang masak (mis. re-fire untuk repeat course) - lihat
  // GelombangDapur untuk metadata level-gelombang, dan @@unique di bawah untuk
  // batasan "satu tiket per pesanan per stasiun per gelombang".
  nomorGelombang    Int              @default(1)
  status            StatusTiketDapur @default(BARU)
  masukPada         DateTime         @default(now())
  mulaiDiprosesPada DateTime?
  siapPada          DateTime?

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet        Outlet                    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id) -
  // menjamin tiket dapur tidak bisa merujuk pesanan tenant lain meskipun
  // tenantId TiketDapur sendiri dicatat terpisah dari Pesanan. ALT-DEF-006:
  // BUKAN lagi relasi one-to-one - satu Pesanan kini bisa punya banyak
  // TiketDapur (satu per stasiun/gelombang, lihat @@unique di bawah).
  pesanan       Pesanan                   @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (outletId, stasiunDapurId) -> StasiunDapur(outletId, id) -
  // memakai outletId agar stasiun dapur yang dirujuk dijamin di outlet yang
  // sama dengan tiket (lihat juga test isolasi TiketDapur↔StasiunDapur/Outlet).
  stasiunDapur  StasiunDapur?             @relation(fields: [outletId, stasiunDapurId], references: [outletId, id])
  baris         TiketDapurBaris[]
  riwayatStatus RiwayatStatusTiketDapur[]

  // ALT-DEF-006: menggantikan `pesananId @unique` (1:1) lama - satu pesanan
  // dapat menghasilkan banyak tiket, TAPI paling banyak SATU tiket per
  // kombinasi (pesanan, stasiun, gelombang). Lihat ADR-018 Keputusan 1.
  @@unique([pesananId, stasiunDapurId, nomorGelombang])
  @@map("tiket_dapur")
}

// ALT-DEF-006/ADR-018 Keputusan 2: itemPesananId TETAP @unique. Di bawah alur
// routing gelombang-tunggal normal, satu ItemPesanan (satu baris pesanan,
// mis. "1x Cappuccino") pergi ke TEPAT SATU tiket/stasiun - constraint
// komposit baru `[pesananId, stasiunDapurId, nomorGelombang]` ada di
// TiketDapur (level tiket), BUKAN di TiketDapurBaris, karena granularitas
// "banyak gelombang" dimodelkan sebagai banyak TiketDapur (satu per
// gelombang) yang masing-masing punya baris sendiri-sendiri - bukan sebagai
// banyak baris untuk ItemPesanan yang sama dalam SATU tiket. Jika kelak
// re-fire/repeat-course butuh ItemPesanan yang sama muncul di gelombang
// KEDUA, itu akan jadi baris baru di TiketDapurBaris milik TiketDapur
// gelombang-2 yang BERBEDA (bukan baris kedua di tiket gelombang-1 yang
// sama) - sehingga @unique per-ItemPesanan tetap valid SELAMA satu
// ItemPesanan tidak pernah dikirim dua kali ke tiket YANG SAMA. Menghapus
// @unique ini sekarang akan menghilangkan jaring pengaman "item terkirim
// dobel ke tiket yang sama" tanpa ada kebutuhan bisnis konkret yang
// menuntutnya pada batch ini.
model TiketDapurBaris {
  id            String           @id
  tiketDapurId  String
  itemPesananId String           @unique
  statusMasak   StatusMasakBaris @default(MENUNGGU)

  tiketDapur  TiketDapur  @relation(fields: [tiketDapurId], references: [id])
  itemPesanan ItemPesanan @relation(fields: [itemPesananId], references: [id])

  @@map("tiket_dapur_baris")
}

// ALT-DEF-006: riwayat transisi status TiketDapur, mengikuti pola enum-typed
// history yang sama seperti PesananRiwayatStatus (ALT-DEF-005) - TANPA
// String bebas.
model RiwayatStatusTiketDapur {
  id               String           @id
  tenantId         String
  tiketDapurId     String
  statusSebelumnya StatusTiketDapur
  statusBaru       StatusTiketDapur
  diubahOlehId     String?
  createdAt        DateTime         @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  tiketDapur TiketDapur         @relation(fields: [tiketDapurId], references: [id])
  // Nullable - event sistem/timer (mis. auto-hold karena SLA) tidak selalu
  // punya aktor manusia.
  diubahOleh KeanggotaanTenant? @relation("RiwayatStatusTiketDapurDiubahOleh", fields: [tenantId, diubahOlehId], references: [tenantId, id])

  @@map("riwayat_status_tiket_dapur")
}

// ALT-DEF-006/ADR-018 Keputusan 3: dimodelkan sebagai tabel nyata (bukan
// sekadar field `TiketDapur.nomorGelombang`) karena ada metadata level-
// gelombang yang tidak dimiliki satu TiketDapur individual: kapan gelombang
// ini secara eksplisit "dipicu" (mis. pelayan menekan tombol "kirim course
// kedua sekarang"), siapa yang memicu, dan status agregat gelombang itu
// sendiri (MENUNGGU/DIPICU/SELESAI) yang terpisah dari status
// masing-masing TiketDapur di dalamnya (satu gelombang bisa mencakup banyak
// TiketDapur lintas stasiun sekaligus).
model GelombangDapur {
  id             String               @id
  tenantId       String
  pesananId      String
  nomorGelombang Int
  dipicuPada     DateTime?
  dipicuOlehId   String?
  status         StatusGelombangDapur @default(MENUNGGU)
  createdAt      DateTime             @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan    Pesanan            @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  dipicuOleh KeanggotaanTenant? @relation("GelombangDapurDipicuOleh", fields: [tenantId, dipicuOlehId], references: [tenantId, id])

  @@unique([pesananId, nomorGelombang])
  @@map("gelombang_dapur")
}

// =====================================================================================
// 9. PEMBAYARAN & KASIR (docs/database/09-pembayaran-kasir.md)
// =====================================================================================

enum StatusGiliranKasir {
  DIBUKA
  DITUTUP_MENUNGGU_VERIFIKASI
  DITUTUP_SELESAI
}

enum JenisTransaksiKasir {
  PENJUALAN
  REFUND
  KOREKSI
}

// ALT-DEF-004/ADR-019: scope metode bayar dibatasi PERSIS pada empat nilai di
// bawah. `KARTU_DEBIT`/`KARTU_KREDIT`/`EWALLET` DIHAPUS - ketiganya mengandaikan
// integrasi payment gateway/EDC/e-wallet API yang secara eksplisit DILARANG oleh
// ALT-QRS-010 dan ADR-003 (QRIS mode manual). Nilai `CAMPURAN` SENGAJA TIDAK
// ADA dan tidak boleh ditambahkan: pembayaran campuran dimodelkan sebagai SATU
// `Pembayaran` dengan BEBERAPA baris `PembayaranMetodeBaris` (mis. tunai 50.000
// + QRIS 30.000 = satu Pembayaran, dua baris metode), bukan sebagai "metode"
// tersendiri - lihat ADR-019.
enum KodeMetodeBayar {
  TUNAI
  TRANSFER_MANUAL
  QRIS_MANUAL
  SALDO_TOKO
}

// ALT-DEF-014/ADR-020: state machine pembayaran 9 status. Nilai lama
// `DIKONFIRMASI`/`DIREFUND` diganti `DIBAYAR`/`DIKEMBALIKAN` (+ status baru
// `DRAF`, `MENUNGGU_KONFIRMASI`, `DIKOREKSI`, `DIKEMBALIKAN_SEBAGIAN`).
// `MENUNGGU_KONFIRMASI` adalah status kunci alur QRIS manual: pelanggan menekan
// "Sudah Membayar" -> `MENUNGGU_KONFIRMASI`, dan HANYA kasir yang boleh
// melanjutkannya ke `DIBAYAR` setelah memverifikasi notifikasi merchant. Tabel
// transisi lengkap ada di docs/arsitektur/STATE-MACHINES.md bagian "Pembayaran".
enum StatusPembayaran {
  DRAF
  MENUNGGU
  MENUNGGU_KONFIRMASI
  DIBAYAR
  GAGAL
  DIBATALKAN
  DIKOREKSI
  DIKEMBALIKAN_SEBAGIAN
  DIKEMBALIKAN
}

model GiliranKasir {
  id                 String             @id
  tenantId           String
  outletId           String
  penggunaId         String
  modalAwal          BigInt
  modalAkhirDihitung BigInt?
  modalAkhirSistem   BigInt?
  status             StatusGiliranKasir @default(DIBUKA)
  dibukaPada         DateTime           @default(now())
  ditutupPada        DateTime?

  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet         Outlet            @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ADR-033: kasir yang membuka shift ini divalidasi OUTLET-LEVEL - shift kas
  // adalah operasi fisik di SATU outlet tertentu, jadi harus dijamin bukan
  // cuma anggota tenant tapi juga punya akses ke outlet itu. Sebelumnya FK
  // langsung ke Pengguna (identitas global).
  pengguna       KeanggotaanOutlet @relation("GiliranKasirPengguna", fields: [tenantId, outletId, penggunaId], references: [tenantId, outletId, id])
  transaksiKasir TransaksiKasir[]
  rekapKasHarian RekapKasHarian?

  // ALT-DEF-010: agar RekapKasHarian bisa memakai composite-FK
  // (tenantId, giliranKasirId) -> GiliranKasir(tenantId, id).
  @@unique([tenantId, id])
  @@map("giliran_kasir")
}

model TransaksiKasir {
  id             String              @id
  giliranKasirId String
  pesananId      String
  jenis          JenisTransaksiKasir
  jumlah         BigInt
  createdAt      DateTime            @default(now())

  giliranKasir GiliranKasir @relation(fields: [giliranKasirId], references: [id])
  pesanan      Pesanan      @relation(fields: [pesananId], references: [id])

  @@map("transaksi_kasir")
}

model MetodeBayar {
  id       String              @id
  tenantId String
  kode     KodeMetodeBayar
  nama     String
  status   StatusAktifNonaktif @default(AKTIF)

  tenant Tenant                  @relation(fields: [tenantId], references: [id])
  baris  PembayaranMetodeBaris[]

  // Satu baris katalog per kode metode bayar per tenant - mencegah dua baris
  // "TUNAI" berbeda dalam satu tenant (yang akan membuat agregasi analitik
  // per metode, ALT-ANL-010, ambigu).
  @@unique([tenantId, kode])
  // ALT-DEF-004/ADR-019: diperlukan agar PembayaranMetodeBaris bisa memakai
  // composite-FK (tenantId, metodeBayarId) -> MetodeBayar(tenantId, id).
  @@unique([tenantId, id])
  @@map("metode_bayar")
}

// ALT-DEF-014/ADR-019: `Pembayaran` adalah PERISTIWA PEMBAYARAN itu sendiri -
// sejumlah uang yang diterima dalam satu tindakan kasir - dan TIDAK LAGI terikat
// 1:1 ke satu `Pesanan`. Kolom `pesananId` beserta composite-FK-nya SENGAJA
// DIHAPUS; keterkaitan ke pesanan sekarang selalu lewat `AlokasiPembayaran`.
// Ini yang memungkinkan DUA arah sekaligus:
//   (a) satu pembayaran dialokasikan ke BANYAK pesanan (group/patungan bill),
//   (b) satu pesanan dilunasi oleh BANYAK pembayaran (bayar sebagian/bertahap).
//
// INVARIANT JUMLAH (tidak dapat dipaksakan Prisma/Postgres deklaratif, WAJIB
// divalidasi server-side di DALAM SATU transaksi DB - lihat ADR-019 Keputusan 4):
//   1. SUM(PembayaranMetodeBaris.jumlah WHERE pembayaranId = this.id) == this.jumlah
//   2. SUM(AlokasiPembayaran.jumlah    WHERE pembayaranId = this.id) == this.jumlah
// Invariant (1) adalah "uang ini masuk lewat metode apa saja"; invariant (2)
// adalah "uang ini melunasi tagihan yang mana saja". Keduanya harus benar
// bersamaan dan diuji oleh integration test `pembayaran_invariant_jumlah_*`
// (batch berikutnya - lihat catatan cakupan di ADR-019).
model Pembayaran {
  id                 String           @id
  tenantId           String
  outletId           String
  // Total nilai peristiwa pembayaran ini (rupiah). Menggantikan nama lama
  // `totalDibayar` yang menyiratkan "total tagihan pesanan" - padahal satu
  // Pembayaran kini bisa melunasi sebagian saja, atau beberapa pesanan sekaligus.
  jumlah             BigInt
  // `totalDiterima`/`kembalian` khusus alur TUNAI (uang fisik yang diserahkan
  // pelanggan dan kembaliannya). Untuk QRIS_MANUAL/TRANSFER_MANUAL/SALDO_TOKO
  // nilainya sama dengan `jumlah` dan `kembalian = 0`.
  totalDiterima      BigInt
  kembalian          BigInt           @default(0)
  status             StatusPembayaran @default(DRAF)
  dikonfirmasiOlehId String?
  createdAt          DateTime         @default(now())
  dikonfirmasiPada   DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet           Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  dikonfirmasiOleh KeanggotaanOutlet? @relation("PembayaranDikonfirmasiOleh", fields: [tenantId, outletId, dikonfirmasiOlehId], references: [tenantId, outletId, id])

  alokasi         AlokasiPembayaran[]
  metodeBaris     PembayaranMetodeBaris[]
  koreksi         KoreksiPembayaran[]
  qrisKonfirmasi  QrisKonfirmasiManual?
  struk           Struk?
  refund          PembayaranRefund[]
  // ALT-DEF-018: baris LedgerSaldoToko yang dihasilkan OLEH pembayaran metode
  // SALDO_TOKO ini (lihat LedgerSaldoToko.pembayaranId, ADR-027 Keputusan 3).
  ledgerSaldoToko LedgerSaldoToko[]

  // ALT-DEF-014/ADR-013: diperlukan agar AlokasiPembayaran/KoreksiPembayaran/
  // PembayaranMetodeBaris/QrisKonfirmasiManual/Struk/PembayaranRefund bisa
  // memakai composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  @@unique([tenantId, id])
  @@map("pembayaran")
}

// ALT-DEF-014/ALT-KSR-004/ALT-KSR-005 (BARU): menghubungkan satu peristiwa
// `Pembayaran` ke satu `Pesanan` beserta berapa rupiah dari pembayaran tersebut
// yang diterapkan ke pesanan itu. Inilah model yang membuat split bill (satu
// pembayaran -> banyak pesanan) DAN pembayaran sebagian/bertahap (satu pesanan
// -> banyak pembayaran) mungkin sekaligus, tanpa mengubah bentuk `Pembayaran`.
//
// `@@unique([pembayaranId, pesananId])`: paling banyak SATU baris alokasi per
// pasangan (pembayaran, pesanan). Bila satu pembayaran perlu menambah nilai
// untuk pesanan yang sama, baris yang ada DIPERBARUI (dan dicatat lewat
// `KoreksiPembayaran`), bukan menambah baris kedua - kalau tidak, "berapa yang
// sudah dibayar untuk pesanan X oleh pembayaran Y" jadi pertanyaan agregat yang
// tidak perlu.
model AlokasiPembayaran {
  id           String   @id
  tenantId     String
  pembayaranId String
  pesananId    String
  jumlah       BigInt
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  pembayaran Pembayaran @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  // Menggantikan composite-FK yang dulu ada langsung di `Pembayaran.pesanan`.
  pesanan    Pesanan    @relation(fields: [tenantId, pesananId], references: [tenantId, id])

  @@unique([pembayaranId, pesananId])
  @@map("alokasi_pembayaran")
}

// ALT-DEF-004/ADR-019: mekanisme PEMBAYARAN CAMPURAN. Satu `Pembayaran` dengan
// beberapa baris di sini = pelanggan membayar dengan lebih dari satu metode
// sekaligus (mis. tunai 50.000 + QRIS manual 30.000). Tidak ada enum `CAMPURAN`
// di `KodeMetodeBayar` - "campuran" adalah properti kardinalitas tabel ini,
// bukan sebuah metode bayar.
model PembayaranMetodeBaris {
  id            String @id
  tenantId      String
  pembayaranId  String
  metodeBayarId String
  jumlah        BigInt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK ganda (pola KeanggotaanOutlet) - satu
  // kolom `tenantId` dipakai dua kali agar baris metode tidak mungkin merujuk
  // pembayaran milik tenant A sekaligus katalog metode bayar milik tenant B.
  pembayaran  Pembayaran  @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])
  metodeBayar MetodeBayar @relation(fields: [tenantId, metodeBayarId], references: [tenantId, id])

  @@map("pembayaran_metode_baris")
}

// ALT-DEF-014/ALT-QRS-009 (BARU): koreksi nilai pembayaran yang salah input
// (mis. kasir mengetik 150.000 padahal 15.000, atau salah menandai QRIS lunas).
// Append-only mengikuti ADR-006 (no hard-delete pada data finansial): baris
// `Pembayaran` asli TIDAK ditimpa diam-diam - status pembayaran menjadi
// `DIKOREKSI` dan nilai sebelum/sesudah tercatat di sini.
model KoreksiPembayaran {
  id              String   @id
  tenantId        String
  pembayaranId    String
  alasan          String
  jumlahSebelum   BigInt
  jumlahSesudah   BigInt
  dikoreksiOlehId String
  createdAt       DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  pembayaran    Pembayaran        @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])
  dikoreksiOleh KeanggotaanTenant @relation("KoreksiPembayaranDikoreksiOleh", fields: [tenantId, dikoreksiOlehId], references: [tenantId, id])

  @@map("koreksi_pembayaran")
}

// ALT-QRS-007: bukti verifikasi manual kasir atas pembayaran QRIS. Baris ini
// HANYA boleh ditulis oleh kasir/supervisor (izin
// `pembayaran.qris.konfirmasi-manual`) - tindakan pelanggan menekan tombol
// "Sudah Membayar" TIDAK pernah menulis baris ini dan TIDAK pernah menghasilkan
// status `DIBAYAR` (ADR-021 Keputusan 4).
model QrisKonfirmasiManual {
  id                 String   @id
  tenantId           String
  pembayaranId       String   @unique
  catatanKasir       String?
  diverifikasiOlehId String
  diverifikasiPada   DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  pembayaran       Pembayaran        @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])
  diverifikasiOleh KeanggotaanTenant @relation("QrisDiverifikasiOleh", fields: [tenantId, diverifikasiOlehId], references: [tenantId, id])

  // Diperlukan agar composite-FK di atas valid sebagai relasi one-to-one
  // (pembayaranId sudah @unique tunggal di atas) - pola yang sama dipakai
  // RekapKasHarian.giliranKasir.
  @@unique([tenantId, pembayaranId])
  @@map("qris_konfirmasi_manual")
}

// ALT-KSR-008/ALT-KSR-009: struk adalah bukti untuk SATU PERISTIWA PEMBAYARAN,
// bukan untuk satu pesanan. Konsekuensi langsung dari ALT-DEF-014: pada
// pembayaran bertahap satu pesanan dapat memiliki BEBERAPA struk (satu per
// pembayaran), dan pada group bill satu struk dapat mencakup BEBERAPA pesanan
// (isi struk dirender dari `AlokasiPembayaran` pembayaran tsb). Relasi 1:1
// `Struk <-> Pembayaran` tetap benar dan sengaja dipertahankan - lihat ADR-019
// Keputusan 5.
model Struk {
  id               String    @id
  tenantId         String
  pembayaranId     String    @unique
  nomorStruk       String    @unique
  dicetakPada      DateTime?
  jumlahCetakUlang Int       @default(0)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  pembayaran Pembayaran @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])

  @@unique([tenantId, pembayaranId])
  @@map("struk")
}

// ALT-KSR-007: refund manual dengan approval supervisor. Append-only (ADR-006) -
// tidak pernah menghapus/menimpa `Pembayaran` asal. Status pembayaran menjadi
// `DIKEMBALIKAN_SEBAGIAN` bila SUM(refund.jumlah) < Pembayaran.jumlah, dan
// `DIKEMBALIKAN` bila sama dengan Pembayaran.jumlah (invariant level-aplikasi,
// lihat tabel transisi di STATE-MACHINES.md bagian "Pembayaran").
model PembayaranRefund {
  id              String   @id
  tenantId        String
  pembayaranId    String
  jumlah          BigInt
  alasan          String
  disetujuiOlehId String
  createdAt       DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  pembayaran    Pembayaran        @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])
  disetujuiOleh KeanggotaanTenant @relation("RefundDisetujuiOleh", fields: [tenantId, disetujuiOlehId], references: [tenantId, id])

  @@map("pembayaran_refund")
}

// =====================================================================================
// 9b. KONFIGURASI QRIS MANUAL (ALT-DEF-015, docs/database/16-qris.md)
//
// TIDAK ADA webhook, payment gateway, bank API, e-wallet API, atau konfirmasi
// otomatis apa pun di seluruh bagian ini - dilarang eksplisit oleh ALT-QRS-010
// dan ADR-003/ADR-021. Yang disimpan hanyalah payload QRIS STATIS resmi milik
// outlet (didapat dari bank/PJSP di luar sistem ini). Nominal tagihan disisipkan
// ke payload tersebut SAAT RUNTIME oleh server (ALT-QRS-006) dan dihitung
// SERVER-SIDE dari total pesanan - klien TIDAK PERNAH mengirimkan nominal final.
// =====================================================================================

enum StatusKonfigurasiQris {
  DRAF
  MENUNGGU_VERIFIKASI
  AKTIF
  NONAKTIF
}

enum AksiKonfigurasiQris {
  DIBUAT
  DIUBAH
  DIAKTIFKAN
  DINONAKTIFKAN
  DIVERIFIKASI
}

// ALT-QRS-001 s.d. ALT-QRS-005 / ALT-SEC-007 (BARU).
//
// ENKRIPSI (ADR-021 Keputusan 2): `payloadTerenkripsi` menyimpan ciphertext
// hasil AES-256-GCM level-aplikasi (nonce + tag + ciphertext, base64) - payload
// EMV mentah TIDAK PERNAH ditulis ke kolom mana pun. Kunci berasal dari
// env/KMS, bukan dari database, sehingga dump database saja tidak cukup untuk
// membacanya (itulah kriteria terima ALT-SEC-007). Postgres/Prisma tidak
// melakukan enkripsi ini secara otomatis - ini murni tanggung jawab layer
// aplikasi sebelum `create`/`update`.
//
// `fingerprint` adalah SHA-256 atas payload PLAINTEXT (bukan atas ciphertext -
// ciphertext berubah setiap enkripsi karena nonce acak, sehingga tidak berguna
// untuk deteksi perubahan). Dipakai untuk mendeteksi "apakah payload yang
// diunggah sama dengan yang sudah tersimpan" tanpa mendekripsi apa pun.
//
// SATU KONFIGURASI AKTIF PER OUTLET (ALT-QRS-001, ADR-021 Keputusan 3):
// constraint ini TIDAK dapat diekspresikan di DSL Prisma - ia butuh PARTIAL
// UNIQUE INDEX Postgres:
//   CREATE UNIQUE INDEX konfigurasi_qris_satu_aktif_per_outlet
//     ON konfigurasi_qris (tenant_id, outlet_id) WHERE status = 'AKTIF';
// SQL-nya ada di prisma/migrations/manual/001_konfigurasi_qris_partial_unique.sql
// dan WAJIB dijalankan bersama migrasi pertama. `@@unique([tenantId, outletId,
// status])` SENGAJA TIDAK dipakai sebagai pengganti: ia akan melarang outlet
// punya lebih dari satu konfigurasi NONAKTIF (riwayat konfigurasi lama) - itu
// SALAH dan merupakan constraint palsu yang tidak menegakkan aturan sebenarnya.
model KonfigurasiQris {
  id                 String                @id
  tenantId           String
  outletId           String
  payloadTerenkripsi String
  fingerprint        String
  namaMerchant       String
  kotaMerchant       String
  status             StatusKonfigurasiQris @default(DRAF)
  dibuatOlehId       String
  diverifikasiOlehId String?
  diverifikasiPada   DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet           Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  dibuatOleh       KeanggotaanOutlet  @relation("KonfigurasiQrisDibuatOleh", fields: [tenantId, outletId, dibuatOlehId], references: [tenantId, outletId, id])
  diverifikasiOleh KeanggotaanOutlet? @relation("KonfigurasiQrisDiverifikasiOleh", fields: [tenantId, outletId, diverifikasiOlehId], references: [tenantId, outletId, id])

  riwayat RiwayatKonfigurasiQris[]

  // Payload yang sama persis tidak boleh didaftarkan dua kali di outlet yang
  // sama (deteksi unggah-ulang tanpa perlu mendekripsi apa pun).
  @@unique([tenantId, outletId, fingerprint])
  // Diperlukan agar RiwayatKonfigurasiQris bisa memakai composite-FK
  // (tenantId, konfigurasiQrisId) -> KonfigurasiQris(tenantId, id).
  @@unique([tenantId, id])
  @@map("konfigurasi_qris")
}

// ALT-QRS-008 (BARU): audit append-only atas setiap perubahan konfigurasi QRIS.
// Ini adalah konfigurasi YANG MENENTUKAN KE REKENING SIAPA UANG PELANGGAN
// MENGALIR - setiap perubahannya wajib dapat ditelusuri (siapa, kapan, dari
// nilai apa ke nilai apa). Baris di sini TIDAK PERNAH diubah/dihapus (ADR-006).
// `sebelum`/`sesudah` menyimpan snapshot metadata (namaMerchant/kotaMerchant/
// status/fingerprint) - TIDAK PERNAH memuat payload QRIS (terenkripsi maupun
// plaintext), agar tabel audit tidak menjadi jalur kebocoran yang melewati
// ALT-SEC-007.
model RiwayatKonfigurasiQris {
  id                String              @id
  tenantId          String
  outletId          String
  konfigurasiQrisId String
  aksi              AksiKonfigurasiQris
  sebelum           Json?
  sesudah           Json?
  dilakukanOlehId   String
  createdAt         DateTime            @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet          Outlet            @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010/ADR-013: composite-FK (tenantId, konfigurasiQrisId) -> KonfigurasiQris(tenantId, id).
  konfigurasiQris KonfigurasiQris   @relation(fields: [tenantId, konfigurasiQrisId], references: [tenantId, id])
  dilakukanOleh   KeanggotaanOutlet @relation("RiwayatKonfigurasiQrisDilakukanOleh", fields: [tenantId, outletId, dilakukanOlehId], references: [tenantId, outletId, id])

  @@map("riwayat_konfigurasi_qris")
}

// =====================================================================================
// 10. PROMO (docs/database/10-promo.md) - ALT-DEF-009/ALT-DEF-030, lihat ADR-026
// =====================================================================================
//
// ALT-DEF-009: model lama hanya punya `Promo`/`PromoAturan`/`Kupon`/
// `PromoPemakaian`, dan `PromoPemakaian.pesananId` dulu `@unique` sehingga
// satu pesanan hanya bisa memakai SATU promo (stacking mustahil). Batch ini
// mendesain ulang domain promo penuh (ADR-026): `PromoKondisi` (rename
// `PromoAturan` - KAPAN promo berlaku), `PromoReward` (BARU - BAGAIMANA
// diskon dihitung, menggantikan `Promo.jenis`), `PromoJadwal` (BARU - jadwal
// hari/jam), `PromoOutlet` (BARU - menutup ALT-DEF-030, cakupan outlet),
// `PromoPemakaian` (header pemakaian, `pesananId` TIDAK LAGI unik),
// `PromoPemakaianBaris` (BARU - rincian per baris diskon, mis. BOGO 2 item),
// `PromoSnapshot` (BARU - salinan definisi promo saat diterapkan),
// `PromoSimulasi` (BARU - dry-run tanpa pesanan nyata).

enum StatusPromo {
  AKTIF
  NONAKTIF
  KADALUARSA
}

// ALT-DEF-009/ADR-026 Keputusan 3: OUTLET_TERTENTU DIHAPUS dari enum ini -
// `PromoOutlet` adalah SATU-SATUNYA mekanisme cakupan outlet (ternormalisasi,
// composite-FK tenant-safe, bisa divalidasi di level data). Menyimpan syarat
// outlet lagi lewat `nilaiSyarat Json` di sini akan menciptakan DUA sumber
// kebenaran yang bisa saling menyimpang - persis pola kesalahan yang sudah
// dikoreksi di domain lain (mis. ALT-DEF-034). HARI_TERTENTU/KANAL_TERTENTU/
// PELANGGAN_ANGGOTA/PELANGGAN_BARU/ULANG_TAHUN ditambahkan karena dijanjikan
// eksplisit oleh MASTER-CHECKLIST.md (ALT-PRM-004, ALT-PRM-006, ALT-PRM-014)
// dan docs/database/10-promo.md sebelum batch ini. HARI_TERTENTU sengaja
// TETAP ada meski `PromoJadwal.hariDalamMinggu` juga membawa hari - lihat
// catatan pada `PromoJadwal` di bawah untuk pembagian tanggung jawab
// keduanya (jadwal = KAPAN dalam minggu/jam promo aktif; kondisi ini dipakai
// untuk syarat lain yang bukan penjadwalan, mis. dikombinasikan dengan
// MIN_BELANJA pada hari tertentu tanpa mengaktifkan/menonaktifkan promo).
enum JenisSyaratPromo {
  MIN_BELANJA
  ITEM_TERTENTU
  KATEGORI_TERTENTU
  JAM_TERTENTU
  HARI_TERTENTU
  KANAL_TERTENTU
  PELANGGAN_ANGGOTA
  PELANGGAN_BARU
  ULANG_TAHUN
}

enum StatusKupon {
  AKTIF
  NONAKTIF
  HABIS
}

// ALT-DEF-009/ADR-026 Keputusan 1: menggantikan `Promo.bisaDigabung Boolean`.
// Boolean lama hanya bisa menjawab ya/tidak, tidak bisa menjawab "digabung
// dengan promo mana" (conflictGroup) atau "kalau digabung, promo mana yang
// menang" (prioritas/AMBIL_DISKON_TERBAIK). Lihat ADR-026 untuk algoritma
// resolusi konflik lengkap.
enum StackingPolicyPromo {
  TIDAK_BOLEH_DIGABUNG
  BOLEH_DIGABUNG
  AMBIL_DISKON_TERBAIK
  BERDASARKAN_PRIORITAS
}

// ALT-DEF-009/ADR-026 Keputusan 2: menggantikan `Promo.jenis JenisPromo`.
// `Promo.jenis` lama mencampur "apa promo ini" (identitas) dengan "bagaimana
// diskonnya dihitung" (reward) dalam satu enum tunggal, dan hanya
// mengizinkan SATU jenis reward per promo. `PromoReward` memisahkan
// keduanya: `Promo` kini murni definisi "kapan/untuk siapa" (kondisi +
// jadwal + outlet + stacking), dan satu promo boleh punya SATU ATAU LEBIH
// baris `PromoReward` (mis. promo ulang tahun yang sekaligus memberi diskon
// persen DAN satu item gratis).
enum JenisRewardPromo {
  DISKON_PERSEN
  DISKON_NOMINAL
  ITEM_GRATIS
  HARGA_PAKET
  BELI_X_BAYAR_Y
}

enum StatusPemakaianPromo {
  DITERAPKAN
  DIBATALKAN
  DIRETUR
}

// ALT-DEF-010/ADR-013 (regresi dijaga): relasi `Promo.tenant` tetap FK
// tunggal ke Tenant - itu SUDAH aman tanpa composite-FK karena Tenant.id
// ADALAH identitas tenant itu sendiri.
// ALT-DEF-030 DITUTUP oleh batch ini: `PromoOutlet` di bawah menutup gap
// "Promo tidak punya relasi outlet sama sekali" - lihat model PromoOutlet.
model Promo {
  id                    String              @id
  tenantId              String
  nama                  String
  berlakuSejak          DateTime
  berlakuSampai         DateTime
  status                StatusPromo         @default(AKTIF)
  // ALT-DEF-009/ADR-026 Keputusan 1.
  stackingPolicy        StackingPolicyPromo @default(TIDAK_BOLEH_DIGABUNG)
  // Hanya bermakna ketika stackingPolicy != TIDAK_BOLEH_DIGABUNG - promo yang
  // BERBEDA tapi berbagi conflictGroup yang sama tetap saling eksklusif
  // (mis. "diskon-persen-member" dan "diskon-persen-newuser" boleh sama-sama
  // BOLEH_DIGABUNG dengan promo lain, tapi tidak boleh digabung SATU SAMA
  // LAIN karena keduanya ada di grup "diskon-dasar"). null = tidak ikut grup
  // konflik apa pun (hanya dibatasi stackingPolicy-nya sendiri).
  conflictGroup         String?
  // Tie-breaker BERDASARKAN_PRIORITAS - angka lebih tinggi dievaluasi/menang
  // lebih dulu (ALT-PRM-007).
  prioritas             Int                 @default(0)
  // Batas potongan dalam rupiah walau hasil hitung reward lebih besar (mis.
  // DISKON_PERSEN 50% tanpa batas bisa menghabiskan subtotal - maximumDiscount
  // memotongnya). null = tidak ada batas.
  maximumDiscount       BigInt?
  // Kuota total pemakaian LINTAS SEMUA pelanggan (ALT-PRM-013). null = tak
  // terbatas.
  usageQuota            Int?
  // Batas pemakaian per pelanggan (ALT-PRM-014). null = tak terbatas.
  usageLimitPerCustomer Int?
  // Batas berapa kali promo YANG SAMA boleh diterapkan pada SATU pesanan.
  // Default 1 (perilaku lama, satu penerapan). Bila `repeatable = true`,
  // batas ini adalah PAGU ATAS jumlah repeat (bukan penyebab repeat itu
  // sendiri) - lihat catatan pada PromoPemakaian di bawah untuk keputusan
  // constraint terkait.
  usageLimitPerOrder    Int?                @default(1)
  // ALT-PRM-010: bisakah promo YANG SAMA berlaku berkali-kali dalam SATU
  // pesanan (mis. "tiap kelipatan 2 kopi, 1 gratis" pada pesanan 6 kopi =
  // berlaku 3x). false = perilaku lama (paling banyak satu kali per pesanan).
  repeatable            Boolean             @default(false)
  createdAt             DateTime            @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  kondisi   PromoKondisi[]
  reward    PromoReward[]
  jadwal    PromoJadwal[]
  outlet    PromoOutlet[]
  kupon     Kupon[]
  pemakaian PromoPemakaian[]
  simulasi  PromoSimulasi[]

  // ALT-DEF-009: dibutuhkan agar PromoReward/PromoJadwal/PromoOutlet/
  // PromoPemakaian bisa memakai composite-FK (tenantId, promoId) ->
  // Promo(tenantId, id) mengikuti pola ADR-013.
  @@unique([tenantId, id])
  @@map("promo")
}

// ALT-DEF-009/ADR-026 Keputusan 4: rename bersih dari `PromoAturan` ->
// `PromoKondisi` (tidak ada kode lain yang bergantung pada nama lama,
// diverifikasi lewat grep sebelum rename). Bentuk `jenisSyarat`+`nilaiSyarat
// Json` DIPERTAHANKAN apa adanya (tidak diformalkan lebih jauh) - cukup
// fleksibel untuk syarat heterogen (angka min belanja, daftar id item/
// kategori, rentang jam) tanpa perlu satu kolom nullable per jenis syarat
// yang kebanyakan akan NULL. Trade-off yang disadari: tidak ada validasi
// bentuk `nilaiSyarat` di level database, hanya di app-level - sama seperti
// keterbatasan Prisma/Postgres lain yang dicatat di DECISION-LOG.md.
// TIDAK membawa `tenantId` sendiri - baris murni di bawah Promo, tidak ada
// jalur akses independen, konsisten dengan keputusan ADR-013 untuk tabel
// baris/junction (lihat "Model yang DIJUDGE AMAN tanpa composite-FK").
model PromoKondisi {
  id          String           @id
  promoId     String
  jenisSyarat JenisSyaratPromo
  nilaiSyarat Json

  promo Promo @relation(fields: [promoId], references: [id])

  @@map("promo_kondisi")
}

// ALT-DEF-009/ADR-026 Keputusan 2: BARU. Satu promo boleh punya lebih dari
// satu baris reward (mis. promo ulang tahun = DISKON_PERSEN 10% + satu
// ITEM_GRATIS) - reward-stacking DI DALAM satu promo berbeda dari
// promo-stacking ANTAR promo (yang diatur `stackingPolicy`/`conflictGroup`
// di `Promo`). Kolom reward-spesifik sengaja semuanya nullable pada satu
// tabel lebar (bukan tabel per jenis reward) - pola yang sama seperti
// `PromoKondisi.nilaiSyarat`, dipilih karena jumlah kombinasi kolom yang
// benar-benar dipakai bersamaan kecil dan tabel per-jenis akan memaksa JOIN
// bercabang di setiap query evaluasi promo.
model PromoReward {
  id       String           @id
  tenantId String
  promoId  String
  jenis    JenisRewardPromo

  // --- DISKON_PERSEN ---
  nilaiPersen         Decimal?
  // --- DISKON_NOMINAL ---
  nilaiNominal        BigInt?
  // --- ITEM_GRATIS / BELI_X_BAYAR_Y (target hadiah) ---
  itemGratisId        String?
  jumlahGratis        Int?
  // --- HARGA_PAKET ---
  hargaPaket          BigInt?
  // --- BELI_X_BAYAR_Y ---
  syaratJumlahBeliX   Int?
  bayarJumlahY        Int?
  // Berlaku kelipatan (mis. beli 6 = 3x lipat "beli 2 gratis 1") - dipakai
  // bersama `Promo.repeatable` untuk BOGO berulang (ALT-PRM-010): kolom ini
  // adalah IZIN pada level reward, `Promo.repeatable` adalah SAKLAR pada
  // level promo yang benar-benar mengizinkan pengulangan pada satu pesanan.
  berlakuKelipatan    Boolean  @default(false)
  // Apakah harga modifier (mis. extra cheese) ikut digratiskan saat item
  // dasarnya digratiskan (ALT-PRM-012).
  modifierIkutGratis  Boolean  @default(false)
  // Batas berapa baris hadiah yang boleh dihasilkan reward ini per pesanan -
  // beda dari `Promo.usageLimitPerOrder` (itu membatasi berapa kali PROMO
  // diterapkan; ini membatasi berapa BARIS HADIAH satu reward boleh
  // menghasilkan, relevan ketika satu reward memberi >1 item per aktivasi).
  batasHadiahPerOrder Int?

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoId) -> Promo(tenantId, id).
  promo      Promo     @relation(fields: [tenantId, promoId], references: [tenantId, id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, itemGratisId) -> ItemMenu(tenantId, id).
  // Nullable - hanya bermakna untuk jenis ITEM_GRATIS/BELI_X_BAYAR_Y.
  itemGratis ItemMenu? @relation(fields: [tenantId, itemGratisId], references: [tenantId, id])

  @@map("promo_reward")
}

// ALT-DEF-009: BARU - penjadwalan hari/jam, TERPISAH dari
// `berlakuSejak`/`berlakuSampai` milik `Promo` (itu rentang TANGGAL promo
// hidup sama sekali, mis. "1-31 Juli 2026"; PromoJadwal adalah jendela
// BERULANG di dalam rentang itu, mis. "Senin-Jumat jam 14:00-17:00" untuk
// happy hour, ALT-PRM-004). `jamMulai`/`jamSelesai` memakai `String` (bukan
// `DateTime`) mengikuti presisi yang SAMA dengan `JadwalShift.jamMulai`/
// `jamSelesai` yang sudah ada di domain HR (lihat model JadwalShift) - pola
// itu sendiri sudah dicatat sebagai keterbatasan/defect-era (ALT-DEF-018)
// tapi PERBAIKANNYA di luar scope batch domain promo ini; konsistensi
// dengan precedent yang ada lebih penting daripada memperkenalkan pola
// waktu KETIGA yang berbeda ke skema.
model PromoJadwal {
  id              String @id
  tenantId        String
  promoId         String
  // Hari dalam minggu (0 = Minggu .. 6 = Sabtu), Postgres native array
  // (Prisma `Int[]` didukung untuk provider postgresql - diverifikasi lewat
  // `prisma validate`/`prisma generate` sungguhan, lihat RELEASE-EVIDENCE.md).
  // Array KOSONG = berlaku SETIAP hari (konvensi "kosong berarti semua",
  // sama seperti PromoOutlet di bawah) - list scalar Prisma tidak bisa
  // dibuat nullable/opsional, jadi array kosong adalah representasi satu-
  // satunya untuk "tidak ada pembatasan hari".
  hariDalamMinggu Int[]
  jamMulai        String
  jamSelesai      String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoId) -> Promo(tenantId, id).
  promo  Promo  @relation(fields: [tenantId, promoId], references: [tenantId, id])

  @@map("promo_jadwal")
}

// ALT-DEF-009/ALT-DEF-030 (MENUTUP ALT-DEF-030): BARU - satu-satunya
// mekanisme cakupan outlet untuk Promo, menggantikan
// `JenisSyaratPromo.OUTLET_TERTENTU` yang dihapus di atas. KONVENSI PENTING
// ("kosong berarti semua" - jebakan umum, didokumentasikan eksplisit):
// promo TANPA baris PromoOutlet sama sekali berlaku di SEMUA outlet tenant
// tersebut. Menambahkan baris PromoOutlet mempersempit cakupan ke outlet
// yang disebut SAJA. Ini SAMA seperti konvensi `PromoJadwal.hariDalamMinggu`
// kosong = semua hari.
model PromoOutlet {
  id       String @id
  tenantId String
  promoId  String
  outletId String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoId) -> Promo(tenantId, id).
  promo  Promo  @relation(fields: [tenantId, promoId], references: [tenantId, id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, outletId) -> Outlet(tenantId, id) -
  // inilah yang menutup ALT-DEF-030 (outlet yang dirujuk dijamin database
  // milik tenant yang sama dengan Promo).
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])

  @@unique([promoId, outletId])
  @@map("promo_outlet")
}

model Kupon {
  id             String      @id
  tenantId       String
  promoId        String
  kode           String      @unique
  pelangganId    String?
  kuotaPemakaian Int?
  jumlahDipakai  Int         @default(0)
  status         StatusKupon @default(AKTIF)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  promo     Promo            @relation(fields: [promoId], references: [id])
  pelanggan Pelanggan?       @relation(fields: [pelangganId], references: [id])
  pemakaian PromoPemakaian[]

  @@map("kupon")
}

// ALT-DEF-009 (INTI DEFECT): `pesananId` TIDAK LAGI `@unique` - inilah
// perbaikan defect utama batch ini. `PromoPemakaian` sekarang HEADER
// "promo ini diterapkan ke pesanan ini", dengan rincian nilai per baris
// dipindah ke `PromoPemakaianBaris` (satu header bisa punya banyak baris,
// mis. BOGO yang menggratiskan 2 item = 2 baris).
//
// KEPUTUSAN CONSTRAINT (tension repeatable vs unique, didokumentasikan
// eksplisit sesuai instruksi correction-loop): draft awal berencana
// `@@unique([promoId, pesananId])` ("promo yang sama tidak boleh dipakai
// dua kali di pesanan yang sama, KECUALI repeatable=true"). Itu TIDAK BISA
// diekspresikan sebagai constraint database apa pun - baik Prisma `@@unique`
// (statis, tidak bisa bersyarat) MAUPUN partial unique index Postgres biasa
// (predicate index parsial hanya boleh merujuk KOLOM PADA TABEL YANG SAMA,
// bukan JOIN ke `Promo.repeatable` di tabel lain). Ini kategori keterbatasan
// BARU dan lebih dalam daripada precedent XOR/partial-unique di
// `prisma/migrations/manual/002`/`003` (keduanya predicate STATIS dalam satu
// tabel) - satu-satunya cara benar-benar menjaminnya di level database
// adalah TRIGGER, yang di luar scope "SQL manual terdokumentasi" yang sudah
// dipakai batch-batch sebelumnya. Keputusan: TIDAK ada unique constraint DB
// pada (promoId, pesananId) sama sekali; aturan "paling banyak
// usageLimitPerOrder baris PromoPemakaian per (promo, pesanan) kecuali
// repeatable" ditegakkan MURNI di application-level, dan gap ini dicatat
// sebagai ALT-DEF-038 (lihat DEFECT-LEDGER.md) - BUKAN sekadar catatan
// komentar, karena berbeda kategori dari precedent yang sudah pernah
// ditutup dengan SQL manual.
model PromoPemakaian {
  id        String               @id
  tenantId  String
  promoId   String
  kuponId   String?
  pesananId String
  status    StatusPemakaianPromo @default(DITERAPKAN)
  createdAt DateTime             @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoId) -> Promo(tenantId, id).
  promo   Promo   @relation(fields: [tenantId, promoId], references: [tenantId, id])
  kupon   Kupon?  @relation(fields: [kuponId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan Pesanan @relation(fields: [tenantId, pesananId], references: [tenantId, id])

  baris    PromoPemakaianBaris[]
  snapshot PromoSnapshot?

  // Dibutuhkan agar PromoPemakaianBaris/PromoSnapshot bisa memakai
  // composite-FK (tenantId, promoPemakaianId) -> PromoPemakaian(tenantId, id).
  @@unique([tenantId, id])
  // Indeks non-unik (BUKAN constraint) untuk query "promo apa saja yang
  // sudah dipakai di pesanan ini" - lihat catatan keputusan constraint di
  // atas untuk alasan tidak ada @@unique di sini.
  @@index([promoId, pesananId])
  @@map("promo_pemakaian")
}

// ALT-DEF-009: BARU - rincian per baris diskon di bawah satu header
// PromoPemakaian. `itemPesananId` nullable: diskon level-order (mis.
// DISKON_NOMINAL Rp10.000 dari total) tidak menunjuk baris item tertentu;
// diskon level-item (mis. ITEM_GRATIS) menunjuk baris ItemPesanan yang
// digratiskan. BOGO yang menggratiskan 2 item menghasilkan 2 baris di sini
// (satu per item), bukan satu baris dengan kuantitas 2 - membuat retur
// parsial per item bisa mengoreksi promo secara presisi (ALT-PRM-017).
model PromoPemakaianBaris {
  id               String   @id
  tenantId         String
  promoPemakaianId String
  itemPesananId    String?
  nilaiDiskon      BigInt
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoPemakaianId) -> PromoPemakaian(tenantId, id).
  promoPemakaian PromoPemakaian @relation(fields: [tenantId, promoPemakaianId], references: [tenantId, id])
  // ItemPesanan TIDAK membawa tenantId sendiri (baris di bawah Pesanan, lihat
  // ADR-013), jadi FK ini ID tunggal - konsisten dengan pola
  // ItemPesananModifier.itemPesanan di atas.
  itemPesanan    ItemPesanan?   @relation(fields: [itemPesananId], references: [id])

  @@map("promo_pemakaian_baris")
}

// ALT-DEF-009: BARU - salinan definisi promo (kondisi+reward+jadwal) PERSIS
// pada saat diterapkan, prinsip yang sama dengan kolom `*Snapshot` di
// ItemPesanan (ALT-DEF-005/ADR-017 Keputusan 2): perubahan Promo di
// kemudian hari (mis. admin mengedit persentase diskon) TIDAK PERNAH
// menulis ulang histori pesanan lama. `definisiPromo Json` dipilih (bukan
// kolom per field) karena bentuknya harus menampung struktur
// kondisi+reward+jadwal yang bervariasi per jenis promo - membuat kolom
// individual di sini berarti menduplikasi seluruh skema PromoKondisi/
// PromoReward/PromoJadwal sebagai snapshot, yang tidak proporsional.
model PromoSnapshot {
  id               String   @id
  tenantId         String
  promoPemakaianId String   @unique
  definisiPromo    Json
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoPemakaianId) -> PromoPemakaian(tenantId, id).
  // @unique di atas menjamin 1:1 - satu penerapan promo, satu snapshot.
  promoPemakaian PromoPemakaian @relation(fields: [tenantId, promoPemakaianId], references: [tenantId, id])

  @@unique([tenantId, promoPemakaianId])
  @@map("promo_snapshot")
}

// ALT-DEF-009: BARU - dry-run "apa efek promo ini pada keranjang ini" tanpa
// menyentuh pesanan nyata (ALT-PRM-015). SENGAJA TIDAK terhubung ke
// `Pesanan` sama sekali - `inputKeranjang` adalah representasi keranjang
// bebas bentuk (Json), bukan FK ke ItemPesanan, karena simulasi bisa
// terjadi SEBELUM pesanan dibuat sama sekali (mis. kalkulator promo di
// halaman menu publik). `promoId` nullable: simulasi bisa mengevaluasi
// "promo mana saja yang berlaku" (tanpa target promo tertentu) atau
// "apa efek SATU promo spesifik ini" (dengan target).
model PromoSimulasi {
  id                  String   @id
  tenantId            String
  promoId             String?
  inputKeranjang      Json
  hasilSimulasi       Json
  disimulasikanOlehId String
  createdAt           DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-009/ADR-013: composite-FK (tenantId, promoId) -> Promo(tenantId, id), nullable.
  promo             Promo?            @relation(fields: [tenantId, promoId], references: [tenantId, id])
  disimulasikanOleh KeanggotaanTenant @relation("PromoSimulasiDijalankanOleh", fields: [tenantId, disimulasikanOlehId], references: [tenantId, id])

  @@map("promo_simulasi")
}

// =====================================================================================
// 11. PELANGGAN & KEANGGOTAAN (docs/database/11-pelanggan-keanggotaan.md)
// =====================================================================================
//
// ATURAN EMAS (ALT-DEF-018/ALT-DEF-023/ALT-DEF-039, correction-loop batch
// keanggotaan, lihat ADR-027 di DECISION-LOG.md): SELURUH saldo pelanggan
// (poin, stempel, saldo toko) WAJIB bersumber dari ledger append-only
// masing-masing (`PoinRiwayat`, `LedgerStempel`, `LedgerSaldoToko`). Kolom
// `Keanggotaan.poinAktif`/`poinKumulatif` dan `Pelanggan.saldoTokoCache`
// adalah CACHE TERDOKUMENTASI, BUKAN sumber kebenaran - pola identik dengan
// `StokBahan` sebagai cache dari `MutasiStok` (ADR-023/ALT-DEF-008). Bila
// cache dan ledger berbeda, LEDGER YANG BENAR.

enum StatusKeanggotaan {
  AKTIF
  NONAKTIF
}

// ALT-DEF-023/ALT-MBR-003: status Pelanggan setelah merge. DIGABUNGKAN berarti
// profil ini digabung KE profil lain (lihat RiwayatGabungPelanggan) - baris
// TIDAK PERNAH dihapus (no hard-delete, konsisten ADR-006), hanya ditandai
// nonaktif untuk pendaftaran/transaksi BARU; histori Pesanan/Reservasi/ledger
// LAMA yang menunjuk ke profil ini tetap utuh apa adanya (representasi
// historis - lihat ADR-027 Keputusan 4 untuk pendekatan transfer saldo).
enum StatusPelanggan {
  AKTIF
  DIGABUNGKAN
}

enum JenisPoinRiwayat {
  PEROLEHAN
  PENUKARAN
  PENYESUAIAN
  // ALT-DEF-018/ADR-027 Keputusan 2: reversal eksplisit (pola sama dengan
  // MutasiStok/ADR-023) - sebelumnya TIDAK ADA, koreksi hanya bisa lewat
  // PENYESUAIAN generik yang kehilangan jejak "ini pembalik dari baris mana".
  PEMBALIKAN
  KADALUARSA
}

// ALT-DEF-039 (Step 0 audit correction-loop, program stempel/punch-card
// loyalty - ALT-MBR-014 s.d. ALT-MBR-019): jenis baris ledger stempel.
// Dipisah dari `JenisPoinRiwayat` (enum sendiri, BUKAN reuse) karena stempel
// dan poin adalah DUA program loyalitas berbeda dengan siklus hidup berbeda -
// lihat ADR-027 Keputusan 5. Sengaja TIDAK ada nilai KADALUARSA: kebijakan
// produk belum menetapkan aturan kedaluwarsa stempel (beda dengan poin yang
// eksplisit di ALT-MBR-009) - didokumentasikan sebagai keputusan sadar, bukan
// kelalaian, di ADR-027 Keputusan 5.
enum JenisLedgerStempel {
  PEROLEHAN
  PENUKARAN
  PEMBALIKAN
  PENYESUAIAN
}

// ALT-DEF-018/ALT-MBR-011/ALT-MBR-012 (saldo toko/store credit): jenis baris
// ledger saldo toko.
enum JenisLedgerSaldoToko {
  PENAMBAHAN
  PEMAKAIAN
  REFUND
  PENYESUAIAN
  PEMBALIKAN
}

// ALT-DEF-023/ALT-MBR-004 (consent): jenis persetujuan. `WHATSAPP_NOTIFIKASI`
// bersifat ASPIRASIONAL - mencatat *persetujuan* pelanggan untuk kanal
// tersebut sah dimodelkan sekarang (mis. untuk kepatuhan bila kanal ini
// dibangun kelak), tetapi TIDAK berarti kanal pengiriman WhatsApp/SMS
// sungguhan sudah/akan dibangun. Keputusan ALT-DEF-017 bahwa notifikasi
// HANYA in-app/internal TIDAK dibatalkan oleh enum ini - lihat ADR-027
// Keputusan 6.
enum JenisPersetujuanPelanggan {
  PEMASARAN
  DATA_PRIBADI
  WHATSAPP_NOTIFIKASI
}

model Pelanggan {
  id             String          @id
  tenantId       String
  namaLengkap    String
  nomorTelepon   String
  email          String?
  status         StatusPelanggan @default(AKTIF)
  // ALT-DEF-018/ADR-027 Keputusan 3: CACHE terdokumentasi dari
  // SUM(LedgerSaldoToko.jumlah) milik pelanggan ini - BUKAN sumber kebenaran.
  // Saldo toko digantung di Pelanggan (bukan Keanggotaan) karena pelanggan
  // bisa punya saldo toko (mis. dari refund-ke-saldo) TANPA pernah mendaftar
  // program loyalitas/tier - keduanya independen, lihat ADR-027 Keputusan 3.
  saldoTokoCache BigInt          @default(0)
  createdAt      DateTime        @default(now())

  tenant                       Tenant                   @relation(fields: [tenantId], references: [id])
  keanggotaan                  Keanggotaan?
  pesanan                      Pesanan[]
  reservasi                    Reservasi[]
  kupon                        Kupon[]
  ledgerSaldoToko              LedgerSaldoToko[]
  persetujuan                  PersetujuanPelanggan[]
  // ALT-DEF-023: merge - baris tempat pelanggan ini adalah profil PENYINTAS/UTAMA.
  riwayatGabungSebagaiUtama    RiwayatGabungPelanggan[] @relation("RiwayatGabungUtama")
  // ALT-DEF-023: merge - baris tempat pelanggan ini adalah profil yang DIGABUNG (korban).
  // @@unique([pelangganGabunganId]) di RiwayatGabungPelanggan menjamin relasi
  // ini paling banyak SATU baris (satu profil hanya bisa jadi korban sekali).
  riwayatGabungSebagaiGabungan RiwayatGabungPelanggan[] @relation("RiwayatGabungGabungan")

  @@unique([tenantId, nomorTelepon])
  // ALT-DEF-010: agar Pesanan/Reservasi/LedgerSaldoToko/PersetujuanPelanggan/
  // RiwayatGabungPelanggan bisa memakai composite-FK
  // (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  @@unique([tenantId, id])
  @@map("pelanggan")
}

// ALT-DEF-018/ADR-027 Keputusan 1: schema lama bernama `TierMembership`,
// tetapi `MASTER-CHECKLIST.md` (ALT-MBR-005) SUDAH memakai nama
// `TierKeanggotaan` sejak granularisasi checklist awal - schema DIRENAMES di
// batch ini untuk selaras dengan dokumen yang sudah settled (bukan
// sebaliknya). Churn minimal: satu-satunya dependent adalah
// `Keanggotaan.tierKeanggotaanId`, di-rename bersamaan.
model TierKeanggotaan {
  id               String @id
  tenantId         String
  nama             String
  minPoinKumulatif Int    @default(0)
  benefit          Json

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  keanggotaan Keanggotaan[]

  // ALT-DEF-018/ADR-013: agar Keanggotaan bisa memakai composite-FK
  // (tenantId, tierKeanggotaanId) -> TierKeanggotaan(tenantId, id).
  @@unique([tenantId, id])
  @@map("tier_keanggotaan")
}

model Keanggotaan {
  id                String            @id
  // ALT-DEF-018/ADR-013: sebelumnya model ini TIDAK PUNYA `tenantId` sama
  // sekali - gap tenant-safety yang sama seperti ALT-DEF-010 di domain lain.
  // Ditambahkan agar PoinRiwayat/LedgerStempel bisa memakai composite-FK
  // (tenantId, keanggotaanId) -> Keanggotaan(tenantId, id).
  tenantId          String
  pelangganId       String            @unique
  tierKeanggotaanId String
  // ALT-DEF-018/ALT-MBR-008/ADR-027 Keputusan 1: CACHE terdokumentasi dari
  // SUM(PoinRiwayat.jumlah) milik keanggotaan ini - BUKAN sumber kebenaran.
  // Direkonsiliasi berkala oleh job terpisah (internal, di luar scope schema
  // pada batch ini - lihat ALT-MBR-008).
  poinAktif         Int               @default(0)
  // CACHE terdokumentasi dari SUM(PoinRiwayat.jumlah WHERE jenis = PEROLEHAN)
  // sepanjang masa - dipakai HANYA untuk evaluasi kenaikan tier terhadap
  // `TierKeanggotaan.minPoinKumulatif`, BUKAN sumber kebenaran.
  poinKumulatif     Int               @default(0)
  status            StatusKeanggotaan @default(AKTIF)
  bergabungPada     DateTime          @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  pelanggan       Pelanggan       @relation(fields: [tenantId, pelangganId], references: [tenantId, id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, tierKeanggotaanId) -> TierKeanggotaan(tenantId, id).
  tierKeanggotaan TierKeanggotaan @relation(fields: [tenantId, tierKeanggotaanId], references: [tenantId, id])
  poinRiwayat     PoinRiwayat[]
  ledgerStempel   LedgerStempel[]

  // ALT-DEF-018/ADR-013: agar PoinRiwayat/LedgerStempel bisa memakai
  // composite-FK (tenantId, keanggotaanId) -> Keanggotaan(tenantId, id).
  @@unique([tenantId, id])
  // Prisma mensyaratkan sisi 1:1 (Pelanggan.keanggotaan) memakai kolom unik -
  // pelangganId sudah @unique sendiri, tambahan ini hanya memenuhi syarat
  // composite-FK (tenantId, pelangganId) di atas.
  @@unique([tenantId, pelangganId])
  @@map("keanggotaan")
}

// ALT-DEF-018/ALT-MBR-007 (harden `PoinRiwayat` - nama DIPERTAHANKAN, bukan
// di-rename ke `LedgerPoin`, lihat ADR-027 Keputusan 1 untuk rasional
// asimetri penamaan dengan `LedgerStempel`/`LedgerSaldoToko` yang baru):
// ledger append-only poin loyalitas, sumber kebenaran TUNGGAL untuk
// `Keanggotaan.poinAktif`/`poinKumulatif`.
//
// KEJUJURAN YANG WAJIB DINYATAKAN (sama seperti MutasiStok/ADR-023):
// "append-only" TIDAK ditegakkan database pada batch ini - penegak
// sebenarnya (revoke UPDATE/DELETE + trigger penolak) belum ditulis sebagai
// migrasi manual untuk model ini dan, seandainya ditulis, tetap BELUM PERNAH
// DIJALANKAN (ALT-DEF-029, tidak ada Postgres nyata). Sampai saat itu,
// append-only adalah disiplin level-aplikasi semata.
model PoinRiwayat {
  id               String           @id
  // ALT-DEF-018/ADR-013: sebelumnya TIDAK ADA tenantId sama sekali. Ditambah
  // agar composite-FK (tenantId, keanggotaanId)/(tenantId, pesananId) bisa dipakai.
  tenantId         String
  keanggotaanId    String
  pesananId        String?
  jenis            JenisPoinRiwayat
  jumlah           Int
  // ALT-DEF-018/ALT-MBR-009: hanya terisi pada baris PEROLEHAN - tanggal poin
  // tersebut kedaluwarsa jika belum dipakai. Job kedaluwarsa terjadwal
  // (internal, ALT-MBR-009, di luar scope schema) membaca kolom ini untuk
  // menulis baris KADALUARSA baru begitu tanggal ini terlewati.
  kadaluarsaPada   DateTime?
  // ADR-032 (redesain dari ADR-027 Keputusan 2/ALT-DEF-043): pola reversal
  // sama seperti MutasiStok - `membalikMutasiId` di sini ada di baris
  // PEMBALIK, menunjuk MUNDUR ke baris ASAL. @unique = paling banyak SATU
  // baris pembalik per baris asal. Yang ditegakkan trigger
  // `ledger_validasi_pembalik`: tanda jumlah berlawanan, kesamaan tenant/
  // keanggotaanId, larangan rantai pembalik-dari-pembalik, `alasan` wajib.
  membalikMutasiId String?          @unique
  // ADR-032: alasan WAJIB untuk setiap baris (bukan hanya pembalik).
  alasan           String
  // Nullable - baris SISTEM (mis. perolehan poin otomatis saat pesanan
  // selesai) tidak punya aktor manusia.
  dicatatOlehId    String?
  catatan          String?
  createdAt        DateTime         @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, keanggotaanId) -> Keanggotaan(tenantId, id).
  keanggotaan    Keanggotaan        @relation(fields: [tenantId, keanggotaanId], references: [tenantId, id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan        Pesanan?           @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  dicatatOleh    KeanggotaanTenant? @relation("PoinRiwayatDicatatOleh", fields: [tenantId, dicatatOlehId], references: [tenantId, id])
  membalikMutasi PoinRiwayat?       @relation("PoinRiwayatPembalik", fields: [membalikMutasiId], references: [id])
  pembalik       PoinRiwayat?       @relation("PoinRiwayatPembalik")

  @@map("poin_riwayat")
}

// ALT-DEF-039 (Step 0 audit correction-loop, ALT-MBR-018/019): definisi
// hadiah yang bisa ditukar dengan sejumlah stempel. Minimal tapi lengkap -
// sengaja TIDAK memodelkan katalog reward kompleks (voucher/diskon persen),
// hanya "hadiah = item gratis tertentu (opsional) + deskripsi bebas", bentuk
// paling umum untuk kartu stempel. Lihat ADR-027 Keputusan 5.
model HadiahStempel {
  id                      String   @id
  tenantId                String
  jumlahStempelDibutuhkan Int
  deskripsi               String
  // Nullable - hadiah bisa berupa deskripsi bebas (mis. "diskon 10rb") tanpa
  // terikat item menu tertentu; bila terisi, menukar hadiah ini berarti
  // memberi satu unit item ini gratis.
  itemGratisId            String?
  aktif                   Boolean  @default(true)
  createdAt               DateTime @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  // ALT-DEF-039/ADR-013: composite-FK (tenantId, itemGratisId) -> ItemMenu(tenantId, id).
  itemGratis    ItemMenu?       @relation(fields: [tenantId, itemGratisId], references: [tenantId, id])
  ledgerStempel LedgerStempel[]

  // ALT-DEF-039/ADR-013: agar LedgerStempel bisa memakai composite-FK
  // (tenantId, hadiahStempelId) -> HadiahStempel(tenantId, id).
  @@unique([tenantId, id])
  @@map("hadiah_stempel")
}

// ALT-DEF-039 (Step 0 audit correction-loop, ALT-MBR-014 s.d. ALT-MBR-019 -
// program stempel kunjungan/punch-card): ledger append-only stempel, pola
// identik `PoinRiwayat` (perolehan/penukaran/pembalikan/penyesuaian) tetapi
// enum dan model TERPISAH karena stempel dan poin adalah dua program
// loyalitas independen - lihat ADR-027 Keputusan 5.
//
// KEJUJURAN YANG WAJIB DINYATAKAN: sama seperti PoinRiwayat/MutasiStok,
// "append-only" TIDAK ditegakkan database pada batch ini (ALT-DEF-029).
model LedgerStempel {
  id               String             @id
  tenantId         String
  keanggotaanId    String
  jenis            JenisLedgerStempel
  jumlah           Int
  // Terisi bila stempel diperoleh/dibalikkan sehubungan dengan satu pesanan.
  pesananId        String?
  // Terisi HANYA pada baris PENUKARAN - hadiah mana yang diklaim.
  hadiahStempelId  String?
  // ADR-032 (redesain dari ADR-027 Keputusan 5/ALT-DEF-043): pola reversal
  // identik PoinRiwayat/MutasiStok - `membalikMutasiId` di baris PEMBALIK,
  // menunjuk MUNDUR ke baris ASAL.
  membalikMutasiId String?            @unique
  // ADR-032: alasan WAJIB untuk setiap baris (bukan hanya pembalik).
  alasan           String
  // Nullable - baris SISTEM (mis. perolehan stempel otomatis saat pesanan
  // selesai) tidak punya aktor manusia.
  dicatatOlehId    String?
  catatan          String?
  createdAt        DateTime           @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-039/ADR-013: composite-FK (tenantId, keanggotaanId) -> Keanggotaan(tenantId, id).
  keanggotaan    Keanggotaan        @relation(fields: [tenantId, keanggotaanId], references: [tenantId, id])
  // ALT-DEF-039/ADR-013: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan        Pesanan?           @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  // ALT-DEF-039/ADR-013: composite-FK (tenantId, hadiahStempelId) -> HadiahStempel(tenantId, id).
  hadiahStempel  HadiahStempel?     @relation(fields: [tenantId, hadiahStempelId], references: [tenantId, id])
  dicatatOleh    KeanggotaanTenant? @relation("LedgerStempelDicatatOleh", fields: [tenantId, dicatatOlehId], references: [tenantId, id])
  membalikMutasi LedgerStempel?     @relation("LedgerStempelPembalik", fields: [membalikMutasiId], references: [id])
  pembalik       LedgerStempel?     @relation("LedgerStempelPembalik")

  @@map("ledger_stempel")
}

// ALT-DEF-018/ALT-MBR-011/ALT-MBR-012 (saldo toko/store credit - BARU): ledger
// append-only saldo toko, pola identik PoinRiwayat/LedgerStempel. Digantung
// LANGSUNG ke Pelanggan (BUKAN Keanggotaan) - lihat ADR-027 Keputusan 3 untuk
// rasional lengkap: pelanggan bisa punya saldo toko (mis. dari
// refund-ke-saldo) tanpa pernah menjadi anggota program loyalitas/tier sama
// sekali, sehingga mensyaratkan Keanggotaan sebagai prasyarat akan menolak
// kasus pakai yang sah.
//
// KEJUJURAN YANG WAJIB DINYATAKAN: sama seperti ledger lain, "append-only"
// TIDAK ditegakkan database pada batch ini (ALT-DEF-029).
model LedgerSaldoToko {
  id               String               @id
  tenantId         String
  pelangganId      String
  jenis            JenisLedgerSaldoToko
  // Rupiah bulat (ADR-005) - positif = saldo bertambah, negatif = berkurang.
  jumlah           BigInt
  // Terisi bila saldo dipakai/ditambah sehubungan dengan satu pesanan.
  pesananId        String?
  // Terisi bila baris ini dihasilkan OLEH satu peristiwa `Pembayaran` metode
  // SALDO_TOKO (lihat `PembayaranMetodeBaris`/`KodeMetodeBayar`) - menutup
  // jalur "bayar pakai saldo toko" ke ledgernya sendiri. Nullable karena
  // banyak baris (mis. PENAMBAHAN dari refund, PENYESUAIAN manual) sama
  // sekali tidak berasal dari sebuah Pembayaran.
  pembayaranId     String?
  // ADR-032 (redesain dari ADR-027 Keputusan 2/ALT-DEF-043): pola reversal
  // identik PoinRiwayat/LedgerStempel/MutasiStok - `membalikMutasiId` di
  // baris PEMBALIK, menunjuk MUNDUR ke baris ASAL.
  membalikMutasiId String?              @unique
  // ADR-032: alasan WAJIB untuk setiap baris (bukan hanya pembalik).
  alasan           String
  dicatatOlehId    String?
  catatan          String?
  createdAt        DateTime             @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  pelanggan      Pelanggan          @relation(fields: [tenantId, pelangganId], references: [tenantId, id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan        Pesanan?           @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  // ALT-DEF-018/ADR-013: composite-FK (tenantId, pembayaranId) -> Pembayaran(tenantId, id).
  pembayaran     Pembayaran?        @relation(fields: [tenantId, pembayaranId], references: [tenantId, id])
  dicatatOleh    KeanggotaanTenant? @relation("LedgerSaldoTokoDicatatOleh", fields: [tenantId, dicatatOlehId], references: [tenantId, id])
  membalikMutasi LedgerSaldoToko?   @relation("LedgerSaldoTokoPembalik", fields: [membalikMutasiId], references: [id])
  pembalik       LedgerSaldoToko?   @relation("LedgerSaldoTokoPembalik")

  @@map("ledger_saldo_toko")
}

// ALT-DEF-023/ALT-MBR-004 (consent - BARU): mencatat persetujuan pelanggan
// untuk komunikasi marketing/penyimpanan data. Append-only by convention -
// mencabut consent yang sudah ada TIDAK meng-UPDATE baris lama secara
// destruktif (kolom `dicabutPada` diisi di baris yang SAMA karena consent
// adalah pernyataan status yang berlaku sampai dicabut, bukan peristiwa
// diskrit seperti ledger keuangan - beda pola dari PoinRiwayat/LedgerStempel/
// LedgerSaldoToko dengan sengaja, lihat ADR-027 Keputusan 6). Consent BARU
// (mis. mencabut lalu menyetujui lagi di kemudian hari) selalu menjadi baris
// BARU, bukan menghidupkan kembali baris lama.
model PersetujuanPelanggan {
  id               String                    @id
  tenantId         String
  pelangganId      String
  jenisPersetujuan JenisPersetujuanPelanggan
  disetujui        Boolean
  disetujuiPada    DateTime
  dicabutPada      DateTime?
  createdAt        DateTime                  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  // ALT-DEF-023/ADR-013: composite-FK (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  pelanggan Pelanggan @relation(fields: [tenantId, pelangganId], references: [tenantId, id])

  @@map("persetujuan_pelanggan")
}

// ALT-DEF-023/ALT-MBR-002/ALT-MBR-003 (merge history - BARU): jejak audit
// setiap merge dua profil Pelanggan duplikat. `pelangganGabunganId` (profil
// yang digabung/korban) TIDAK PERNAH dihapus setelah merge - hanya ditandai
// `Pelanggan.status = DIGABUNGKAN` (no hard-delete, ADR-006) agar baris ini
// dan seluruh histori Pesanan/Reservasi/ledger lama milik profil tersebut
// tetap punya referential integrity. Lihat ADR-027 Keputusan 4 untuk
// pendekatan TRANSFER saldo (bukan repointing FK) saat merge terjadi.
model RiwayatGabungPelanggan {
  id                  String   @id
  tenantId            String
  pelangganUtamaId    String
  pelangganGabunganId String
  digabungOlehId      String
  alasan              String?
  createdAt           DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-023/ADR-013: composite-FK (tenantId, pelangganUtamaId) -> Pelanggan(tenantId, id).
  pelangganUtama    Pelanggan         @relation("RiwayatGabungUtama", fields: [tenantId, pelangganUtamaId], references: [tenantId, id])
  // ALT-DEF-023/ADR-013: composite-FK (tenantId, pelangganGabunganId) -> Pelanggan(tenantId, id).
  pelangganGabungan Pelanggan         @relation("RiwayatGabungGabungan", fields: [tenantId, pelangganGabunganId], references: [tenantId, id])
  digabungOleh      KeanggotaanTenant @relation("RiwayatGabungDigabungOleh", fields: [tenantId, digabungOlehId], references: [tenantId, id])

  // Satu profil hanya bisa digabung (jadi korban) SEKALI - setelah digabung,
  // statusnya DIGABUNGKAN permanen (tidak ada un-merge dalam scope batch ini).
  @@unique([pelangganGabunganId])
  @@map("riwayat_gabung_pelanggan")
}

// =====================================================================================
// 12. KARYAWAN & ABSENSI (docs/database/12-karyawan-absensi.md)
// =====================================================================================

// ALT-DEF-019/ALT-DEF-024/ALT-DEF-025 (ADR-028): domain HR/absensi dirombak -
// karyawan multi-outlet (KaryawanOutlet), riwayat jabatan/employment
// terpisah dari identitas karyawan (HubunganKerja, historisasi seperti
// VersiResep), template shift dengan flag lintas-tengah-malam eksplisit,
// dan koreksi absensi sebagai alur approval append-only (KoreksiAbsensi)
// yang TIDAK PERNAH menimpa baris Absensi asli. Lihat ADR-028 di
// DECISION-LOG.md untuk rasional lengkap setiap keputusan di bawah.

enum StatusKaryawan {
  AKTIF
  CUTI
  NONAKTIF
}

// ALT-DEF-019 (ADR-028 Keputusan 1): jabatan kini melekat pada HubunganKerja
// (riwayat employment), bukan langsung pada Karyawan - satu karyawan bisa
// berganti jabatan/departemen dari waktu ke waktu tanpa kehilangan histori,
// sama seperti prinsip versioning VersiResep.
enum TipeHubunganKerja {
  TETAP
  KONTRAK
  PARUH_WAKTU
  MAGANG
}

// ALT-DEF-024 (ADR-028 Keputusan 3): status penjadwalan diperluas dari
// sekadar DIJADWALKAN/DIBATALKAN menjadi siklus konfirmasi/selesai penuh,
// selaras ALT-HR-007.
enum StatusJadwalKerja {
  DIJADWALKAN
  DIKONFIRMASI
  DIBATALKAN
  SELESAI
}

enum StatusPermintaanTukarShift {
  DIAJUKAN
  DISETUJUI_REKAN
  DISETUJUI_MANAJER
  DITOLAK
  DIBATALKAN
}

enum MetodeAbsensi {
  QR
  PIN
  GPS
  MANUAL_SUPERVISOR
}

enum StatusAbsensi {
  TEPAT_WAKTU
  TERLAMBAT
  PULANG_AWAL
  LEMBUR
}

// ALT-DEF-019 (ADR-028 Keputusan 5, crux decision): status alur approval
// koreksi absensi - lihat model KoreksiAbsensi.
enum StatusKoreksiAbsensi {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

enum JenisCutiIzin {
  CUTI_TAHUNAN
  SAKIT
  IZIN
}

enum StatusCutiIzin {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

enum StatusPermintaanLembur {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

model Jabatan {
  id       String @id
  tenantId String

  nama String

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  // ALT-DEF-019: jabatanId pindah dari Karyawan ke HubunganKerja.
  hubunganKerja HubunganKerja[]

  // ALT-DEF-010: agar HubunganKerja bisa memakai composite-FK
  // (tenantId, jabatanId) -> Jabatan(tenantId, id).
  @@unique([tenantId, id])
  @@map("jabatan")
}

// ALT-DEF-019 (ADR-028 Keputusan 1): departemen master data BARU - dipakai
// untuk pengelompokan laporan HR (Dapur/FOH/Gudang/Admin, ALT-HR-004),
// digantung ke HubunganKerja (opsional - tidak semua tenant memakai
// departemen), bukan ke Karyawan langsung, dengan alasan yang sama seperti
// jabatan: departemen adalah properti dari SATU periode employment, bukan
// identitas statis karyawan.
model Departemen {
  id       String @id
  tenantId String

  nama   String
  status StatusAktifNonaktif @default(AKTIF)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  hubunganKerja HubunganKerja[]

  // Agar HubunganKerja bisa memakai composite-FK
  // (tenantId, departemenId) -> Departemen(tenantId, id).
  @@unique([tenantId, id])
  @@map("departemen")
}

model Karyawan {
  id                  String         @id
  tenantId            String
  // ADR-033: sebelumnya penggunaId FK langsung ke Pengguna (identitas global) -
  // tidak ada jaminan bahwa akun login yang ditautkan ke record HR ini benar-
  // benar anggota tenant tempat Karyawan ini bekerja. Sekarang composite-FK ke
  // KeanggotaanTenant(tenantId, id) menjamin itu di level database. Fisik
  // pengguna tetap bisa didapat satu join: karyawan.keanggotaanTenantId ->
  // KeanggotaanTenant.penggunaId -> Pengguna.
  keanggotaanTenantId String?        @unique
  nomorInduk          String         @unique
  status              StatusKaryawan @default(AKTIF)
  tanggalBergabung    DateTime

  tenant                        Tenant                    @relation(fields: [tenantId], references: [id])
  keanggotaanTenant             KeanggotaanTenant?        @relation("KaryawanKeanggotaan", fields: [tenantId, keanggotaanTenantId], references: [tenantId, id])
  // ALT-DEF-019 (ADR-028 Keputusan 2): outletUtamaId DIHAPUS - digantikan
  // KaryawanOutlet many-to-many (isUtama menandai outlet utama). Ini
  // perubahan BREAKING TAPI BENAR, sejalan dengan pola ALT-DEF-001 yang
  // menghapus Pengguna.tenantId demi model keanggotaan - satu sumber
  // kebenaran (KaryawanOutlet), bukan dua yang berpotensi tidak sinkron.
  karyawanOutlet                KaryawanOutlet[]
  // ALT-DEF-019 (ADR-028 Keputusan 1): riwayat jabatan/departemen/tipe
  // hubungan kerja - jabatan AKTIF karyawan didapat lewat query
  // "HubunganKerja terbaru dengan status AKTIF dan berakhirPada null (atau
  // >= sekarang)", BUKAN field statis di Karyawan.
  hubunganKerja                 HubunganKerja[]
  jadwalKerja                   JadwalKerja[]
  polaJadwalBerulang            PolaJadwalBerulang[]
  permintaanTukarShiftPemohon   PermintaanTukarShift[]    @relation("TukarShiftPemohon")
  permintaanTukarShiftPengganti PermintaanTukarShift[]    @relation("TukarShiftPengganti")
  absensi                       Absensi[]
  cutiIzin                      CutiIzin[]
  permintaanLembur              PermintaanLembur[]
  targetKinerja                 TargetKinerja[]
  penilaianKinerja              PenilaianKinerja[]
  rmKinerjaKaryawanHarian       RmKinerjaKaryawanHarian[]

  // ALT-DEF-010: agar Absensi/RmKinerjaKaryawanHarian/dst bisa memakai
  // composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  @@unique([tenantId, id])
  @@map("karyawan")
}

// ALT-DEF-019 (ADR-028 Keputusan 2, NEW - menggantikan Karyawan.outletUtamaId
// tunggal): relasi many-to-many karyawan <-> outlet. `isUtama` tetap
// menandai SATU outlet sebagai default penjadwalan/pelaporan (disiplin
// "paling banyak satu isUtama=true per karyawan" adalah level aplikasi pada
// batch ini, sama seperti disiplin append-only ledger lain - lihat
// ALT-DEF-029 untuk keterbatasan tanpa Postgres nyata).
model KaryawanOutlet {
  id         String @id
  tenantId   String
  karyawanId String
  outletId   String

  isUtama   Boolean             @default(false)
  status    StatusAktifNonaktif @default(AKTIF)
  createdAt DateTime            @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan Karyawan @relation(fields: [tenantId, karyawanId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet   Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id])

  @@unique([karyawanId, outletId])
  @@map("karyawan_outlet")
}

// ALT-DEF-019 (ADR-028 Keputusan 1, NEW): riwayat employment - memisahkan
// "siapa orang ini" (Karyawan) dari "syarat kerja saat ini/lampau"
// (HubunganKerja). "Jabatan aktif" karyawan = HubunganKerja dengan
// status=AKTIF dan (berakhirPada IS NULL OR berakhirPada >= sekarang),
// diurutkan mulaiPada DESC, ambil satu - pola query yang sama seperti
// "versi resep aktif" pada VersiResep.
model HubunganKerja {
  id           String  @id
  tenantId     String
  karyawanId   String
  jabatanId    String
  departemenId String?

  tipeHubungan TipeHubunganKerja
  mulaiPada    DateTime
  berakhirPada DateTime?
  status       StatusAktifNonaktif @default(AKTIF)
  createdAt    DateTime            @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan   Karyawan    @relation(fields: [tenantId, karyawanId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, jabatanId) -> Jabatan(tenantId, id).
  jabatan    Jabatan     @relation(fields: [tenantId, jabatanId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, departemenId) -> Departemen(tenantId, id).
  departemen Departemen? @relation(fields: [tenantId, departemenId], references: [tenantId, id])

  @@map("hubungan_kerja")
}

// ALT-DEF-024 (ADR-028 Keputusan 4): rename JadwalShift -> TemplateShift -
// kini eksplisit menjadi POLA shift yang dipakai ulang (mis. "Shift Pagi
// 07:00-15:00"), bukan penugasan konkret. `jamMulai`/`jamSelesai` TETAP
// String "HH:mm" (bukan `DateTime @db.Time`) - keputusan sadar didokumentasi
// di ADR-028: tidak ada Postgres nyata di environment ini (ALT-DEF-029)
// untuk memvalidasi perilaku `@db.Time` (mis. apakah driver Prisma
// mengembalikannya sebagai Date dengan komponen tanggal epoch yang bisa
// menyesatkan), sementara pola String sudah punya preseden aman di batch
// sebelumnya. `lintasTengahMalam` adalah PERBAIKAN NYATA untuk
// ALT-DEF-024: bila true, aplikasi WAJIB memperlakukan jamSelesai sebagai
// terjadi di TANGGAL BERIKUTNYA saat menghitung durasi/overlap, bukan
// menyimpulkannya dari jamSelesai < jamMulai (yang rapuh terhadap shift
// pas 24 jam atau data salah entri).
model TemplateShift {
  id       String @id
  tenantId String
  outletId String

  nama              String
  jamMulai          String
  jamSelesai        String
  lintasTengahMalam Boolean             @default(false)
  status            StatusAktifNonaktif @default(AKTIF)
  createdAt         DateTime            @default(now())

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet             Outlet               @relation(fields: [tenantId, outletId], references: [tenantId, id])
  jadwalKerja        JadwalKerja[]
  polaJadwalBerulang PolaJadwalBerulang[]

  // Agar JadwalKerja bisa memakai composite-FK
  // (tenantId, templateShiftId) -> TemplateShift(tenantId, id).
  @@unique([tenantId, id])
  @@map("template_shift")
}

// ALT-DEF-024 (ADR-028 Keputusan 5): rename PenugasanShift -> JadwalKerja -
// penugasan KONKRET satu TemplateShift ke satu karyawan pada satu tanggal.
// Jadwal berulang ("jadwal berulang" per master spec) diselesaikan dengan
// PolaJadwalBerulang yang MENGHASILKAN baris JadwalKerja individual (bukan
// recurrence-rule yang dievaluasi lazy) - setiap hari tetap baris sendiri
// yang bisa di-query/edit/batalkan independen (mis. "jadwalku Selasa depan"
// adalah SELECT langsung, bukan evaluasi rule). `polaBerulangId` opsional
// hanya untuk jejak "baris ini dihasilkan oleh pola yang mana", TIDAK
// dipakai untuk logika baca.
model JadwalKerja {
  id              String  @id
  tenantId        String
  outletId        String
  karyawanId      String
  templateShiftId String
  polaBerulangId  String?

  tanggal   DateTime          @db.Date
  status    StatusJadwalKerja @default(DIJADWALKAN)
  createdAt DateTime          @default(now())

  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet               Outlet                 @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan             Karyawan               @relation(fields: [tenantId, karyawanId], references: [tenantId, id])
  // Composite-FK (tenantId, templateShiftId) -> TemplateShift(tenantId, id).
  templateShift        TemplateShift          @relation(fields: [tenantId, templateShiftId], references: [tenantId, id])
  polaBerulang         PolaJadwalBerulang?    @relation(fields: [polaBerulangId], references: [id])
  permintaanTukarShift PermintaanTukarShift[]

  // Agar PermintaanTukarShift bisa memakai composite-FK
  // (tenantId, jadwalKerjaAsalId) -> JadwalKerja(tenantId, id).
  @@unique([tenantId, id])
  @@map("jadwal_kerja")
}

// ALT-DEF-024 (ADR-028 Keputusan 5, NEW): definisi pola jadwal berulang -
// SUMBER yang dipakai job/service-layer untuk MENGHASILKAN (generate) baris
// JadwalKerja individual pada rentang tanggal + hari-dalam-minggu yang
// cocok. Model ini TIDAK pernah dibaca langsung untuk menjawab "jadwal
// karyawan hari X" - itu selalu query JadwalKerja.
model PolaJadwalBerulang {
  id              String @id
  tenantId        String
  outletId        String
  karyawanId      String
  templateShiftId String

  // Hari dalam minggu (0=Minggu .. 6=Sabtu) tempat pola ini berlaku.
  hariDalamMinggu Int[]
  tanggalMulai    DateTime            @db.Date
  tanggalSelesai  DateTime?           @db.Date
  status          StatusAktifNonaktif @default(AKTIF)
  createdAt       DateTime            @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet        Outlet        @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan      Karyawan      @relation(fields: [tenantId, karyawanId], references: [tenantId, id])
  // Composite-FK (tenantId, templateShiftId) -> TemplateShift(tenantId, id).
  templateShift TemplateShift @relation(fields: [tenantId, templateShiftId], references: [tenantId, id])
  jadwalKerja   JadwalKerja[]

  @@map("pola_jadwal_berulang")
}

// ALT-DEF-024 (ADR-028 Keputusan 6, NEW - ALT-HR-008): permintaan tukar
// shift antar karyawan. `jadwalKerjaAsalId` menunjuk baris JadwalKerja yang
// hendak ditukar - jadwal ASAL TIDAK diubah sampai approval selesai
// (DISETUJUI_MANAJER), sejalan catatan checklist ALT-HR-008.
model PermintaanTukarShift {
  id                  String  @id
  tenantId            String
  jadwalKerjaAsalId   String
  karyawanPemohonId   String
  karyawanPenggantiId String?
  disetujuiOlehId     String?

  status    StatusPermintaanTukarShift @default(DIAJUKAN)
  createdAt DateTime                   @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  // Composite-FK (tenantId, jadwalKerjaAsalId) -> JadwalKerja(tenantId, id).
  jadwalKerjaAsal   JadwalKerja        @relation(fields: [tenantId, jadwalKerjaAsalId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanPemohonId) -> Karyawan(tenantId, id).
  karyawanPemohon   Karyawan           @relation("TukarShiftPemohon", fields: [tenantId, karyawanPemohonId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanPenggantiId) -> Karyawan(tenantId, id).
  karyawanPengganti Karyawan?          @relation("TukarShiftPengganti", fields: [tenantId, karyawanPenggantiId], references: [tenantId, id])
  disetujuiOleh     KeanggotaanTenant? @relation("TukarShiftDisetujuiOleh", fields: [tenantId, disetujuiOlehId], references: [tenantId, id])

  @@map("permintaan_tukar_shift")
}

// ALT-DEF-025/ALT-DEF-016/ALT-DEF-017 (ADR-028 Keputusan 7): Absensi.jamMasuk/
// jamPulang TETAP IMMUTABLE - selalu apa yang benar-benar dicatat perangkat
// saat presensi (bukti mentah, tidak pernah ditulis ulang). jamMasukEfektif/
// jamPulangEfektif adalah kolom CACHE eksplisit (sama disiplin "cache,
// bukan sumber kebenaran" seperti Pelanggan.saldoTokoCache, ADR-027) yang
// HANYA di-update oleh service-layer setelah sebuah KoreksiAbsensi
// berstatus DISETUJUI - lihat model KoreksiAbsensi untuk mekanisme lengkap.
// Sebelum ada koreksi yang disetujui, efektif == nilai asli.
// lokasiLat/lokasiLng/jarakDariOutletMeter dan perangkatId (ALT-HR-016/
// ALT-HR-017): dukungan level-skema untuk validasi geofence/pembatasan
// perangkat - logika radius/registrasi perangkat sesungguhnya adalah
// feature work service-layer selanjutnya, di luar cakupan batch ini.
model Absensi {
  id          String  @id
  tenantId    String
  outletId    String
  karyawanId  String
  perangkatId String?

  jamMasuk             DateTime
  jamPulang            DateTime?
  jamMasukEfektif      DateTime?
  jamPulangEfektif     DateTime?
  metode               MetodeAbsensi
  status               StatusAbsensi
  lokasiLat            Decimal?      @db.Decimal(9, 6)
  lokasiLng            Decimal?      @db.Decimal(9, 6)
  jarakDariOutletMeter Decimal?      @db.Decimal(8, 2)

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet           Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan         Karyawan           @relation(fields: [tenantId, karyawanId], references: [tenantId, id])
  // ALT-HR-017: composite-FK (tenantId, perangkatId) -> Perangkat(tenantId, id) - nullable,
  // hanya terisi bila tenant mengaktifkan pembatasan perangkat presensi.
  perangkat        Perangkat?         @relation(fields: [tenantId, perangkatId], references: [tenantId, id])
  koreksiAbsensi   KoreksiAbsensi[]
  istirahatAbsensi IstirahatAbsensi[]

  // ALT-DEF-010/ALT-DEF-019: agar KoreksiAbsensi/IstirahatAbsensi bisa
  // memakai composite-FK (tenantId, absensiId) -> Absensi(tenantId, id).
  @@unique([tenantId, id])
  @@map("absensi")
}

// ALT-DEF-019 (ADR-028 Keputusan 7, CRUX DECISION - ALT-HR-015): koreksi
// absensi sebagai RECORD BARU dengan approval, TIDAK PERNAH menimpa baris
// Absensi asli. Mekanisme lengkap:
//   1. Supervisor/karyawan mengajukan KoreksiAbsensi (status DIAJUKAN),
//      menyalin nilai SEBELUM (jamMasukSebelum/jamPulangSebelum, diambil
//      dari Absensi.jamMasuk/jamPulang ASLI saat pengajuan - snapshot,
//      bukan referensi hidup) dan nilai SESUDAH yang diusulkan
//      (jamMasukSesudah/jamPulangSesudah).
//   2. Approval (disetujuiOlehId + status -> DISETUJUI) memicu service-layer
//      MENULIS jamMasukEfektif/jamPulangEfektif pada baris Absensi asli
//      dengan nilai *Sesudah - Absensi.jamMasuk/jamPulang (nilai ASLI/audit)
//      TIDAK PERNAH disentuh.
//   3. Bila DITOLAK, tidak ada perubahan pada Absensi sama sekali - baris
//      KoreksiAbsensi tetap ada sebagai jejak pengajuan yang ditolak.
// Satu Absensi bisa punya BANYAK baris KoreksiAbsensi (riwayat pengajuan
// berulang bila ditolak lalu diajukan ulang) - relasi one-to-many, bukan
// one-to-one, justru karena append-only.
model KoreksiAbsensi {
  id              String  @id
  tenantId        String
  absensiId       String
  diajukanOlehId  String
  disetujuiOlehId String?

  jamMasukSebelum  DateTime
  jamMasukSesudah  DateTime?
  jamPulangSebelum DateTime?
  jamPulangSesudah DateTime?
  alasan           String
  status           StatusKoreksiAbsensi @default(DIAJUKAN)
  createdAt        DateTime             @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  // Composite-FK (tenantId, absensiId) -> Absensi(tenantId, id).
  absensi       Absensi            @relation(fields: [tenantId, absensiId], references: [tenantId, id])
  diajukanOleh  KeanggotaanTenant  @relation("KoreksiAbsensiDiajukanOleh", fields: [tenantId, diajukanOlehId], references: [tenantId, id])
  disetujuiOleh KeanggotaanTenant? @relation("KoreksiAbsensiDisetujuiOleh", fields: [tenantId, disetujuiOlehId], references: [tenantId, id])

  @@map("koreksi_absensi")
}

// ALT-DEF-025 (ADR-028 Keputusan 8, NEW - ALT-HR-011): pencatatan
// istirahat dalam satu sesi kerja, append-only (banyak baris istirahat per
// Absensi, mis. istirahat makan siang + istirahat sore).
model IstirahatAbsensi {
  id        String @id
  tenantId  String
  absensiId String

  mulaiPada   DateTime
  selesaiPada DateTime?
  jenis       String?
  createdAt   DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  // Composite-FK (tenantId, absensiId) -> Absensi(tenantId, id).
  absensi Absensi @relation(fields: [tenantId, absensiId], references: [tenantId, id])

  @@map("istirahat_absensi")
}

// ALT-DEF-019 (ADR-028 Keputusan 9): CutiIzin DIPERTAHANKAN apa adanya
// secara struktural (bukan rename ke PermintaanCuti) - jenis
// CUTI_TAHUNAN/SAKIT/IZIN sudah memetakan wajar ke "cuti" secara luas per
// master spec, dan checklist (ALT-HR-014) memakai nama CutiIzin. Satu-
// satunya perbaikan nyata di batch ini: menambahkan `tenantId` (SEBELUMNYA
