  karyawan      Karyawan           @relation(fields: [tenantId, karyawanId], references: [tenantId, id])
  disetujuiOleh KeanggotaanTenant? @relation("CutiDisetujuiOleh", fields: [tenantId, disetujuiOlehId], references: [tenantId, id])

