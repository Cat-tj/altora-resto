  absensi                 Absensi[]
  cutiIzin                CutiIzin[]
  rmKinerjaKaryawanHarian RmKinerjaKaryawanHarian[]

  // ALT-DEF-010: agar Absensi/RmKinerjaKaryawanHarian bisa memakai
  // composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  @@unique([tenantId, id])
  @@map("karyawan")
}

