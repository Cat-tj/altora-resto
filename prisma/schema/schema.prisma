// 9. PEMBAYARAN & KASIR (docs/database/09-pembayaran-kasir.md)
// =====================================================================================

enum StatusGiliranKasir {
  DIBUKA
  DITUTUP_MENUNGGU_VERIFIKASI
  DITUTUP_SELESAI
}

enum JenisTransaksiKasir {
  PENJUALAN
  REFUND
  KOREKSI
}

enum KodeMetodeBayar {
  TUNAI
  QRIS_MANUAL
  KARTU_DEBIT
  KARTU_KREDIT
  EWALLET
}

enum StatusPembayaran {
  MENUNGGU
  DIKONFIRMASI
  GAGAL
  DIBATALKAN
  DIREFUND
}

model GiliranKasir {
  id                 String             @id
  tenantId           String
  outletId           String
  penggunaId         String
  modalAwal          Int
  modalAkhirDihitung Int?
  modalAkhirSistem   Int?
  status             StatusGiliranKasir @default(DIBUKA)
  dibukaPada         DateTime           @default(now())
  ditutupPada        DateTime?

  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet         Outlet           @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // pengguna: Pengguna adalah identitas GLOBAL (ALT-DEF-001) - sengaja TIDAK
  // di-composite-kan ke tenant, sama seperti relasi Pengguna lain di seluruh
  // skema ini.
  pengguna       Pengguna         @relation(fields: [penggunaId], references: [id])
  transaksiKasir TransaksiKasir[]
  rekapKasHarian RekapKasHarian?

  // ALT-DEF-010: agar RekapKasHarian bisa memakai composite-FK
  // (tenantId, giliranKasirId) -> GiliranKasir(tenantId, id).
  @@unique([tenantId, id])
  @@map("giliran_kasir")
}

model TransaksiKasir {
  id             String              @id
  giliranKasirId String
  pesananId      String
  jenis          JenisTransaksiKasir
  jumlah         Int
  createdAt      DateTime            @default(now())

  giliranKasir GiliranKasir @relation(fields: [giliranKasirId], references: [id])
  pesanan      Pesanan      @relation(fields: [pesananId], references: [id])

  @@map("transaksi_kasir")
}

model MetodeBayar {
  id       String              @id
  tenantId String
  kode     KodeMetodeBayar
  nama     String
  status   StatusAktifNonaktif @default(AKTIF)

  tenant Tenant                  @relation(fields: [tenantId], references: [id])
  baris  PembayaranMetodeBaris[]

  @@map("metode_bayar")
}

model Pembayaran {
  id                 String           @id
  tenantId           String
  outletId           String
  pesananId          String
  totalDibayar       Int
  totalDiterima      Int
  kembalian          Int              @default(0)
  status             StatusPembayaran @default(MENUNGGU)
  dikonfirmasiOlehId String?
  createdAt          DateTime         @default(now())
  dikonfirmasiPada   DateTime?

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet           Outlet    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan          Pesanan   @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  dikonfirmasiOleh Pengguna? @relation("PembayaranDikonfirmasiOleh", fields: [dikonfirmasiOlehId], references: [id])

  metodeBaris    PembayaranMetodeBaris[]
  qrisKonfirmasi QrisKonfirmasiManual?
  struk          Struk?
  refund         PembayaranRefund[]

  @@map("pembayaran")
}

model PembayaranMetodeBaris {
  id            String @id
  pembayaranId  String
  metodeBayarId String
  jumlah        Int

  pembayaran  Pembayaran  @relation(fields: [pembayaranId], references: [id])
  metodeBayar MetodeBayar @relation(fields: [metodeBayarId], references: [id])

  @@map("pembayaran_metode_baris")
}

model QrisKonfirmasiManual {
  id                 String   @id
  pembayaranId       String   @unique
  catatanKasir       String?
  diverifikasiOlehId String
  diverifikasiPada   DateTime @default(now())

  pembayaran       Pembayaran @relation(fields: [pembayaranId], references: [id])
  diverifikasiOleh Pengguna   @relation("QrisDiverifikasiOleh", fields: [diverifikasiOlehId], references: [id])

  @@map("qris_konfirmasi_manual")
}

model Struk {
  id               String    @id
  pembayaranId     String    @unique
  nomorStruk       String    @unique
  dicetakPada      DateTime?
  jumlahCetakUlang Int       @default(0)

  pembayaran Pembayaran @relation(fields: [pembayaranId], references: [id])

  @@map("struk")
}

model PembayaranRefund {
  id              String   @id
  pembayaranId    String
  jumlah          Int
  alasan          String
  disetujuiOlehId String
  createdAt       DateTime @default(now())

  pembayaran    Pembayaran @relation(fields: [pembayaranId], references: [id])
  disetujuiOleh Pengguna   @relation("RefundDisetujuiOleh", fields: [disetujuiOlehId], references: [id])

  @@map("pembayaran_refund")
}

// =====================================================================================
// 10. PROMO (docs/database/10-promo.md)
// =====================================================================================

enum JenisPromo {
  DISKON_PERSEN
  DISKON_NOMINAL
  BELI_X_GRATIS_Y
  HARGA_PAKET
}

enum StatusPromo {
  AKTIF
  NONAKTIF
  KADALUARSA
}

enum JenisSyaratPromo {
  MIN_BELANJA
  ITEM_TERTENTU
  KATEGORI_TERTENTU
  OUTLET_TERTENTU
  JAM_TERTENTU
}

enum StatusKupon {
  AKTIF
  NONAKTIF
  HABIS
}

// ALT-DEF-010: Promo hanya punya relasi langsung ke Tenant (fields: [tenantId])
// - itu SUDAH aman tanpa composite-FK karena Tenant.id ADALAH identitas tenant
// itu sendiri, tidak ada perantara yang bisa menyimpang. CATATAN GAP (di luar
// scope batch ini): Promo TIDAK punya relasi outlet sama sekali saat ini -
// enum JenisSyaratPromo punya nilai OUTLET_TERTENTU yang menyiratkan promo
// semestinya bisa dibatasi per outlet, tetapi tidak ada model
// PromoOutlet/kolom outletId yang mendukungnya. Ini BUKAN defect composite-FK
// (tidak ada relasi outlet untuk dibuat composite-safe), melainkan gap desain
// domain promo yang harus ditangani di batch domain promo berikutnya - lihat
// DECISION-LOG.md ADR-013 dan DEFECT-LEDGER.md.
model Promo {
  id            String      @id
  tenantId      String
  nama          String
  jenis         JenisPromo
  berlakuSejak  DateTime
  berlakuSampai DateTime
  status        StatusPromo @default(AKTIF)
  bisaDigabung  Boolean     @default(false)
  createdAt     DateTime    @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  aturan    PromoAturan[]
  kupon     Kupon[]
  pemakaian PromoPemakaian[]

  @@map("promo")
}

model PromoAturan {
  id          String           @id
  promoId     String
  jenisSyarat JenisSyaratPromo
  nilaiSyarat Json

  promo Promo @relation(fields: [promoId], references: [id])

  @@map("promo_aturan")
}

model Kupon {
  id             String      @id
  tenantId       String
  promoId        String
  kode           String      @unique
  pelangganId    String?
  kuotaPemakaian Int?
  jumlahDipakai  Int         @default(0)
  status         StatusKupon @default(AKTIF)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  promo     Promo            @relation(fields: [promoId], references: [id])
  pelanggan Pelanggan?       @relation(fields: [pelangganId], references: [id])
  pemakaian PromoPemakaian[]

  @@map("kupon")
}

model PromoPemakaian {
  id          String   @id
  tenantId    String
  promoId     String
  kuponId     String?
  pesananId   String   @unique
  nilaiDiskon Int
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  promo   Promo   @relation(fields: [promoId], references: [id])
  kupon   Kupon?  @relation(fields: [kuponId], references: [id])
  pesanan Pesanan @relation(fields: [pesananId], references: [id])

  @@map("promo_pemakaian")
}

// =====================================================================================
// 11. PELANGGAN & KEANGGOTAAN (docs/database/11-pelanggan-keanggotaan.md)
