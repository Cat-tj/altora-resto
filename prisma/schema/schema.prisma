// Skema Prisma Altora Resto
//
// Mengimplementasikan ERD di docs/database/*.md. Aturan umum (lihat docs/database/README.md):
// - ID memakai ULID, disimpan sebagai String @id.
// - Setiap tabel transaksional/tenant-scoped membawa tenantId dan (jika relevan) outletId.
// - Uang disimpan sebagai Int dalam rupiah (bukan Decimal/Float) - tidak ada floating point.
// - Kuantitas bahan baku memakai Decimal (butuh presisi pecahan, mis. gram/ml).
// - Timestamp disimpan UTC.
// - Tidak ada hard-delete pada data finansial, stok, dan audit - lihat kolom status /
//   dibatalkanPada / dibalikOlehId di setiap domain.
//
// Skema ini adalah draft awal ("BELUM DIKERJAKAN" secara implementasi/migrasi) - lihat
// docs/engineering/MASTER-CHECKLIST.md dan docs/engineering/TRACEABILITY-MATRIX.md untuk
// status pengerjaan per requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================================
// 1. PLATFORM (docs/database/01-platform.md)
// =====================================================================================

enum StatusTenant {
  AKTIF
  NONAKTIF
  SUSPENDED
}

enum StatusOutlet {
  AKTIF
  NONAKTIF
}

enum StatusPengguna {
  AKTIF
  NONAKTIF
}

enum StatusKeanggotaanTenant {
  AKTIF
  NONAKTIF
}

enum StatusKeanggotaanOutlet {
  AKTIF
  NONAKTIF
}

enum JenisPerangkat {
  KASIR
  KDS
  PRINTER
  TABLET_PELAYAN
}

enum StatusPerangkat {
  AKTIF
  NONAKTIF
}

model Tenant {
  id        String       @id
  nama      String
  slug      String       @unique
  status    StatusTenant @default(AKTIF)
  createdAt DateTime     @default(now())

  outlet                  Outlet[]
  keanggotaanTenant       KeanggotaanTenant[]
  peran                   Peran[]
  auditLog                AuditLog[]
  pengaturanTenant        PengaturanTenant[]
  satuan                  Satuan[]
  bahan                   Bahan[]
  resep                   Resep[]
  modifierGrup            ModifierGrup[]
  itemMenu                ItemMenu[]
  supplier                Supplier[]
  purchaseOrder           PurchaseOrder[]
  returPembelian          ReturPembelian[]
  pelanggan               Pelanggan[]
  tierMembership          TierMembership[]
  promo                   Promo[]
  kupon                   Kupon[]
  promoPemakaian          PromoPemakaian[]
  jabatan                 Jabatan[]
  karyawan                Karyawan[]
  jadwalShift             JadwalShift[]
  absensi                 Absensi[]
  kategoriBiaya           KategoriBiaya[]
  rekapKasHarian          RekapKasHarian[]
  biayaOperasional        BiayaOperasional[]
  metodeBayar             MetodeBayar[]
  pesanan                 Pesanan[]
  mutasiStok              MutasiStok[]
  stokOpname              StokOpname[]
  tiketDapur              TiketDapur[]
  stasiunDapur            StasiunDapur[]
  rmPenjualanHarian       RmPenjualanHarian[]
  rmPenjualanItemHarian   RmPenjualanItemHarian[]
  rmStokKritis            RmStokKritis[]
  rmKinerjaKaryawanHarian RmKinerjaKaryawanHarian[]
  pembayaran              Pembayaran[]
  permintaanPersetujuan   PermintaanPersetujuan[]

  @@map("tenant")
}

model Outlet {
  id        String       @id
  tenantId  String
  nama      String
  kode      String
  zonaWaktu String
  status    StatusOutlet @default(AKTIF)
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  keanggotaanOutlet       KeanggotaanOutlet[]       @relation("KeanggotaanOutletOutlet")
  perangkat               Perangkat[]
  pengaturanOutlet        PengaturanOutlet[]
  kategoriMenu            KategoriMenu[]
  hargaItemOutlet         HargaItemOutlet[]         @relation("HargaItemOutletOutlet")
  gudang                  Gudang[]
  purchaseOrder           PurchaseOrder[]
  areaMeja                AreaMeja[]
  meja                    Meja[]
  reservasi               Reservasi[]
  pesanan                 Pesanan[]
  stasiunDapur            StasiunDapur[]
  tiketDapur              TiketDapur[]
  giliranKasir            GiliranKasir[]
  pembayaran              Pembayaran[]
  mutasiStok              MutasiStok[]
  karyawanUtama           Karyawan[]                @relation("KaryawanOutletUtama")
  jadwalShift             JadwalShift[]
  absensi                 Absensi[]
  rekapKasHarian          RekapKasHarian[]
  biayaOperasional        BiayaOperasional[]
  rmPenjualanHarian       RmPenjualanHarian[]
  rmPenjualanItemHarian   RmPenjualanItemHarian[]
  rmStokKritis            RmStokKritis[]
  rmKinerjaKaryawanHarian RmKinerjaKaryawanHarian[]

  @@unique([tenantId, kode])
  // Diperlukan (bukan sekadar @id) agar KeanggotaanOutlet bisa memakai composite FK
  // (tenantId, outletId) -> (tenantId, id) sebagai jaminan level-database bahwa
  // outlet yang direferensikan benar-benar milik tenant yang sama (lihat ALT-DEF-001,
  // ADR baru "Composite-FK tenant-outlet" di DECISION-LOG.md).
  @@unique([tenantId, id])
  @@map("outlet")
}

// ALT-DEF-001: Pengguna adalah IDENTITAS GLOBAL (autentikasi) - sengaja TIDAK
// membawa tenantId/outletId/peran langsung. Keanggotaan tenant/outlet/peran
// dimodelkan terpisah di KeanggotaanTenant/KeanggotaanOutlet/KeanggotaanPeran
// di bawah, sehingga satu Pengguna bisa menjadi anggota banyak Tenant (mis.
// konsultan yang mengelola beberapa resto) dengan peran berbeda di tiap tenant.
// Lihat docs/engineering/DECISION-LOG.md ADR-011.
//
// Catatan pinHash: field pinHash LAMA (PIN global per pengguna) sengaja
// DIHAPUS di sini, bukan dipindahkan - PIN-per-outlet (ALT-DEF-013) adalah
// model terpisah (mis. PinOutlet pada KeanggotaanOutlet) yang akan dibangun di
// batch auth/session berikutnya (ALT-DEF-003/013), tidak di batch ini.
model Pengguna {
  id                     String         @id
  namaLengkap            String
  // Unik GLOBAL (bukan per tenant lagi) - satu alamat email = satu identitas
  // pengguna lintas seluruh platform. Lihat ADR-011 untuk alasan kebijakan ini.
  email                  String         @unique
  // Nullable untuk sementara karena data seed/existing mungkin belum punya
  // kredensial password - begitu alur auth email+password dibangun (ALT-DEF-003),
  // field ini semestinya menjadi wajib (non-null) untuk pengguna yang aktif login.
  passwordHash           String?
  status                 StatusPengguna @default(AKTIF)
  emailTerverifikasiPada DateTime?
  terakhirLoginPada      DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  keanggotaanTenant               KeanggotaanTenant[]
  sesi                            Sesi[]
  auditLog                        AuditLog[]
  karyawan                        Karyawan?
  giliranKasir                    GiliranKasir[]
  purchaseOrderDibuat             PurchaseOrder[]         @relation("PoDibuatOleh")
  penerimaanBarangDiterima        PenerimaanBarang[]      @relation("PenerimaanDiterimaOleh")
  stokOpnameDibuat                StokOpname[]            @relation("OpnameDibuatOleh")
  pesananDibuat                   Pesanan[]               @relation("PesananDibuatOleh")
  pesananRiwayatStatusDiubah      PesananRiwayatStatus[]  @relation("RiwayatStatusDiubahOleh")
  pembayaranDikonfirmasi          Pembayaran[]            @relation("PembayaranDikonfirmasiOleh")
  qrisKonfirmasiDiverifikasi      QrisKonfirmasiManual[]  @relation("QrisDiverifikasiOleh")
  pembayaranRefundDisetujui       PembayaranRefund[]      @relation("RefundDisetujuiOleh")
  cutiIzinDisetujui               CutiIzin[]              @relation("CutiDisetujuiOleh")
  rekapKasHarianDiverifikasi      RekapKasHarian[]        @relation("RekapDiverifikasiOleh")
  biayaOperasionalDicatat         BiayaOperasional[]      @relation("BiayaDicatatOleh")
  izinSementaraDiberikan          IzinSementara[]         @relation("IzinSementaraDiberikanOleh")
  permintaanPersetujuanDiputuskan PermintaanPersetujuan[] @relation("PersetujuanDisetujuiOleh")

  @@map("pengguna")
}

// Menghubungkan satu Pengguna (identitas global) ke satu Tenant. Satu Pengguna
// dapat memiliki banyak baris KeanggotaanTenant aktif (satu per tenant tempat ia
// bekerja) - lihat ALT-PLT-003. `isOwner` menandai keanggotaan pemilik tenant
// (dibuat otomatis saat registrasi tenant, ALT-PLT-002).
model KeanggotaanTenant {
  id            String                  @id
  penggunaId    String
  tenantId      String
  status        StatusKeanggotaanTenant @default(AKTIF)
  isOwner       Boolean                 @default(false)
  bergabungPada DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  pengguna Pengguna @relation(fields: [penggunaId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  keanggotaanOutlet             KeanggotaanOutlet[]
  keanggotaanOutletTenantScoped KeanggotaanOutlet[]     @relation("KeanggotaanOutletTenantScoped")
  keanggotaanPeran              KeanggotaanPeran[]
  izinSementara                 IzinSementara[]
  permintaanPersetujuanPemohon  PermintaanPersetujuan[] @relation("PersetujuanPemohon")

  @@unique([penggunaId, tenantId])
  // Diperlukan agar KeanggotaanOutlet bisa memakai composite FK
  // (tenantId, keanggotaanTenantId) -> (tenantId, id) - lihat catatan di
  // KeanggotaanOutlet dan ADR-011 di DECISION-LOG.md.
  @@unique([tenantId, id])
  @@map("keanggotaan_tenant")
}

// Menentukan outlet mana saja yang boleh diakses oleh satu KeanggotaanTenant
// (ALT-PLT-007). CRITICAL (ALT-DEF-001/ALT-DEF-010): database HARUS menjamin
// KeanggotaanOutlet.tenantId == Outlet.tenantId DAN
// KeanggotaanOutlet.tenantId == KeanggotaanTenant.tenantId, agar tidak mungkin
// (di level constraint, bukan hanya guard aplikasi) sebuah keanggotaan outlet
// mencampur outlet milik tenant lain dengan keanggotaan tenant yang berbeda.
//
// Pola yang dipakai: composite-FK ganda memakai kolom tenantId yang SAMA -
// (tenantId, outletId) -> Outlet(tenantId, id) dan
// (tenantId, keanggotaanTenantId) -> KeanggotaanTenant(tenantId, id).
// Pola ini BERHASIL divalidasi oleh `prisma validate` (lihat RELEASE-EVIDENCE.md) -
// bukan fallback ke scalar+guard aplikasi.
model KeanggotaanOutlet {
  id                  String                  @id
  keanggotaanTenantId String
  // Kolom denormalisasi wajib - bukan kolom informational biasa. Nilainya harus
  // selalu sama dengan Outlet.tenantId dan KeanggotaanTenant.tenantId; kesamaan
  // itu yang membuat kedua composite FK di bawah valid secara referential
  // integrity di level database.
  tenantId            String
  outletId            String
  status              StatusKeanggotaanOutlet @default(AKTIF)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  outlet                        Outlet            @relation("KeanggotaanOutletOutlet", fields: [tenantId, outletId], references: [tenantId, id])
  keanggotaanTenant             KeanggotaanTenant @relation(fields: [keanggotaanTenantId], references: [id])
  keanggotaanTenantTenantScoped KeanggotaanTenant @relation("KeanggotaanOutletTenantScoped", fields: [tenantId, keanggotaanTenantId], references: [tenantId, id])

  @@unique([keanggotaanTenantId, outletId])
  @@map("keanggotaan_outlet")
}

// ALT-DEF-002: Peran tetap tenant-scoped, tetapi TIDAK lagi menyimpan
// permissions sebagai Json - lihat PeranIzin/Izin di bawah untuk model
// ternormalisasi.
model Peran {
  id        String              @id
  tenantId  String
  kode      String
  nama      String
  deskripsi String?
  // true untuk peran bawaan (OWNER/MANAJER/KASIR/PELAYAN/DAPUR/GUDANG/
  // PEMBELIAN/HRD) yang di-seed otomatis per tenant baru; false untuk peran
  // kustom yang dibuat tenant sendiri (ALT-PLT-008). Peran isSystem tidak boleh
  // dihapus lewat endpoint CRUD peran kustom.
  isSystem  Boolean             @default(false)
  status    StatusAktifNonaktif @default(AKTIF)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  peranIzin        PeranIzin[]
  keanggotaanPeran KeanggotaanPeran[]
  batasIzin        BatasIzin?

  @@unique([tenantId, kode])
  @@map("peran")
}

// Katalog izin (permission) atomik, GLOBAL (bukan per-tenant) - kode izin sama
// artinya di semua tenant (mis. "transaksi.diskon"), hanya kaitan ke Peran yang
// tenant-scoped lewat PeranIzin. Lihat docs/keamanan/PERMISSION-MATRIX.md untuk
// daftar kode lengkap dan prisma/seed/izin.seed.ts untuk seed data-nya.
model Izin {
  id        String              @id
  kode      String
  nama      String
  // Pengelompokan domain fungsional izin (mis. "kasir", "persediaan", "promo").
  // Dipilih sebagai String bebas (bukan enum) karena daftar domain produk masih
  // bisa bertambah tanpa migrasi skema setiap kali domain baru ditambahkan -
  // lihat ADR-011 untuk alasan pemilihan ini.
  domain    String
  deskripsi String?
  status    StatusAktifNonaktif @default(AKTIF)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  peranIzin     PeranIzin[]
  izinSementara IzinSementara[]

  @@unique([kode])
  @@map("izin")
}

// Tabel penghubung many-to-many Peran <-> Izin (ALT-PLT-010) - menggantikan
// Peran.permissions Json lama. Permission Peran sekarang bisa divalidasi lewat
// foreign key (kode izin typo akan gagal di level DB), diquery lewat join, dan
// diaudit per baris.
model PeranIzin {
  id        String   @id
  peranId   String
  izinId    String
  createdAt DateTime @default(now())

  peran Peran @relation(fields: [peranId], references: [id])
  izin  Izin  @relation(fields: [izinId], references: [id])

  @@unique([peranId, izinId])
  @@map("peran_izin")
}

// Menggantikan PenggunaPeran lama. Penetapan peran sekarang per KEANGGOTAAN
// TENANT (bukan per Pengguna global) - ini yang secara benar mengizinkan satu
// Pengguna memiliki peran BERBEDA di tenant yang berbeda (mis. jadi OWNER di
// tenant A tapi cuma KASIR di tenant B tempat ia membantu paruh waktu).
model KeanggotaanPeran {
  id                  String   @id
  keanggotaanTenantId String
  peranId             String
  createdAt           DateTime @default(now())

  keanggotaanTenant KeanggotaanTenant @relation(fields: [keanggotaanTenantId], references: [id])
  peran             Peran             @relation(fields: [peranId], references: [id])

  @@unique([keanggotaanTenantId, peranId])
  @@map("keanggotaan_peran")
}

// Batas izin bernilai (limit numerik) per Peran (ALT-PLT-011) - mis. maksimum
// diskon yang boleh diberikan KASIR tanpa perlu approval supervisor. Di-scope
// ke Peran (bukan per-pengguna) karena limit ini sesuai desain adalah atribut
// peran, bukan atribut individu.
model BatasIzin {
  id                      String   @id
  peranId                 String   @unique
  maksimumDiskonPersen    Decimal?
  maksimumDiskonNominal   Int?
  maksimumRefund          Int?
  maksimumPenyesuaianStok Decimal?
  wajibPinSupervisor      Boolean  @default(false)
  wajibPersetujuanManajer Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  peran Peran @relation(fields: [peranId], references: [id])

  @@map("batas_izin")
}

// Pemberian izin sementara/darurat (ALT-PLT-012 mendukung ini secara tidak
// langsung) - mis. supervisor sedang cuti, seorang kasir senior diberi izin
// "transaksi.diskon" sementara untuk satu shift.
model IzinSementara {
  id                  String              @id
  keanggotaanTenantId String
  izinId              String
  diberikanOlehId     String
  alasan              String
  berlakuSejak        DateTime
  berlakuSampai       DateTime
  status              StatusAktifNonaktif @default(AKTIF)
  createdAt           DateTime            @default(now())

  keanggotaanTenant KeanggotaanTenant @relation(fields: [keanggotaanTenantId], references: [id])
  izin              Izin              @relation(fields: [izinId], references: [id])
  diberikanOleh     Pengguna          @relation("IzinSementaraDiberikanOleh", fields: [diberikanOlehId], references: [id])

  @@map("izin_sementara")
}

enum StatusPermintaanPersetujuan {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DIBATALKAN
}

// Rekaman permintaan persetujuan supervisor generik (ALT-PLT-012) - dipakai
// saat sebuah aksi melebihi BatasIzin (wajibPersetujuanManajer/
// wajibPinSupervisor), mis. diskon manual, refund, penyesuaian stok.
model PermintaanPersetujuan {
  id                         String                      @id
  tenantId                   String
  outletId                   String?
  keanggotaanTenantIdPemohon String
  // Jenis aksi yang butuh persetujuan - String bebas (bukan enum) agar domain
  // lain (kasir/persediaan/pesanan) bisa menambah jenis aksi baru tanpa
  // migrasi skema di package ini (mis. "DISKON_MANUAL", "REFUND",
  // "PENYESUAIAN_STOK").
  jenisAksi                  String
  referensiJenis             String
  referensiId                String
  status                     StatusPermintaanPersetujuan @default(DIAJUKAN)
  disetujuiOlehId            String?
  catatan                    String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  tenant                   Tenant            @relation(fields: [tenantId], references: [id])
  keanggotaanTenantPemohon KeanggotaanTenant @relation("PersetujuanPemohon", fields: [keanggotaanTenantIdPemohon], references: [id])
  disetujuiOleh            Pengguna?         @relation("PersetujuanDisetujuiOleh", fields: [disetujuiOlehId], references: [id])

  @@map("permintaan_persetujuan")
}

// ALT-DEF-010: outlet di-relasi lewat composite-FK (tenantId, outletId) ->
// Outlet(tenantId, id) - menjamin tenantId Perangkat selalu sama dengan
// tenantId Outlet-nya di level database (lihat DECISION-LOG.md ADR-013).
model Perangkat {
  id           String          @id
  tenantId     String
  outletId     String
  jenis        JenisPerangkat
  kodeAktivasi String          @unique
  status       StatusPerangkat @default(AKTIF)
  lastSeenAt   DateTime?

  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  sesi   Sesi[]

  @@map("perangkat")
}

model Sesi {
  id             String    @id
  penggunaId     String
  perangkatId    String?
  dibuatPada     DateTime  @default(now())
  kadaluarsaPada DateTime
  dicabutPada    DateTime?

  pengguna  Pengguna   @relation(fields: [penggunaId], references: [id])
  perangkat Perangkat? @relation(fields: [perangkatId], references: [id])

  @@map("sesi")
}

model AuditLog {
  id         String   @id
  tenantId   String
  outletId   String?
  penggunaId String
  aksi       String
  entitas    String
  entitasId  String
  sebelum    Json?
  sesudah    Json?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  pengguna Pengguna @relation(fields: [penggunaId], references: [id])

  @@map("audit_log")
}

model PengaturanTenant {
  id       String @id
  tenantId String
  kunci    String
  nilai    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kunci])
  @@map("pengaturan_tenant")
}

// ALT-DEF-010: DIJUDGE AMAN TANPA composite-FK. PengaturanOutlet tidak
// membawa tenantId dan sengaja TIDAK ditambahkan satu di sini - model ini
// hanya punya SATU relasi (outletId -> Outlet) tanpa referensi tenant-owned
// lain yang bisa saling menyimpang (tidak seperti KeanggotaanOutlet yang
// punya DUA jalur independen yang harus dijamin konsisten). FK tunggal ke
// Outlet.id sudah sepenuhnya men-scope baris ini ke satu outlet; menambah
// kolom tenantId di sini hanya akan menduplikasi Outlet.tenantId tanpa
// menambah jaminan keamanan nyata. Lihat DECISION-LOG.md ADR-013.

model PengaturanOutlet {
  id       String @id
  outletId String
  kunci    String
  nilai    Json

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, kunci])
  @@map("pengaturan_outlet")
}

// =====================================================================================
// 2. MENU & KATALOG (docs/database/02-menu-katalog.md)
// =====================================================================================

enum StatusAktifNonaktif {
  AKTIF
  NONAKTIF
}

enum StatusItemMenu {
  AKTIF
  NONAKTIF
  HABIS
}

// ALT-DEF-010: outletId nullable (kategori berlaku lintas-outlet bila null),
// tetapi ketika diisi HARUS memakai composite-FK (tenantId, outletId) ->
// Outlet(tenantId, id). @@unique([tenantId, id]) ditambahkan agar ItemMenu
// bisa memakai composite FK menuju KategoriMenu (lihat ItemMenu di bawah).
model KategoriMenu {
  id       String              @id
  tenantId String
  outletId String?
  nama     String
  urutan   Int                 @default(0)
  status   StatusAktifNonaktif @default(AKTIF)

  outlet   Outlet?    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  itemMenu ItemMenu[]

  @@unique([tenantId, id])
  @@map("kategori_menu")
}

model ItemMenu {
  id              String         @id
  tenantId        String
  kategoriId      String
  nama            String
  deskripsi       String?
  gambarUrl       String?
  stokTakTerbatas Boolean        @default(true)
  status          StatusItemMenu @default(AKTIF)
  createdAt       DateTime       @default(now())

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, kategoriId) -> KategoriMenu(tenantId, id)
  // agar kategori yang dirujuk dijamin milik tenant yang sama dengan ItemMenu.
  kategori              KategoriMenu            @relation(fields: [tenantId, kategoriId], references: [tenantId, id])
  varian                VarianMenu[]
  modifierGrup          ItemModifierGrup[]
  hargaOutlet           HargaItemOutlet[]       @relation("HargaItemOutletItemMenu")
  resep                 Resep?
  itemPesanan           ItemPesanan[]
  rmPenjualanItemHarian RmPenjualanItemHarian[]

  @@unique([tenantId, id])
  @@map("item_menu")
}

model VarianMenu {
  id            String              @id
  itemMenuId    String
  nama          String
  hargaTambahan Int                 @default(0)
  status        StatusAktifNonaktif @default(AKTIF)

  itemMenu    ItemMenu      @relation(fields: [itemMenuId], references: [id])
  itemPesanan ItemPesanan[]

  @@map("varian_menu")
}

model ModifierGrup {
  id         String  @id
  tenantId   String
  nama       String
  wajibPilih Boolean @default(false)
  minPilihan Int     @default(0)
  maxPilihan Int     @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  itemModifier ItemModifierGrup[]
  opsi         ModifierOpsi[]

  @@map("modifier_grup")
}

model ItemModifierGrup {
  id             String @id
  itemMenuId     String
  modifierGrupId String
  urutan         Int    @default(0)

  itemMenu     ItemMenu     @relation(fields: [itemMenuId], references: [id])
  modifierGrup ModifierGrup @relation(fields: [modifierGrupId], references: [id])

  @@unique([itemMenuId, modifierGrupId])
  @@map("item_modifier_grup")
}

model ModifierOpsi {
  id             String              @id
  modifierGrupId String
  nama           String
  hargaTambahan  Int                 @default(0)
  status         StatusAktifNonaktif @default(AKTIF)

  modifierGrup        ModifierGrup          @relation(fields: [modifierGrupId], references: [id])
  itemPesananModifier ItemPesananModifier[]

  @@map("modifier_opsi")
}

// ALT-DEF-010: sebelumnya tidak punya tenantId sama sekali (gap ditemukan
// saat audit) - ditambahkan di sini beserta DUA composite-FK (pola sama
// seperti KeanggotaanOutlet/ADR-011) agar itemMenuId DAN outletId yang
// dirujuk dijamin sama-sama milik tenant yang sama dengan baris ini.
model HargaItemOutlet {
  id           String   @id
  tenantId     String
  itemMenuId   String
  outletId     String
  harga        Int
  berlakuSejak DateTime @default(now())

  itemMenu ItemMenu @relation("HargaItemOutletItemMenu", fields: [tenantId, itemMenuId], references: [tenantId, id])
  outlet   Outlet   @relation("HargaItemOutletOutlet", fields: [tenantId, outletId], references: [tenantId, id])

  @@map("harga_item_outlet")
}

// =====================================================================================
// 3. RESEP & BAHAN / BOM (docs/database/03-resep-bahan.md)
// =====================================================================================

model Bahan {
  id            String              @id
  tenantId      String
  nama          String
  kodeSku       String
  satuanDasarId String
  stokMinimum   Int                 @default(0)
  status        StatusAktifNonaktif @default(AKTIF)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  satuanDasar     Satuan                  @relation(fields: [satuanDasarId], references: [id])
  resepBahan      ResepBahan[]
  stokBahan       StokBahan[]             @relation("StokBahanBahan")
  poBaris         PurchaseOrderBaris[]
  penerimaanBaris PenerimaanBarangBaris[]
  mutasiStok      MutasiStok[]
  opnameBaris     StokOpnameBaris[]
  rmStokKritis    RmStokKritis[]

  @@unique([tenantId, kodeSku])
  // ALT-DEF-010: agar StokBahan/MutasiStok/RmStokKritis bisa memakai
  // composite-FK (tenantId, bahanId) -> Bahan(tenantId, id).
  @@unique([tenantId, id])
  @@map("bahan")
}

model Satuan {
  id       String @id
  tenantId String
  nama     String
  simbol   String

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  bahan      Bahan[]
  resepBahan ResepBahan[]

  @@map("satuan")
}

enum StatusResep {
  AKTIF
  NONAKTIF
}

model Resep {
  id         String      @id
  tenantId   String
  itemMenuId String      @unique
  versi      String
  status     StatusResep @default(AKTIF)
  createdAt  DateTime    @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  itemMenu   ItemMenu     @relation(fields: [itemMenuId], references: [id])
  resepBahan ResepBahan[]

  @@map("resep")
}

model ResepBahan {
  id       String  @id
  resepId  String
  bahanId  String
  jumlah   Decimal
  satuanId String

  resep  Resep  @relation(fields: [resepId], references: [id])
  bahan  Bahan  @relation(fields: [bahanId], references: [id])
  satuan Satuan @relation(fields: [satuanId], references: [id])

  @@map("resep_bahan")
}

// =====================================================================================
// 4. PERSEDIAAN (docs/database/04-persediaan.md)
// =====================================================================================

enum JenisMutasiStok {
  MASUK_PEMBELIAN
  KELUAR_PENJUALAN
  OPNAME_PENYESUAIAN
  TRANSFER_MASUK
  TRANSFER_KELUAR
  RETUR
}

enum ReferensiJenisMutasi {
  PEMBELIAN
  PESANAN
  OPNAME
  TRANSFER
}

enum StatusStokOpname {
  DIRENCANAKAN
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}

// ALT-DEF-010: outlet direlasi lewat composite-FK (tenantId, outletId) ->
// Outlet(tenantId, id). @@unique([tenantId, id]) ditambahkan agar
// StokBahan/MutasiStok/StokOpname/PenerimaanBarang bisa memakai composite FK
// menuju Gudang.
model Gudang {
  id       String              @id
  tenantId String
  outletId String
  nama     String
  status   StatusAktifNonaktif @default(AKTIF)

  outlet           Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id])
  stokBahan        StokBahan[]        @relation("StokBahanGudang")
  stokOpname       StokOpname[]
  penerimaanBarang PenerimaanBarang[] @relation("PenerimaanBarangGudang")
  MutasiStok       MutasiStok[]

  @@unique([tenantId, id])
  @@map("gudang")
}

// ALT-DEF-010: sebelumnya tidak punya tenantId sama sekali (gap ditemukan
// saat audit) - Gudang dan Bahan bisa secara teori dimiliki tenant berbeda
// tanpa jaminan apa pun. Ditambahkan tenantId denormalisasi + DUA
// composite-FK (pola sama seperti KeanggotaanOutlet/ADR-011).
model StokBahan {
  id        String   @id
  tenantId  String
  gudangId  String
  bahanId   String
  kuantitas Decimal  @default(0)
  updatedAt DateTime @updatedAt

  gudang Gudang @relation("StokBahanGudang", fields: [tenantId, gudangId], references: [tenantId, id])
  bahan  Bahan  @relation("StokBahanBahan", fields: [tenantId, bahanId], references: [tenantId, id])

  @@unique([gudangId, bahanId])
  @@map("stok_bahan")
}

model MutasiStok {
  id             String               @id
  tenantId       String
  outletId       String
  gudangId       String
  bahanId        String
  jenis          JenisMutasiStok
  jumlah         Decimal
  referensiJenis ReferensiJenisMutasi
  referensiId    String
  dibalikOlehId  String?              @unique
  dibuatOlehId   String
  createdAt      DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: sebelumnya gudangId ada sebagai kolom scalar TANPA relasi FK
  // sama sekali (gap ditemukan saat audit) - ditambahkan di sini sebagai
  // composite-FK (tenantId, gudangId) -> Gudang(tenantId, id).
  gudang Gudang @relation(fields: [tenantId, gudangId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, bahanId) -> Bahan(tenantId, id).
  bahan  Bahan  @relation(fields: [tenantId, bahanId], references: [tenantId, id])

  dibalikOleh  MutasiStok? @relation("MutasiPembalik", fields: [dibalikOlehId], references: [id])
  pembalikDari MutasiStok? @relation("MutasiPembalik")

  @@map("mutasi_stok")
}

// ALT-DEF-010: gudang direlasi lewat composite-FK (tenantId, gudangId) ->
// Gudang(tenantId, id) - StokOpname tidak punya outletId langsung, jadi
// tenantId adalah kolom bersama yang tersedia untuk komposit ini.
model StokOpname {
  id               String           @id
  tenantId         String
  gudangId         String
  status           StatusStokOpname @default(DIRENCANAKAN)
  dijadwalkanPada  DateTime
  diselesaikanPada DateTime?
  dibuatOlehId     String

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  gudang     Gudang            @relation(fields: [tenantId, gudangId], references: [tenantId, id])
  dibuatOleh Pengguna          @relation("OpnameDibuatOleh", fields: [dibuatOlehId], references: [id])
  baris      StokOpnameBaris[]

  @@map("stok_opname")
}

model StokOpnameBaris {
  id              String  @id
  stokOpnameId    String
  bahanId         String
  kuantitasSistem Decimal
  kuantitasFisik  Decimal
  selisih         Decimal

  stokOpname StokOpname @relation(fields: [stokOpnameId], references: [id])
  bahan      Bahan      @relation(fields: [bahanId], references: [id])

  @@map("stok_opname_baris")
}

// =====================================================================================
// 5. SUPPLIER & PEMBELIAN (docs/database/05-supplier-pembelian.md)
// =====================================================================================

enum StatusPurchaseOrder {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DIKIRIM_SUPPLIER
  DITERIMA_SEBAGIAN
  DITERIMA_PENUH
  DIBATALKAN
}

enum StatusReturPembelian {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  SELESAI
}

model Supplier {
  id       String              @id
  tenantId String
  nama     String
  kontak   String?
  status   StatusAktifNonaktif @default(AKTIF)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder[]

  // ALT-DEF-010: agar PurchaseOrder bisa memakai composite-FK
  // (tenantId, supplierId) -> Supplier(tenantId, id).
  @@unique([tenantId, id])
  @@map("supplier")
}

model PurchaseOrder {
  id            String              @id
  tenantId      String
  outletId      String
  supplierId    String
  nomorPo       String              @unique
  status        StatusPurchaseOrder @default(DRAFT)
  totalEstimasi Int                 @default(0)
  dibuatOlehId  String
  createdAt     DateTime            @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet     Outlet               @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, supplierId) -> Supplier(tenantId, id) -
  // menjamin PurchaseOrder↔Supplier tidak bisa lintas tenant.
  supplier   Supplier             @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  dibuatOleh Pengguna             @relation("PoDibuatOleh", fields: [dibuatOlehId], references: [id])
  baris      PurchaseOrderBaris[]
  penerimaan PenerimaanBarang[]   @relation("PenerimaanBarangPo")

  // ALT-DEF-010: agar PenerimaanBarang bisa memakai composite-FK
  // (tenantId, purchaseOrderId) -> PurchaseOrder(tenantId, id).
  @@unique([tenantId, id])
  @@map("purchase_order")
}

model PurchaseOrderBaris {
  id              String  @id
  purchaseOrderId String
  bahanId         String
  jumlahDipesan   Decimal
  hargaSatuan     Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  bahan         Bahan         @relation(fields: [bahanId], references: [id])

  @@map("purchase_order_baris")
}

// ALT-DEF-010: sebelumnya tidak punya tenantId sama sekali (gap ditemukan
// saat audit) - purchaseOrderId dan gudangId bisa secara teori merujuk
// tenant yang berbeda tanpa jaminan apa pun. Ditambahkan tenantId
// denormalisasi + DUA composite-FK (pola sama seperti KeanggotaanOutlet/ADR-011).
model PenerimaanBarang {
  id              String   @id
  tenantId        String
  purchaseOrderId String
  gudangId        String
  nomorPenerimaan String   @unique
  diterimaPada    DateTime @default(now())
  diterimaOlehId  String

  purchaseOrder  PurchaseOrder           @relation("PenerimaanBarangPo", fields: [tenantId, purchaseOrderId], references: [tenantId, id])
  gudang         Gudang                  @relation("PenerimaanBarangGudang", fields: [tenantId, gudangId], references: [tenantId, id])
  diterimaOleh   Pengguna                @relation("PenerimaanDiterimaOleh", fields: [diterimaOlehId], references: [id])
  baris          PenerimaanBarangBaris[]
  returPembelian ReturPembelian[]

  @@map("penerimaan_barang")
}

model PenerimaanBarangBaris {
  id                 String  @id
  penerimaanBarangId String
  bahanId            String
  jumlahDiterima     Decimal
  hargaSatuanAktual  Int

  penerimaanBarang PenerimaanBarang @relation(fields: [penerimaanBarangId], references: [id])
  bahan            Bahan            @relation(fields: [bahanId], references: [id])

  @@map("penerimaan_barang_baris")
}

model ReturPembelian {
  id                 String               @id
  tenantId           String
  penerimaanBarangId String
  alasan             String
  status             StatusReturPembelian @default(DIAJUKAN)
  createdAt          DateTime             @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  penerimaanBarang PenerimaanBarang @relation(fields: [penerimaanBarangId], references: [id])

  @@map("retur_pembelian")
}

// =====================================================================================
// 6. MEJA & RESERVASI (docs/database/06-meja-reservasi.md)
// =====================================================================================

enum StatusMeja {
  TERSEDIA
  TERPAKAI
  DIPESAN
  PERLU_DIBERSIHKAN
  NONAKTIF
}

enum StatusReservasi {
  DIAJUKAN
  DIKONFIRMASI
  TIBA
  SELESAI
  TIDAK_HADIR
  DIBATALKAN
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
// @@unique([outletId, id]) ditambahkan agar Meja bisa memakai composite FK
// (outletId, areaMejaId) menuju AreaMeja - dipilih memakai outletId (bukan
// tenantId) karena risiko nyata di sini adalah pencampuran AREA/MEJA lintas
// OUTLET dalam tenant yang sama, bukan cuma lintas tenant.
model AreaMeja {
  id       String @id
  tenantId String
  outletId String
  nama     String

  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  meja   Meja[]

  @@unique([outletId, id])
  @@map("area_meja")
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id);
// areaMeja lewat composite-FK (outletId, areaMejaId) -> AreaMeja(outletId, id).
// @@unique([outletId, id]) ditambahkan agar Pesanan/Reservasi/SesiMejaQr bisa
// memakai composite FK (outletId, mejaId) menuju Meja.
model Meja {
  id         String     @id
  tenantId   String
  outletId   String
  areaMejaId String
  nomor      String
  kapasitas  Int
  status     StatusMeja @default(TERSEDIA)

  outlet    Outlet       @relation(fields: [tenantId, outletId], references: [tenantId, id])
  areaMeja  AreaMeja     @relation(fields: [outletId, areaMejaId], references: [outletId, id])
  reservasi Reservasi[]
  pesanan   Pesanan[]
  sesiQr    SesiMejaQr[]

  @@unique([outletId, nomor])
  @@unique([outletId, id])
  @@map("meja")
}

// ALT-DEF-010: DIJUDGE AMAN TANPA composite-FK/tenantId tambahan. SesiMejaQr
// tidak membawa tenantId/outletId sendiri dan hanya punya SATU relasi
// (mejaId -> Meja, yang sekarang sudah tenant/outlet-safe lewat composite FK
// di atas). Tidak ada referensi tenant-owned kedua yang bisa menyimpang dari
// Meja, jadi FK tunggal ke Meja.id sudah cukup - menambah tenantId di sini
// hanya menduplikasi data tanpa jaminan tambahan. Lihat DECISION-LOG.md ADR-013.
model SesiMejaQr {
  id             String    @id
  mejaId         String
  token          String    @unique
  dibuatPada     DateTime  @default(now())
  kadaluarsaPada DateTime
  ditutupPada    DateTime?

  meja Meja @relation(fields: [mejaId], references: [id])

  @@map("sesi_meja_qr")
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id);
// meja (opsional) lewat composite-FK (outletId, mejaId) -> Meja(outletId, id)
// - memakai outletId agar meja yang dirujuk dijamin di outlet yang sama
// dengan reservasi; pelanggan lewat composite-FK (tenantId, pelangganId) ->
// Pelanggan(tenantId, id).
model Reservasi {
  id             String          @id
  tenantId       String
  outletId       String
  mejaId         String?
  pelangganId    String
  jumlahTamu     Int
  waktuReservasi DateTime
  status         StatusReservasi @default(DIAJUKAN)
  createdAt      DateTime        @default(now())

  outlet    Outlet    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  meja      Meja?     @relation(fields: [outletId, mejaId], references: [outletId, id])
  pelanggan Pelanggan @relation(fields: [tenantId, pelangganId], references: [tenantId, id])

  @@map("reservasi")
}

// =====================================================================================
// 7. PESANAN (docs/database/07-pesanan.md)
// =====================================================================================

enum KanalPesanan {
  KASIR
  PELAYAN
  QR_PELANGGAN
}

enum StatusPesanan {
  BARU
  DIKONFIRMASI
  DIPROSES_DAPUR
  SIAP_DISAJIKAN
  DISAJIKAN
  DIBAYAR
  DIBATALKAN
}

enum StatusItemPesanan {
  BARU
  DIKIRIM_DAPUR
  SIAP
  DISAJIKAN
  DIBATALKAN
}

model Pesanan {
  id                 String        @id
  tenantId           String
  outletId           String
  mejaId             String?
  pelangganId        String?
  kanal              KanalPesanan
  nomorPesanan       String
  status             StatusPesanan @default(BARU)
  subtotal           Int           @default(0)
  totalDiskon        Int           @default(0)
  totalPajak         Int           @default(0)
  totalServiceCharge Int           @default(0)
  totalAkhir         Int           @default(0)
  dibuatOlehId       String
  createdAt          DateTime      @default(now())
  dibatalkanPada     DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet     Outlet     @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (outletId, mejaId) -> Meja(outletId, id) - meja
  // yang dirujuk dijamin berada di outlet yang sama dengan pesanan.
  meja       Meja?      @relation(fields: [outletId, mejaId], references: [outletId, id])
  // ALT-DEF-010: composite-FK (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  pelanggan  Pelanggan? @relation(fields: [tenantId, pelangganId], references: [tenantId, id])
  dibuatOleh Pengguna   @relation("PesananDibuatOleh", fields: [dibuatOlehId], references: [id])

  itemPesanan    ItemPesanan[]
  riwayatStatus  PesananRiwayatStatus[]
  pembayaran     Pembayaran[]
  promoPemakaian PromoPemakaian?
  tiketDapur     TiketDapur?
  transaksiKasir TransaksiKasir[]
  poinRiwayat    PoinRiwayat[]

  @@unique([outletId, nomorPesanan])
  // ALT-DEF-010: agar TiketDapur/Pembayaran bisa memakai composite-FK
  // (tenantId, pesananId) -> Pesanan(tenantId, id).
  @@unique([tenantId, id])
  @@map("pesanan")
}

model ItemPesanan {
  id           String            @id
  pesananId    String
  itemMenuId   String
  varianMenuId String?
  kuantitas    Int
  hargaSatuan  Int
  catatan      String?
  status       StatusItemPesanan @default(BARU)

  pesanan    Pesanan     @relation(fields: [pesananId], references: [id])
  itemMenu   ItemMenu    @relation(fields: [itemMenuId], references: [id])
  varianMenu VarianMenu? @relation(fields: [varianMenuId], references: [id])

  modifier        ItemPesananModifier[]
  tiketDapurBaris TiketDapurBaris?

  @@map("item_pesanan")
}

model ItemPesananModifier {
  id             String @id
  itemPesananId  String
  modifierOpsiId String
  hargaTambahan  Int

  itemPesanan  ItemPesanan  @relation(fields: [itemPesananId], references: [id])
  modifierOpsi ModifierOpsi @relation(fields: [modifierOpsiId], references: [id])

  @@map("item_pesanan_modifier")
}

model PesananRiwayatStatus {
  id               String   @id
  pesananId        String
  statusSebelumnya String
  statusBaru       String
  diubahOlehId     String
  createdAt        DateTime @default(now())

  pesanan    Pesanan  @relation(fields: [pesananId], references: [id])
  diubahOleh Pengguna @relation("RiwayatStatusDiubahOleh", fields: [diubahOlehId], references: [id])

  @@map("pesanan_riwayat_status")
}

// =====================================================================================
// 8. DAPUR / KDS (docs/database/08-dapur.md)
// =====================================================================================

enum StatusTiketDapur {
  MASUK_ANTRIAN
  DIPROSES
  SIAP
  DIAMBIL_PELAYAN
}

enum StatusMasakBaris {
  MENUNGGU
  DIMASAK
  SIAP
}

// ALT-DEF-010: outlet lewat composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
// @@unique([outletId, id]) ditambahkan agar TiketDapur bisa memakai
// composite FK (outletId, stasiunDapurId) menuju StasiunDapur.
model StasiunDapur {
  id       String @id
  tenantId String
  outletId String
  nama     String

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  outlet     Outlet       @relation(fields: [tenantId, outletId], references: [tenantId, id])
  tiketDapur TiketDapur[]

  @@unique([outletId, id])
  @@map("stasiun_dapur")
}

model TiketDapur {
  id                String           @id
  tenantId          String
  outletId          String
  pesananId         String           @unique
  stasiunDapurId    String?
  status            StatusTiketDapur @default(MASUK_ANTRIAN)
  masukPada         DateTime         @default(now())
  mulaiDiprosesPada DateTime?
  siapPada          DateTime?

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet       Outlet            @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id) -
  // menjamin tiket dapur tidak bisa merujuk pesanan tenant lain meskipun
  // tenantId TiketDapur sendiri dicatat terpisah dari Pesanan.
  pesanan      Pesanan           @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (outletId, stasiunDapurId) -> StasiunDapur(outletId, id) -
  // memakai outletId agar stasiun dapur yang dirujuk dijamin di outlet yang
  // sama dengan tiket (lihat juga test isolasi TiketDapur↔StasiunDapur/Outlet).
  stasiunDapur StasiunDapur?     @relation(fields: [outletId, stasiunDapurId], references: [outletId, id])
  baris        TiketDapurBaris[]

  // Diperlukan agar composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id)
  // valid sebagai relasi one-to-one (pesananId sudah @unique tunggal di atas).
  @@unique([tenantId, pesananId])
  @@map("tiket_dapur")
}

model TiketDapurBaris {
  id            String           @id
  tiketDapurId  String
  itemPesananId String           @unique
  statusMasak   StatusMasakBaris @default(MENUNGGU)

  tiketDapur  TiketDapur  @relation(fields: [tiketDapurId], references: [id])
  itemPesanan ItemPesanan @relation(fields: [itemPesananId], references: [id])

  @@map("tiket_dapur_baris")
}

// =====================================================================================
// 9. PEMBAYARAN & KASIR (docs/database/09-pembayaran-kasir.md)
// =====================================================================================

enum StatusGiliranKasir {
  DIBUKA
  DITUTUP_MENUNGGU_VERIFIKASI
  DITUTUP_SELESAI
}

enum JenisTransaksiKasir {
  PENJUALAN
  REFUND
  KOREKSI
}

enum KodeMetodeBayar {
  TUNAI
  QRIS_MANUAL
  KARTU_DEBIT
  KARTU_KREDIT
  EWALLET
}

enum StatusPembayaran {
  MENUNGGU
  DIKONFIRMASI
  GAGAL
  DIBATALKAN
  DIREFUND
}

model GiliranKasir {
  id                 String             @id
  tenantId           String
  outletId           String
  penggunaId         String
  modalAwal          Int
  modalAkhirDihitung Int?
  modalAkhirSistem   Int?
  status             StatusGiliranKasir @default(DIBUKA)
  dibukaPada         DateTime           @default(now())
  ditutupPada        DateTime?

  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet         Outlet           @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // pengguna: Pengguna adalah identitas GLOBAL (ALT-DEF-001) - sengaja TIDAK
  // di-composite-kan ke tenant, sama seperti relasi Pengguna lain di seluruh
  // skema ini.
  pengguna       Pengguna         @relation(fields: [penggunaId], references: [id])
  transaksiKasir TransaksiKasir[]
  rekapKasHarian RekapKasHarian?

  // ALT-DEF-010: agar RekapKasHarian bisa memakai composite-FK
  // (tenantId, giliranKasirId) -> GiliranKasir(tenantId, id).
  @@unique([tenantId, id])
  @@map("giliran_kasir")
}

model TransaksiKasir {
  id             String              @id
  giliranKasirId String
  pesananId      String
  jenis          JenisTransaksiKasir
  jumlah         Int
  createdAt      DateTime            @default(now())

  giliranKasir GiliranKasir @relation(fields: [giliranKasirId], references: [id])
  pesanan      Pesanan      @relation(fields: [pesananId], references: [id])

  @@map("transaksi_kasir")
}

model MetodeBayar {
  id       String              @id
  tenantId String
  kode     KodeMetodeBayar
  nama     String
  status   StatusAktifNonaktif @default(AKTIF)

  tenant Tenant                  @relation(fields: [tenantId], references: [id])
  baris  PembayaranMetodeBaris[]

  @@map("metode_bayar")
}

model Pembayaran {
  id                 String           @id
  tenantId           String
  outletId           String
  pesananId          String
  totalDibayar       Int
  totalDiterima      Int
  kembalian          Int              @default(0)
  status             StatusPembayaran @default(MENUNGGU)
  dikonfirmasiOlehId String?
  createdAt          DateTime         @default(now())
  dikonfirmasiPada   DateTime?

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet           Outlet    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, pesananId) -> Pesanan(tenantId, id).
  pesanan          Pesanan   @relation(fields: [tenantId, pesananId], references: [tenantId, id])
  dikonfirmasiOleh Pengguna? @relation("PembayaranDikonfirmasiOleh", fields: [dikonfirmasiOlehId], references: [id])

  metodeBaris    PembayaranMetodeBaris[]
  qrisKonfirmasi QrisKonfirmasiManual?
  struk          Struk?
  refund         PembayaranRefund[]

  @@map("pembayaran")
}

model PembayaranMetodeBaris {
  id            String @id
  pembayaranId  String
  metodeBayarId String
  jumlah        Int

  pembayaran  Pembayaran  @relation(fields: [pembayaranId], references: [id])
  metodeBayar MetodeBayar @relation(fields: [metodeBayarId], references: [id])

  @@map("pembayaran_metode_baris")
}

model QrisKonfirmasiManual {
  id                 String   @id
  pembayaranId       String   @unique
  catatanKasir       String?
  diverifikasiOlehId String
  diverifikasiPada   DateTime @default(now())

  pembayaran       Pembayaran @relation(fields: [pembayaranId], references: [id])
  diverifikasiOleh Pengguna   @relation("QrisDiverifikasiOleh", fields: [diverifikasiOlehId], references: [id])

  @@map("qris_konfirmasi_manual")
}

model Struk {
  id               String    @id
  pembayaranId     String    @unique
  nomorStruk       String    @unique
  dicetakPada      DateTime?
  jumlahCetakUlang Int       @default(0)

  pembayaran Pembayaran @relation(fields: [pembayaranId], references: [id])

  @@map("struk")
}

model PembayaranRefund {
  id              String   @id
  pembayaranId    String
  jumlah          Int
  alasan          String
  disetujuiOlehId String
  createdAt       DateTime @default(now())

  pembayaran    Pembayaran @relation(fields: [pembayaranId], references: [id])
  disetujuiOleh Pengguna   @relation("RefundDisetujuiOleh", fields: [disetujuiOlehId], references: [id])

  @@map("pembayaran_refund")
}

// =====================================================================================
// 10. PROMO (docs/database/10-promo.md)
// =====================================================================================

enum JenisPromo {
  DISKON_PERSEN
  DISKON_NOMINAL
  BELI_X_GRATIS_Y
  HARGA_PAKET
}

enum StatusPromo {
  AKTIF
  NONAKTIF
  KADALUARSA
}

enum JenisSyaratPromo {
  MIN_BELANJA
  ITEM_TERTENTU
  KATEGORI_TERTENTU
  OUTLET_TERTENTU
  JAM_TERTENTU
}

enum StatusKupon {
  AKTIF
  NONAKTIF
  HABIS
}

// ALT-DEF-010: Promo hanya punya relasi langsung ke Tenant (fields: [tenantId])
// - itu SUDAH aman tanpa composite-FK karena Tenant.id ADALAH identitas tenant
// itu sendiri, tidak ada perantara yang bisa menyimpang. CATATAN GAP (di luar
// scope batch ini): Promo TIDAK punya relasi outlet sama sekali saat ini -
// enum JenisSyaratPromo punya nilai OUTLET_TERTENTU yang menyiratkan promo
// semestinya bisa dibatasi per outlet, tetapi tidak ada model
// PromoOutlet/kolom outletId yang mendukungnya. Ini BUKAN defect composite-FK
// (tidak ada relasi outlet untuk dibuat composite-safe), melainkan gap desain
// domain promo yang harus ditangani di batch domain promo berikutnya - lihat
// DECISION-LOG.md ADR-013 dan DEFECT-LEDGER.md.
model Promo {
  id            String      @id
  tenantId      String
  nama          String
  jenis         JenisPromo
  berlakuSejak  DateTime
  berlakuSampai DateTime
  status        StatusPromo @default(AKTIF)
  bisaDigabung  Boolean     @default(false)
  createdAt     DateTime    @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  aturan    PromoAturan[]
  kupon     Kupon[]
  pemakaian PromoPemakaian[]

  @@map("promo")
}

model PromoAturan {
  id          String           @id
  promoId     String
  jenisSyarat JenisSyaratPromo
  nilaiSyarat Json

  promo Promo @relation(fields: [promoId], references: [id])

  @@map("promo_aturan")
}

model Kupon {
  id             String      @id
  tenantId       String
  promoId        String
  kode           String      @unique
  pelangganId    String?
  kuotaPemakaian Int?
  jumlahDipakai  Int         @default(0)
  status         StatusKupon @default(AKTIF)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  promo     Promo            @relation(fields: [promoId], references: [id])
  pelanggan Pelanggan?       @relation(fields: [pelangganId], references: [id])
  pemakaian PromoPemakaian[]

  @@map("kupon")
}

model PromoPemakaian {
  id          String   @id
  tenantId    String
  promoId     String
  kuponId     String?
  pesananId   String   @unique
  nilaiDiskon Int
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  promo   Promo   @relation(fields: [promoId], references: [id])
  kupon   Kupon?  @relation(fields: [kuponId], references: [id])
  pesanan Pesanan @relation(fields: [pesananId], references: [id])

  @@map("promo_pemakaian")
}

// =====================================================================================
// 11. PELANGGAN & KEANGGOTAAN (docs/database/11-pelanggan-keanggotaan.md)
// =====================================================================================

enum StatusKeanggotaan {
  AKTIF
  NONAKTIF
}

enum JenisPoinRiwayat {
  PEROLEHAN
  PENUKARAN
  PENYESUAIAN
  KADALUARSA
}

model Pelanggan {
  id           String   @id
  tenantId     String
  namaLengkap  String
  nomorTelepon String
  email        String?
  createdAt    DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  keanggotaan Keanggotaan?
  pesanan     Pesanan[]
  reservasi   Reservasi[]
  kupon       Kupon[]

  @@unique([tenantId, nomorTelepon])
  // ALT-DEF-010: agar Pesanan/Reservasi bisa memakai composite-FK
  // (tenantId, pelangganId) -> Pelanggan(tenantId, id).
  @@unique([tenantId, id])
  @@map("pelanggan")
}

model TierMembership {
  id               String @id
  tenantId         String
  nama             String
  minPoinKumulatif Int    @default(0)
  benefit          Json

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  keanggotaan Keanggotaan[]

  @@map("tier_membership")
}

model Keanggotaan {
  id               String            @id
  pelangganId      String            @unique
  tierMembershipId String
  poinAktif        Int               @default(0)
  poinKumulatif    Int               @default(0)
  status           StatusKeanggotaan @default(AKTIF)
  bergabungPada    DateTime          @default(now())

  pelanggan      Pelanggan      @relation(fields: [pelangganId], references: [id])
  tierMembership TierMembership @relation(fields: [tierMembershipId], references: [id])
  poinRiwayat    PoinRiwayat[]

  @@map("keanggotaan")
}

model PoinRiwayat {
  id            String           @id
  keanggotaanId String
  pesananId     String?
  jenis         JenisPoinRiwayat
  jumlah        Int
  createdAt     DateTime         @default(now())

  keanggotaan Keanggotaan @relation(fields: [keanggotaanId], references: [id])
  pesanan     Pesanan?    @relation(fields: [pesananId], references: [id])

  @@map("poin_riwayat")
}

// =====================================================================================
// 12. KARYAWAN & ABSENSI (docs/database/12-karyawan-absensi.md)
// =====================================================================================

enum StatusKaryawan {
  AKTIF
  CUTI
  NONAKTIF
}

enum StatusPenugasanShift {
  DIJADWALKAN
  DIBATALKAN
}

enum MetodeAbsensi {
  QR
  PIN
  GPS
  MANUAL_SUPERVISOR
}

enum StatusAbsensi {
  TEPAT_WAKTU
  TERLAMBAT
  PULANG_AWAL
  LEMBUR
}

enum JenisCutiIzin {
  CUTI_TAHUNAN
  SAKIT
  IZIN
}

enum StatusCutiIzin {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

model Jabatan {
  id       String @id
  tenantId String
  nama     String

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  karyawan Karyawan[]

  // ALT-DEF-010: agar Karyawan bisa memakai composite-FK
  // (tenantId, jabatanId) -> Jabatan(tenantId, id).
  @@unique([tenantId, id])
  @@map("jabatan")
}

model Karyawan {
  id               String         @id
  tenantId         String
  penggunaId       String?        @unique
  jabatanId        String
  outletUtamaId    String
  nomorInduk       String         @unique
  status           StatusKaryawan @default(AKTIF)
  tanggalBergabung DateTime

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  pengguna                Pengguna?                 @relation(fields: [penggunaId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, jabatanId) -> Jabatan(tenantId, id).
  jabatan                 Jabatan                   @relation(fields: [tenantId, jabatanId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, outletUtamaId) -> Outlet(tenantId, id).
  outletUtama             Outlet                    @relation("KaryawanOutletUtama", fields: [tenantId, outletUtamaId], references: [tenantId, id])
  penugasanShift          PenugasanShift[]
  absensi                 Absensi[]
  cutiIzin                CutiIzin[]
  rmKinerjaKaryawanHarian RmKinerjaKaryawanHarian[]

  // ALT-DEF-010: agar Absensi/RmKinerjaKaryawanHarian bisa memakai
  // composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  @@unique([tenantId, id])
  @@map("karyawan")
}

model JadwalShift {
  id         String @id
  tenantId   String
  outletId   String
  nama       String
  jamMulai   String
  jamSelesai String

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  outlet         Outlet           @relation(fields: [outletId], references: [id])
  penugasanShift PenugasanShift[]

  @@map("jadwal_shift")
}

model PenugasanShift {
  id            String               @id
  karyawanId    String
  jadwalShiftId String
  tanggal       DateTime             @db.Date
  status        StatusPenugasanShift @default(DIJADWALKAN)

  karyawan    Karyawan    @relation(fields: [karyawanId], references: [id])
  jadwalShift JadwalShift @relation(fields: [jadwalShiftId], references: [id])

  @@map("penugasan_shift")
}

model Absensi {
  id         String        @id
  tenantId   String
  outletId   String
  karyawanId String
  jamMasuk   DateTime
  jamPulang  DateTime?
  metode     MetodeAbsensi
  status     StatusAbsensi

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet   Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, karyawanId) -> Karyawan(tenantId, id).
  karyawan Karyawan @relation(fields: [tenantId, karyawanId], references: [tenantId, id])

  @@map("absensi")
}

model CutiIzin {
  id              String         @id
  karyawanId      String
  jenis           JenisCutiIzin
  tanggalMulai    DateTime       @db.Date
  tanggalSelesai  DateTime       @db.Date
  status          StatusCutiIzin @default(DIAJUKAN)
  disetujuiOlehId String?

  karyawan      Karyawan  @relation(fields: [karyawanId], references: [id])
  disetujuiOleh Pengguna? @relation("CutiDisetujuiOleh", fields: [disetujuiOlehId], references: [id])

  @@map("cuti_izin")
}

// =====================================================================================
// 13. KEUANGAN INTERNAL (docs/database/13-keuangan.md)
// =====================================================================================

enum StatusRekapKasHarian {
  DRAF
  DIVERIFIKASI
}

enum StatusBiayaOperasional {
  DIAJUKAN
  DISETUJUI
  DIBAYAR
  DIBATALKAN
}

model KategoriBiaya {
  id       String @id
  tenantId String
  nama     String

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  biayaOperasional BiayaOperasional[]

  // ALT-DEF-010: agar BiayaOperasional bisa memakai composite-FK
  // (tenantId, kategoriBiayaId) -> KategoriBiaya(tenantId, id).
  @@unique([tenantId, id])
  @@map("kategori_biaya")
}

model RekapKasHarian {
  id                 String               @id
  tenantId           String
  outletId           String
  giliranKasirId     String?              @unique
  tanggal            DateTime             @db.Date
  totalPenjualan     Int                  @default(0)
  totalRefund        Int                  @default(0)
  totalDiskon        Int                  @default(0)
  selisihKas         Int                  @default(0)
  status             StatusRekapKasHarian @default(DRAF)
  diverifikasiOlehId String?

  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet           Outlet        @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, giliranKasirId) -> GiliranKasir(tenantId, id).
  giliranKasir     GiliranKasir? @relation(fields: [tenantId, giliranKasirId], references: [tenantId, id])
  diverifikasiOleh Pengguna?     @relation("RekapDiverifikasiOleh", fields: [diverifikasiOlehId], references: [id])

  // Diperlukan agar composite-FK (tenantId, giliranKasirId) -> GiliranKasir(tenantId, id)
  // valid sebagai relasi one-to-one (giliranKasirId sudah @unique tunggal di atas).
  @@unique([tenantId, giliranKasirId])
  @@map("rekap_kas_harian")
}

model BiayaOperasional {
  id              String                 @id
  tenantId        String
  outletId        String
  kategoriBiayaId String
  jumlah          Int
  keterangan      String
  status          StatusBiayaOperasional @default(DIAJUKAN)
  dicatatOlehId   String
  createdAt       DateTime               @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  // ALT-DEF-010: composite-FK (tenantId, outletId) -> Outlet(tenantId, id).
  outlet        Outlet        @relation(fields: [tenantId, outletId], references: [tenantId, id])
  // ALT-DEF-010: composite-FK (tenantId, kategoriBiayaId) -> KategoriBiaya(tenantId, id).
  kategoriBiaya KategoriBiaya @relation(fields: [tenantId, kategoriBiayaId], references: [tenantId, id])
  dicatatOleh   Pengguna      @relation("BiayaDicatatOleh", fields: [dicatatOlehId], references: [id])

  @@map("biaya_operasional")
}

// =====================================================================================
// 14. ANALITIK / READ MODEL (docs/database/14-analitik-read-model.md)
